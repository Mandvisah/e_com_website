<!-- Hero Section for Category Page -->
<div class="hero-section bg-gradient text-white py-5 mb-5" id="category-hero">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-8">
                <nav aria-label="breadcrumb" class="mb-3">
                    <ol class="breadcrumb text-white-50 hero-breadcrumb">
                        <li class="breadcrumb-item"><a href="/" class="text-white">Home</a></li>
                        <li class="breadcrumb-item"><a href="/categories" class="text-white">Categories</a></li>
                        <li class="breadcrumb-item active text-white" aria-current="page" id="category-name">Category</li>
                    </ol>
                </nav>
                <div class="hero-text-container">
                    <h1 id="category-title" class="display-4 fw-bold mb-3 floating-animation">Category Products</h1>
                    <p id="category-description" class="lead mb-4">Discover amazing products in this category</p>
                    <div class="d-flex align-items-center gap-3">
                        <span id="product-count" class="badge bg-light text-dark fs-6 px-3 py-2">0 Products</span>
                        <button class="btn btn-outline-light btn-lg" onclick="scrollToProducts()">
                            <i class="fas fa-shopping-bag me-2"></i>Shop Now
                        </button>
                    </div>
                </div>
            </div>
            <div class="col-lg-4 text-center">
                <div class="hero-image-container">
                    <img id="category-image" src="https://via.placeholder.com/400x300?text=Category" 
                         class="img-fluid rounded shadow-lg floating-slow" 
                         alt="Category Image"
                         style="max-height: 300px; object-fit: cover;">
                </div>
            </div>
        </div>
    </div>
</div>

<div class="container my-5">
    <!-- Enhanced Filter Section -->
    <div class="row mb-5" id="products-section">
        <div class="col-12">
            <div class="card shadow-sm border-0 rounded-lg">
                <div class="card-body p-4">
                    <h5 class="card-title mb-4">
                        <i class="fas fa-filter text-primary me-2"></i>
                        Filter & Search Products
                    </h5>
                    <div class="row">
                        <div class="col-md-5 mb-3">
                            <label for="search-input" class="form-label fw-semibold">Search in Category</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="fas fa-search"></i></span>
                                <input type="text" id="search-input" class="form-control" 
                                       placeholder="Search products in this category..." 
                                       onkeyup="searchProducts()">
                            </div>
                        </div>
                        <div class="col-md-3 mb-3">
                            <label for="sort-select" class="form-label fw-semibold">Sort By</label>
                            <select id="sort-select" class="form-select" onchange="sortProducts()">
                                <option value="">Default Order</option>
                                <option value="name">Name A-Z</option>
                                <option value="-name">Name Z-A</option>
                                <option value="price">Price Low to High</option>
                                <option value="-price">Price High to Low</option>
                                <option value="newest">Newest First</option>
                            </select>
                        </div>
                        <div class="col-md-2 mb-3">
                            <label for="view-toggle" class="form-label fw-semibold">View</label>
                            <div class="btn-group w-100" role="group">
                                <button type="button" class="btn btn-outline-secondary active" id="grid-view" onclick="toggleView('grid')">
                                    <i class="fas fa-th"></i>
                                </button>
                                <button type="button" class="btn btn-outline-secondary" id="list-view" onclick="toggleView('list')">
                                    <i class="fas fa-list"></i>
                                </button>
                            </div>
                        </div>
                        <div class="col-md-2 mb-3">
                            <label class="form-label fw-semibold">&nbsp;</label>
                            <button class="btn btn-outline-primary w-100" onclick="resetFilters()">
                                <i class="fas fa-redo me-1"></i> Reset
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Products Grid -->
    <div class="row">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h3 class="mb-0">
                    <i class="fas fa-box-open text-primary me-2"></i>
                    Products in Category
                </h3>
                <div class="results-info">
                    <span class="text-muted" id="results-count">Loading products...</span>
                </div>
            </div>
            
            <div id="products-container" class="row" data-view="grid">
                <!-- Products will be loaded here -->
            </div>
            
            <!-- No Products Message -->
            <div id="no-products" class="text-center py-5" style="display: none;">
                <div class="mb-4">
                    <i class="fas fa-box-open fa-4x text-muted"></i>
                </div>
                <h4 class="text-muted">No Products Found</h4>
                <p class="text-muted">Try adjusting your search or filter criteria.</p>
                <button class="btn btn-primary" onclick="resetFilters()">
                    <i class="fas fa-redo me-1"></i> Reset Filters
                </button>
            </div>
        </div>
    </div>

            <!-- Loading Spinner -->
            <div id="loading-spinner" class="text-center my-5" style="display: none;">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
                <p class="mt-3">Loading products...</p>
            </div>

            <!-- No Products Message -->
            <div id="no-products" class="text-center my-5" style="display: none;">
                <div class="alert alert-info">
                    <h4><i class="fas fa-info-circle"></i> No Products Found</h4>
                    <p>There are no products in this category yet.</p>
                    <a href="/products" class="btn btn-primary">Browse All Products</a>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
const categoryId = '<%= categoryId %>';
let allProducts = [];
let filteredProducts = [];

document.addEventListener('DOMContentLoaded', function() {
    console.log('Category page DOMContentLoaded');
    
    // Load category info and products
    loadCategoryInfo();
    loadCategoryProducts();
    
    // Update navigation and cart after main.js loads
    setTimeout(() => {
        if (typeof updateNavigation === 'function') {
            updateNavigation();
            console.log('Updated navigation on category page');
        }
        
        if (typeof updateCartCount === 'function') {
            updateCartCount();
            console.log('Updated cart count on category page');
        }
    }, 100);
});

async function loadCategoryInfo() {
    try {
        const response = await axios.get(`/api/v1/categories/${categoryId}`);
        const category = response.data;
        
        document.getElementById('category-title').textContent = category.name;
        document.getElementById('category-name').textContent = category.name;
        document.getElementById('category-description').textContent = category.description || 'Discover amazing products in this category';
        document.title = `${category.name} - E-Commerce Store`;
        
        // Set hero background based on category
        setHeroBackground(category.name);
        
        // Set category image if available
        const categoryImage = document.getElementById('category-image');
        if (category.image) {
            categoryImage.src = category.image;
        } else {
            // Set placeholder based on category name
            categoryImage.src = `https://via.placeholder.com/400x300/667eea/ffffff?text=${encodeURIComponent(category.name)}`;
        }
        
    } catch (error) {
        console.error('Error loading category info:', error);
        document.getElementById('category-title').textContent = 'Category Not Found';
        document.getElementById('category-description').textContent = 'This category could not be loaded.';
    }
}

async function loadCategoryProducts() {
    showLoading(true);
    try {
        const response = await axios.get(`/api/v1/products?category=${categoryId}`);
        allProducts = response.data;
        filteredProducts = [...allProducts];
        
        updateProductCount();
        displayProducts(filteredProducts);
        
        if (allProducts.length === 0) {
            document.getElementById('no-products').style.display = 'block';
        }
    } catch (error) {
        console.error('Error loading category products:', error);
        document.getElementById('products-container').innerHTML = `
            <div class="col-12">
                <div class="alert alert-danger">
                    <h4>Error Loading Products</h4>
                    <p>Unable to load products for this category. Please try again later.</p>
                    <button class="btn btn-primary" onclick="loadCategoryProducts()">Retry</button>
                </div>
            </div>
        `;
    }
    showLoading(false);
}

function displayProducts(products) {
    const container = document.getElementById('products-container');
    const noProductsDiv = document.getElementById('no-products');
    const viewMode = container.getAttribute('data-view') || 'grid';
    
    if (products.length === 0) {
        container.innerHTML = '';
        noProductsDiv.style.display = 'block';
        document.getElementById('results-count').textContent = 'No products found';
        return;
    }
    
    noProductsDiv.style.display = 'none';
    document.getElementById('results-count').textContent = `Showing ${products.length} product${products.length !== 1 ? 's' : ''}`;
    
    if (viewMode === 'list') {
        container.className = 'row';
        container.innerHTML = products.map(product => `
            <div class="col-12 mb-3">
                <div class="card product-card h-100 shadow-sm">
                    <div class="row g-0">
                        <div class="col-md-3">
                            <div class="position-relative">
                                <img src="${product.image || 'https://via.placeholder.com/300x200?text=Product'}" 
                                     class="img-fluid rounded-start h-100" 
                                     alt="${product.name}"
                                     style="object-fit: cover; min-height: 200px;"
                                     onerror="this.onerror=null; this.src='https://via.placeholder.com/300x200?text=No+Image';">
                                ${product.countInStock === 0 ? '<div class="position-absolute top-0 end-0 m-2"><span class="badge bg-danger">Out of Stock</span></div>' : ''}
                                ${product.countInStock > 0 && product.countInStock <= 5 ? '<div class="position-absolute top-0 end-0 m-2"><span class="badge bg-warning">Low Stock</span></div>' : ''}
                            </div>
                        </div>
                        <div class="col-md-9">
                            <div class="card-body d-flex flex-column h-100">
                                <div class="flex-grow-1">
                                    <h5 class="card-title">${product.name}</h5>
                                    <p class="card-text text-muted">${(product.description || '').substring(0, 150)}${(product.description || '').length > 150 ? '...' : ''}</p>
                                </div>
                                <div class="mt-auto">
                                    <div class="d-flex justify-content-between align-items-center mb-3">
                                        <span class="h4 text-primary mb-0">$${product.price}</span>
                                        <small class="text-muted">
                                            <i class="fas fa-box me-1"></i>${product.countInStock} in stock
                                        </small>
                                    </div>
                                    <div class="d-flex gap-2">
                                        <button class="btn btn-outline-primary btn-sm" onclick="viewProduct('${product._id}')" title="View Details">
                                            <i class="fas fa-eye me-1"></i>View Details
                                        </button>
                                        <button class="btn btn-primary btn-sm flex-grow-1" onclick="addToCart('${product._id}')" ${product.countInStock === 0 ? 'disabled' : ''}>
                                            <i class="fas fa-cart-plus me-1"></i>${product.countInStock === 0 ? 'Out of Stock' : 'Add to Cart'}
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        `).join('');
    } else {
        // Grid view
        container.className = 'row';
        container.innerHTML = products.map(product => `
            <div class="col-lg-3 col-md-4 col-sm-6 mb-4">
                <div class="card product-card h-100 shadow-sm hover-lift">
                    <div class="position-relative">
                        <img src="${product.image || 'https://via.placeholder.com/300x200?text=Product'}" 
                             class="card-img-top product-image" 
                             alt="${product.name}"
                             style="height: 250px; object-fit: cover;"
                             onerror="this.onerror=null; this.src='https://via.placeholder.com/300x200?text=No+Image';">
                        ${product.countInStock === 0 ? '<div class="position-absolute top-0 end-0 m-2"><span class="badge bg-danger">Out of Stock</span></div>' : ''}
                        ${product.countInStock > 0 && product.countInStock <= 5 ? '<div class="position-absolute top-0 end-0 m-2"><span class="badge bg-warning">Low Stock</span></div>' : ''}
                        <div class="card-overlay">
                            <button class="btn btn-light btn-sm" onclick="viewProduct('${product._id}')" title="Quick View">
                                <i class="fas fa-eye"></i>
                            </button>
                        </div>
                    </div>
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title">${product.name}</h5>
                        <p class="card-text text-muted small flex-grow-1">${(product.description || '').substring(0, 80)}${(product.description || '').length > 80 ? '...' : ''}</p>
                        <div class="mt-auto">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <span class="h5 text-primary mb-0">$${product.price}</span>
                                <small class="text-muted">
                                    <i class="fas fa-box me-1"></i>${product.countInStock} left
                                </small>
                            </div>
                            <div class="d-flex gap-2">
                                <button class="btn btn-outline-primary btn-sm" onclick="viewProduct('${product._id}')" title="View Details">
                                    <i class="fas fa-eye"></i>
                                </button>
                                <button class="btn btn-primary btn-sm flex-grow-1" onclick="addToCart('${product._id}')" ${product.countInStock === 0 ? 'disabled' : ''}>
                                    <i class="fas fa-cart-plus me-1"></i>${product.countInStock === 0 ? 'Out of Stock' : 'Add to Cart'}
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        `).join('');
    }
}

function updateProductCount() {
    const count = filteredProducts.length;
    document.getElementById('product-count').textContent = `${count} Product${count !== 1 ? 's' : ''}`;
}

function searchProducts() {
    const searchTerm = document.getElementById('search-input').value.toLowerCase();
    
    if (searchTerm === '') {
        filteredProducts = [...allProducts];
    } else {
        filteredProducts = allProducts.filter(product =>
            product.name.toLowerCase().includes(searchTerm) ||
            (product.description && product.description.toLowerCase().includes(searchTerm))
        );
    }
    
    updateProductCount();
    displayProducts(filteredProducts);
}

function sortProducts() {
    const sortBy = document.getElementById('sort-select').value;
    
    if (!sortBy) {
        filteredProducts = [...filteredProducts];
    } else {
        filteredProducts.sort((a, b) => {
            switch (sortBy) {
                case 'name':
                    return a.name.localeCompare(b.name);
                case '-name':
                    return b.name.localeCompare(a.name);
                case 'price':
                    return parseFloat(a.price) - parseFloat(b.price);
                case '-price':
                    return parseFloat(b.price) - parseFloat(a.price);
                default:
                    return 0;
            }
        });
    }
    
    displayProducts(filteredProducts);
}

function resetFilters() {
    document.getElementById('search-input').value = '';
    document.getElementById('sort-select').value = '';
    filteredProducts = [...allProducts];
    updateProductCount();
    displayProducts(filteredProducts);
}

// New helper functions for enhanced features
function scrollToProducts() {
    document.getElementById('products-section').scrollIntoView({ 
        behavior: 'smooth',
        block: 'start'
    });
}

function toggleView(viewType) {
    const container = document.getElementById('products-container');
    const gridBtn = document.getElementById('grid-view');
    const listBtn = document.getElementById('list-view');
    
    container.setAttribute('data-view', viewType);
    
    if (viewType === 'grid') {
        gridBtn.classList.add('active');
        listBtn.classList.remove('active');
    } else {
        listBtn.classList.add('active');
        gridBtn.classList.remove('active');
    }
    
    displayProducts(filteredProducts);
}

function viewProduct(productId) {
    window.location.href = `/product/${productId}`;
}

function setHeroBackground(categoryName) {
    const hero = document.getElementById('category-hero');
    
    // Set gradient based on category with modern, attractive colors
    const gradients = {
        'electronics': 'linear-gradient(135deg, #667eea 0%, #764ba2 100%)',
        'clothing': 'linear-gradient(135deg, #ff9a9e 0%, #fecfef 100%)',
        'books': 'linear-gradient(135deg, #a18cd1 0%, #fbc2eb 100%)',
        'home': 'linear-gradient(135deg, #fad0c4 0%, #ffd1ff 100%)',
        'sports': 'linear-gradient(135deg, #ff9a56 0%, #ffad56 100%)',
        'beauty': 'linear-gradient(135deg, #ff9a9e 0%, #fad0c4 100%)',
        'food': 'linear-gradient(135deg, #a8edea 0%, #fed6e3 100%)',
        'automotive': 'linear-gradient(135deg, #d299c2 0%, #fef9d7 100%)',
        'toys': 'linear-gradient(135deg, #89f7fe 0%, #66a6ff 100%)',
        'music': 'linear-gradient(135deg, #fdbb2d 0%, #22c1c3 100%)',
        'default': 'linear-gradient(135deg, #667eea 0%, #764ba2 100%)'
    };
    
    const categoryKey = categoryName.toLowerCase();
    const gradient = gradients[categoryKey] || gradients.default;
    hero.style.background = gradient;
}

function showLoading(show) {
    const spinner = document.getElementById('loading-spinner');
    const container = document.getElementById('products-container');
    
    if (show) {
        spinner.style.display = 'block';
        container.innerHTML = '';
    } else {
        spinner.style.display = 'none';
    }
}

// Note: addToCart function is provided by main.js
// Using the global addToCart function instead of local implementation
</script>

