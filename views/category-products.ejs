<!-- Custom Luxury Styles -->
<style>
    @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600;700;800&family=Inter:wght@300;400;500;600;700&display=swap');
    
    :root {
        --luxury-navy: #0f172a;
        --luxury-charcoal: #1e293b;
        --luxury-gold: #d4af37;
        --luxury-champagne: #f5e6d3;
        --luxury-pearl: #f8fafc;
    }
    
    body {
        font-family: 'Inter', sans-serif;
        background-color: #f8fafc;
    }
    
    .luxury-heading {
        font-family: 'Playfair Display', serif;
    }
    
    @keyframes fadeInUp {
        from {
            opacity: 0;
            transform: translateY(30px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
    
    @keyframes shimmer {
        0% { background-position: -1000px 0; }
        100% { background-position: 1000px 0; }
    }
    
    .animate-fade-in-up {
        animation: fadeInUp 0.8s ease-out forwards;
    }
    
    .luxury-card {
        background: white;
        border-radius: 16px;
        border: 1px solid rgba(15, 23, 42, 0.1);
        transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    }
    
    .luxury-card:hover {
        transform: translateY(-8px);
        box-shadow: 0 20px 40px rgba(15, 23, 42, 0.15);
        border-color: var(--luxury-gold);
    }
    
    .gold-text {
        color: var(--luxury-gold);
        text-shadow: 0 0 20px rgba(212, 175, 55, 0.3);
    }
    
    .glass-effect {
        background: rgba(255, 255, 255, 0.1);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255, 255, 255, 0.2);
    }
</style>

<!-- Hero Section -->
<section class="relative bg-gradient-to-br from-slate-900 via-slate-800 to-slate-900 text-white overflow-hidden">
    <div class="absolute inset-0 opacity-10">
        <div class="absolute inset-0" style="background-image: url('data:image/svg+xml,%3Csvg width=\'60\' height=\'60\' viewBox=\'0 0 60 60\' xmlns=\'http://www.w3.org/2000/svg\'%3E%3Cg fill=\'none\' fill-rule=\'evenodd\'%3E%3Cg fill=\'%23ffffff\' fill-opacity=\'1\'%3E%3Cpath d=\'M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z\'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E');"></div>
    </div>
    
    <div class="container mx-auto px-4 sm:px-6 lg:px-8 py-16 lg:py-24 relative z-10">
        <div class="grid lg:grid-cols-2 gap-12 items-center">
            <!-- Hero Content -->
            <div class="animate-fade-in-up space-y-6">
                <!-- Breadcrumb -->
                <nav class="flex items-center space-x-2 text-sm">
                    <a href="/" class="text-slate-400 hover:text-yellow-500 transition-colors">
                        <i class="fas fa-home mr-1"></i>Home
                    </a>
                    <span class="text-slate-500">/</span>
                    <a href="/categories" class="text-slate-400 hover:text-yellow-500 transition-colors">Categories</a>
                    <span class="text-slate-500">/</span>
                    <span id="category-name" class="text-yellow-500 font-medium">Category</span>
                </nav>
                
                <div class="glass-effect rounded-2xl p-6 sm:p-8">
                    <h1 id="category-title" class="luxury-heading text-4xl sm:text-5xl lg:text-6xl font-bold leading-tight mb-4">
                        Category Products
                    </h1>
                    
                    <p id="category-description" class="text-lg text-slate-300 leading-relaxed mb-6">
                        Discover amazing products in this category
                    </p>
                    
                    <div class="flex flex-wrap items-center gap-4">
                        <span id="product-count" class="inline-flex items-center px-4 py-2 bg-yellow-500/20 border border-yellow-500/30 rounded-full text-yellow-500 font-semibold">
                            <i class="fas fa-box mr-2"></i>0 Products
                        </span>
                        <button onclick="scrollToProducts()" class="luxury-btn-primary px-6 py-3 bg-gradient-to-r from-yellow-600 to-yellow-500 text-slate-900 font-semibold rounded-lg hover:from-yellow-500 hover:to-yellow-400 transition-all duration-300 transform hover:scale-105 shadow-lg">
                            <i class="fas fa-shopping-bag mr-2"></i>Shop Now
                        </button>
                    </div>
                </div>
            </div>
            
            <!-- Hero Image -->
            <div class="relative animate-fade-in-up">
                <div class="relative z-10 rounded-2xl overflow-hidden shadow-2xl">
                    <img id="category-image" src="https://via.placeholder.com/600x400?text=Category" 
                         class="w-full h-auto object-cover" 
                         alt="Category Image"
                         style="max-height: 400px;">
                    <div class="absolute inset-0 bg-gradient-to-t from-slate-900/50 to-transparent"></div>
                </div>
                <div class="absolute -bottom-6 -right-6 w-64 h-64 bg-yellow-500/10 rounded-full blur-3xl"></div>
                <div class="absolute -top-6 -left-6 w-64 h-64 bg-blue-500/10 rounded-full blur-3xl"></div>
            </div>
        </div>
    </div>
</section>

<!-- Filter & Products Section -->
<div class="container mx-auto px-4 sm:px-6 lg:px-8 py-12" id="products-section">
    <!-- Enhanced Filter Section -->
    <div class="luxury-card p-6 mb-8 shadow-lg">
        <div class="flex items-center mb-6">
            <i class="fas fa-sliders-h text-2xl text-yellow-600 mr-3"></i>
            <h2 class="luxury-heading text-2xl font-bold text-slate-900">Filter & Search</h2>
        </div>
        
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-4">
            <!-- Search -->
            <div class="lg:col-span-2">
                <label class="block text-sm font-semibold text-slate-700 mb-2">Search in Category</label>
                <div class="relative">
                    <i class="fas fa-search absolute left-4 top-1/2 transform -translate-y-1/2 text-slate-400"></i>
                    <input type="text" id="search-input" 
                           class="luxury-input w-full pl-11 pr-4 py-3 rounded-lg border border-slate-300 focus:border-yellow-500 focus:ring-2 focus:ring-yellow-500/20 transition-all" 
                           placeholder="Search products..." 
                           onkeyup="searchProducts()">
                </div>
            </div>
            
            <!-- Sort -->
            <div>
                <label class="block text-sm font-semibold text-slate-700 mb-2">Sort By</label>
                <select id="sort-select" 
                        class="luxury-input w-full px-4 py-3 rounded-lg border border-slate-300 focus:border-yellow-500 focus:ring-2 focus:ring-yellow-500/20 transition-all" 
                        onchange="sortProducts()">
                    <option value="">Default Order</option>
                    <option value="name">Name A-Z</option>
                    <option value="-name">Name Z-A</option>
                    <option value="price">Price Low to High</option>
                    <option value="-price">Price High to Low</option>
                    <option value="newest">Newest First</option>
                </select>
            </div>
            
            <!-- View Toggle -->
            <div>
                <label class="block text-sm font-semibold text-slate-700 mb-2">View</label>
                <div class="flex gap-2">
                    <button type="button" id="grid-view" onclick="toggleView('grid')"
                            class="flex-1 px-4 py-3 rounded-lg border-2 border-slate-900 bg-slate-900 text-white font-semibold transition-all">
                        <i class="fas fa-th"></i>
                    </button>
                    <button type="button" id="list-view" onclick="toggleView('list')"
                            class="flex-1 px-4 py-3 rounded-lg border-2 border-slate-300 bg-white text-slate-700 font-semibold hover:border-slate-900 transition-all">
                        <i class="fas fa-list"></i>
                    </button>
                </div>
            </div>
            
            <!-- Reset -->
            <div>
                <label class="block text-sm font-semibold text-slate-700 mb-2">&nbsp;</label>
                <button onclick="resetFilters()" 
                        class="w-full px-4 py-3 rounded-lg border-2 border-yellow-600 text-yellow-600 font-semibold hover:bg-yellow-600 hover:text-white transition-all">
                    <i class="fas fa-redo mr-2"></i>Reset
                </button>
            </div>
        </div>
    </div>

    <!-- Products Header -->
    <div class="flex justify-between items-center mb-6">
        <h2 class="luxury-heading text-3xl font-bold text-slate-900">
            <i class="fas fa-box-open text-yellow-600 mr-3"></i>
            Products
        </h2>
        <span id="results-count" class="text-slate-600 font-medium">Loading products...</span>
    </div>
    
    <!-- Products Grid -->
    <div id="products-container" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6" data-view="grid">
        <!-- Products will be loaded here -->
    </div>
    
    <!-- Loading Spinner -->
    <div id="loading-spinner" class="text-center py-16" style="display: none;">
        <div class="inline-block animate-spin rounded-full h-12 w-12 border-4 border-slate-300 border-t-yellow-600"></div>
        <p class="mt-4 text-slate-600 font-medium">Loading products...</p>
    </div>
    
    <!-- No Products Message -->
    <div id="no-products" class="text-center py-16" style="display: none;">
        <div class="luxury-card p-12 inline-block">
            <i class="fas fa-box-open text-6xl text-slate-400 mb-6"></i>
            <h3 class="luxury-heading text-2xl font-bold text-slate-900 mb-3">No Products Found</h3>
            <p class="text-slate-600 mb-6">Try adjusting your search or filter criteria.</p>
            <button onclick="resetFilters()" 
                    class="luxury-btn-primary px-6 py-3 bg-gradient-to-r from-yellow-600 to-yellow-500 text-slate-900 font-semibold rounded-lg hover:from-yellow-500 hover:to-yellow-400 transition-all">
                <i class="fas fa-redo mr-2"></i>Reset Filters
            </button>
        </div>
    </div>
</div>

<script>
const categoryId = '<%= categoryId %>';
let allProducts = [];
let filteredProducts = [];

document.addEventListener('DOMContentLoaded', function() {
    console.log('Category page DOMContentLoaded');
    
    // Load category info and products
    loadCategoryInfo();
    loadCategoryProducts();
    
    // Update navigation and cart after main.js loads
    setTimeout(() => {
        if (typeof updateNavigation === 'function') {
            updateNavigation();
            console.log('Updated navigation on category page');
        }
        
        if (typeof updateCartCount === 'function') {
            updateCartCount();
            console.log('Updated cart count on category page');
        }
    }, 100);
});

async function loadCategoryInfo() {
    try {
        const response = await axios.get(`/api/v1/categories/${categoryId}`);
        const category = response.data;
        
        document.getElementById('category-title').textContent = category.name;
        document.getElementById('category-name').textContent = category.name;
        document.getElementById('category-description').textContent = category.description || 'Discover amazing products in this category';
        document.title = `${category.name} - E-Commerce Store`;
        
        // Set hero background based on category
        setHeroBackground(category.name);
        
        // Set category image if available
        const categoryImage = document.getElementById('category-image');
        if (category.image) {
            categoryImage.src = category.image;
        } else {
            // Set placeholder based on category name
            categoryImage.src = `https://via.placeholder.com/400x300/667eea/ffffff?text=${encodeURIComponent(category.name)}`;
        }
        
    } catch (error) {
        console.error('Error loading category info:', error);
        document.getElementById('category-title').textContent = 'Category Not Found';
        document.getElementById('category-description').textContent = 'This category could not be loaded.';
    }
}

async function loadCategoryProducts() {
    showLoading(true);
    try {
        const response = await axios.get(`/api/v1/products?category=${categoryId}`);
        allProducts = response.data;
        filteredProducts = [...allProducts];
        
        updateProductCount();
        displayProducts(filteredProducts);
        
        if (allProducts.length === 0) {
            document.getElementById('no-products').style.display = 'block';
        }
    } catch (error) {
        console.error('Error loading category products:', error);
        document.getElementById('products-container').innerHTML = `
            <div class="col-12">
                <div class="alert alert-danger">
                    <h4>Error Loading Products</h4>
                    <p>Unable to load products for this category. Please try again later.</p>
                    <button class="btn btn-primary" onclick="loadCategoryProducts()">Retry</button>
                </div>
            </div>
        `;
    }
    showLoading(false);
}

function displayProducts(products) {
    const container = document.getElementById('products-container');
    const noProductsDiv = document.getElementById('no-products');
    const viewMode = container.getAttribute('data-view') || 'grid';
    
    if (products.length === 0) {
        container.innerHTML = '';
        noProductsDiv.style.display = 'block';
        document.getElementById('results-count').textContent = 'No products found';
        return;
    }
    
    noProductsDiv.style.display = 'none';
    document.getElementById('results-count').textContent = `Showing ${products.length} product${products.length !== 1 ? 's' : ''}`;
    
    if (viewMode === 'list') {
        container.className = 'space-y-4';
        container.innerHTML = products.map(product => `
            <div class="luxury-card overflow-hidden shadow-lg hover:shadow-2xl transition-all duration-300">
                <div class="flex flex-col md:flex-row">
                    <div class="md:w-1/3 relative overflow-hidden">
                        <img src="${product.image || 'https://via.placeholder.com/400x300?text=Product'}" 
                             class="w-full h-64 md:h-full object-cover transform hover:scale-110 transition-transform duration-500" 
                             alt="${product.name}"
                             onerror="this.onerror=null; this.src='https://via.placeholder.com/400x300?text=No+Image';">
                        ${product.countInStock === 0 ? '<div class="absolute top-4 right-4"><span class="px-3 py-1 bg-red-500 text-white text-sm font-semibold rounded-full">Out of Stock</span></div>' : ''}
                        ${product.countInStock > 0 && product.countInStock <= 5 ? '<div class="absolute top-4 right-4"><span class="px-3 py-1 bg-amber-500 text-white text-sm font-semibold rounded-full">Low Stock</span></div>' : ''}
                    </div>
                    <div class="md:w-2/3 p-6 flex flex-col justify-between">
                        <div>
                            <h3 class="luxury-heading text-2xl font-bold text-slate-900 mb-3">${product.name}</h3>
                            <p class="text-slate-600 mb-4 line-clamp-3">${product.description || 'No description available'}</p>
                        </div>
                        <div>
                            <div class="flex items-center justify-between mb-4">
                                <span class="luxury-heading text-3xl font-bold text-yellow-600">$${product.price}</span>
                                <span class="text-slate-500 font-medium">
                                    <i class="fas fa-box mr-1"></i>${product.countInStock} in stock
                                </span>
                            </div>
                            <div class="flex gap-3">
                                <button onclick="event.stopPropagation(); viewProduct('${product._id}')" 
                                        class="px-6 py-3 border-2 border-slate-900 text-slate-900 font-semibold rounded-lg hover:bg-slate-900 hover:text-white transition-all">
                                    <i class="fas fa-eye mr-2"></i>View Details
                                </button>
                                <button onclick="event.stopPropagation(); addToCart('${product._id}')" 
                                        class="flex-1 px-6 py-3 bg-gradient-to-r from-yellow-600 to-yellow-500 text-slate-900 font-semibold rounded-lg hover:from-yellow-500 hover:to-yellow-400 transition-all transform hover:scale-105 shadow-lg ${product.countInStock === 0 ? 'opacity-50 cursor-not-allowed' : ''}"
                                        ${product.countInStock === 0 ? 'disabled' : ''}>
                                    <i class="fas fa-cart-plus mr-2"></i>${product.countInStock === 0 ? 'Out of Stock' : 'Add to Cart'}
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        `).join('');
    } else {
        // Grid view
        container.className = 'grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6';
        container.innerHTML = products.map(product => `
            <div class="luxury-card overflow-hidden group cursor-pointer" onclick="viewProduct('${product._id}')">
                <div class="relative overflow-hidden aspect-[4/3]">
                    <img src="${product.image || 'https://via.placeholder.com/400x300?text=Product'}" 
                         class="w-full h-full object-cover transform group-hover:scale-110 transition-transform duration-500" 
                         alt="${product.name}"
                         onerror="this.onerror=null; this.src='https://via.placeholder.com/400x300?text=No+Image';">
                    ${product.countInStock === 0 ? '<div class="absolute top-3 right-3"><span class="px-3 py-1 bg-red-500 text-white text-xs font-bold rounded-full shadow-lg">Out of Stock</span></div>' : ''}
                    ${product.countInStock > 0 && product.countInStock <= 5 ? '<div class="absolute top-3 right-3"><span class="px-3 py-1 bg-amber-500 text-white text-xs font-bold rounded-full shadow-lg">Low Stock</span></div>' : ''}
                    <div class="absolute inset-0 bg-gradient-to-t from-slate-900/60 via-slate-900/0 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
                    <div class="absolute bottom-4 left-4 right-4 transform translate-y-4 opacity-0 group-hover:translate-y-0 group-hover:opacity-100 transition-all duration-300 pointer-events-none">
                        <button onclick="event.stopPropagation(); viewProduct('${product._id}')" 
                                class="w-full px-4 py-2 bg-white/90 backdrop-blur-sm text-slate-900 font-semibold rounded-lg hover:bg-white transition-all pointer-events-auto">
                            <i class="fas fa-eye mr-2"></i>Quick View
                        </button>
                    </div>
                </div>
                <div class="p-5 flex flex-col h-48">
                    <h3 class="luxury-heading text-lg font-bold text-slate-900 mb-2 line-clamp-2">${product.name}</h3>
                    <p class="text-sm text-slate-600 mb-4 line-clamp-2 flex-grow">${product.description || 'No description available'}</p>
                    <div class="flex items-center justify-between mb-3">
                        <span class="luxury-heading text-2xl font-bold text-yellow-600">$${product.price}</span>
                        <span class="text-xs text-slate-500 font-medium">
                            <i class="fas fa-box mr-1"></i>${product.countInStock} left
                        </span>
                    </div>
                    <button onclick="event.stopPropagation(); addToCart('${product._id}')" 
                            class="w-full px-4 py-2.5 bg-gradient-to-r from-yellow-600 to-yellow-500 text-slate-900 font-semibold rounded-lg hover:from-yellow-500 hover:to-yellow-400 transition-all transform hover:scale-105 shadow-md relative z-10 ${product.countInStock === 0 ? 'opacity-50 cursor-not-allowed' : ''}"
                            ${product.countInStock === 0 ? 'disabled' : ''}>
                        <i class="fas fa-cart-plus mr-2"></i>${product.countInStock === 0 ? 'Out of Stock' : 'Add to Cart'}
                    </button>
                </div>
            </div>
        `).join('');
    }
}

function updateProductCount() {
    const count = filteredProducts.length;
    document.getElementById('product-count').textContent = `${count} Product${count !== 1 ? 's' : ''}`;
}

function searchProducts() {
    const searchTerm = document.getElementById('search-input').value.toLowerCase();
    
    if (searchTerm === '') {
        filteredProducts = [...allProducts];
    } else {
        filteredProducts = allProducts.filter(product =>
            product.name.toLowerCase().includes(searchTerm) ||
            (product.description && product.description.toLowerCase().includes(searchTerm))
        );
    }
    
    updateProductCount();
    displayProducts(filteredProducts);
}

function sortProducts() {
    const sortBy = document.getElementById('sort-select').value;
    
    if (!sortBy) {
        filteredProducts = [...filteredProducts];
    } else {
        filteredProducts.sort((a, b) => {
            switch (sortBy) {
                case 'name':
                    return a.name.localeCompare(b.name);
                case '-name':
                    return b.name.localeCompare(a.name);
                case 'price':
                    return parseFloat(a.price) - parseFloat(b.price);
                case '-price':
                    return parseFloat(b.price) - parseFloat(a.price);
                default:
                    return 0;
            }
        });
    }
    
    displayProducts(filteredProducts);
}

function resetFilters() {
    document.getElementById('search-input').value = '';
    document.getElementById('sort-select').value = '';
    filteredProducts = [...allProducts];
    updateProductCount();
    displayProducts(filteredProducts);
}

// New helper functions for enhanced features
function scrollToProducts() {
    document.getElementById('products-section').scrollIntoView({ 
        behavior: 'smooth',
        block: 'start'
    });
}

function toggleView(viewType) {
    const container = document.getElementById('products-container');
    const gridBtn = document.getElementById('grid-view');
    const listBtn = document.getElementById('list-view');
    
    container.setAttribute('data-view', viewType);
    
    if (viewType === 'grid') {
        gridBtn.className = 'flex-1 px-4 py-3 rounded-lg border-2 border-slate-900 bg-slate-900 text-white font-semibold transition-all';
        listBtn.className = 'flex-1 px-4 py-3 rounded-lg border-2 border-slate-300 bg-white text-slate-700 font-semibold hover:border-slate-900 transition-all';
    } else {
        listBtn.className = 'flex-1 px-4 py-3 rounded-lg border-2 border-slate-900 bg-slate-900 text-white font-semibold transition-all';
        gridBtn.className = 'flex-1 px-4 py-3 rounded-lg border-2 border-slate-300 bg-white text-slate-700 font-semibold hover:border-slate-900 transition-all';
    }
    
    displayProducts(filteredProducts);
}

function viewProduct(productId) {
    window.location.href = `/product/${productId}`;
}

function setHeroBackground(categoryName) {
    // Hero background is now fixed with navy theme - no dynamic changes needed
    // This function is kept for backward compatibility but doesn't modify the hero
    console.log('Category:', categoryName);
}

function showLoading(show) {
    const spinner = document.getElementById('loading-spinner');
    const container = document.getElementById('products-container');
    
    if (show) {
        spinner.style.display = 'block';
        container.innerHTML = '';
    } else {
        spinner.style.display = 'none';
    }
}

// Note: addToCart function is provided by main.js
// Using the global addToCart function instead of local implementation
</script>

