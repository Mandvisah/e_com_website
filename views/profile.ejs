<!-- Luxury Hero Section -->
<div class="relative bg-gradient-to-br from-slate-900 via-slate-800 to-slate-900 py-16">
    <div class="absolute inset-0 pattern-grid opacity-10"></div>
    <div class="container mx-auto px-4 relative z-10">
        <nav aria-label="breadcrumb" class="mb-8 animate-fade-in-up">
            <ol class="flex flex-wrap items-center gap-2 text-sm">
                <li><a href="/" class="text-amber-600 hover:text-amber-700 transition-colors"><i class="fas fa-home mr-1"></i>Home</a></li>
                <li class="text-slate-400">/</li>
                <li class="text-white font-semibold">My Profile</li>
            </ol>
        </nav>
        
        <div class="text-center">
            <div class="relative inline-block mb-6 animate-fade-in-up" style="animation-delay: 0.1s;">
                <div class="relative inline-block">
                    <i class="fas fa-user-circle text-9xl gold-text"></i>
                    <div class="absolute -inset-4 bg-amber-500 rounded-full blur-2xl opacity-20 animate-pulse"></div>
                </div>
            </div>
            <h1 class="luxury-heading text-4xl md:text-5xl text-white mb-2 animate-fade-in-up" style="animation-delay: 0.2s;" id="profile-name">Loading...</h1>
            <p class="text-xl text-slate-300 animate-fade-in-up" style="animation-delay: 0.3s;" id="profile-email">Loading...</p>
        </div>
    </div>
</div>

<div class="container mx-auto px-4 py-12">
    <div class="max-w-5xl mx-auto">
        <!-- User Profile Card -->
        <div class="luxury-card animate-fade-in-up" style="animation-delay: 0.4s;">
            <div class="luxury-card-header">
                <h5 class="text-white text-2xl font-bold">
                    <i class="fas fa-info-circle mr-2"></i>Personal Information
                </h5>
            </div>
            <div class="p-6 md:p-8">
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
                    <div>
                        <label class="luxury-label">First Name</label>
                        <div class="bg-slate-50 p-4 rounded-lg border-b-2 border-slate-200" id="display-firstName">-</div>
                    </div>
                    <div>
                        <label class="luxury-label">Last Name</label>
                        <div class="bg-slate-50 p-4 rounded-lg border-b-2 border-slate-200" id="display-lastName">-</div>
                    </div>
                    <div>
                        <label class="luxury-label">Email Address</label>
                        <div class="bg-slate-50 p-4 rounded-lg border-b-2 border-slate-200" id="display-email">-</div>
                    </div>
                    <div>
                        <label class="luxury-label">Phone Number</label>
                        <div class="bg-slate-50 p-4 rounded-lg border-b-2 border-slate-200" id="display-phone">-</div>
                    </div>
                    <div>
                        <label class="luxury-label">Date of Birth</label>
                        <div class="bg-slate-50 p-4 rounded-lg border-b-2 border-slate-200" id="display-dateOfBirth">-</div>
                    </div>
                    <div>
                        <label class="luxury-label">Member Since</label>
                        <div class="bg-slate-50 p-4 rounded-lg border-b-2 border-slate-200" id="display-memberSince">-</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Account Statistics -->
        <div class="luxury-card mt-8 animate-fade-in-up" style="animation-delay: 0.5s;">
            <div class="luxury-card-header">
                <h5 class="text-white text-2xl font-bold">
                    <i class="fas fa-chart-bar mr-2"></i>Account Summary
                </h5>
            </div>
            <div class="p-6 md:p-8">
                <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
                    <div class="bg-gradient-to-br from-blue-500 to-blue-600 p-6 rounded-xl text-white text-center transform transition-all duration-300 hover:scale-105 hover:shadow-2xl">
                        <div class="text-5xl font-bold mb-2" id="total-orders">0</div>
                        <div class="text-blue-100 text-sm uppercase tracking-wide">Total Orders</div>
                        <i class="fas fa-shopping-cart text-6xl opacity-10 absolute top-4 right-4"></i>
                    </div>
                    <div class="bg-gradient-to-br from-green-500 to-green-600 p-6 rounded-xl text-white text-center transform transition-all duration-300 hover:scale-105 hover:shadow-2xl">
                        <div class="text-5xl font-bold mb-2" id="total-spent">$0.00</div>
                        <div class="text-green-100 text-sm uppercase tracking-wide">Total Spent</div>
                        <i class="fas fa-dollar-sign text-6xl opacity-10 absolute top-4 right-4"></i>
                    </div>
                    <div class="bg-gradient-to-br from-amber-500 to-amber-600 p-6 rounded-xl text-white text-center transform transition-all duration-300 hover:scale-105 hover:shadow-2xl">
                        <div class="text-5xl font-bold mb-2" id="active-orders">0</div>
                        <div class="text-amber-100 text-sm uppercase tracking-wide">Active Orders</div>
                        <i class="fas fa-box text-6xl opacity-10 absolute top-4 right-4"></i>
                    </div>
                </div>

                <!-- Action Buttons -->
                <div class="flex flex-col sm:flex-row gap-4 justify-center">
                    <a href="/edit-profile" class="luxury-btn-primary py-3 px-6 text-center">
                        <i class="fas fa-edit mr-2"></i>Edit Profile
                    </a>
                    <a href="/orders" class="luxury-btn-outline py-3 px-6 text-center">
                        <i class="fas fa-shopping-bag mr-2"></i>View Orders
                    </a>
                    <button type="button" class="luxury-btn-outline border-2 border-red-500 text-red-500 hover:bg-red-500 hover:text-white py-3 px-6" onclick="logout()">
                        <i class="fas fa-sign-out-alt mr-2"></i>Logout
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Styles now handled by Tailwind and luxury-theme.css -->

<script>
document.addEventListener('DOMContentLoaded', function() {
    checkAuthStatus();
    loadProfile();
    loadAccountSummary();
});

function checkAuthStatus() {
    const isLoggedIn = !!localStorage.getItem('userToken');
    if (!isLoggedIn) {
        alert('Please login to view your profile');
        window.location.href = '/login?redirect=/profile';
    }
}

async function loadProfile() {
    try {
        const response = await axios.get('/api/v1/users/profile', {
            headers: {
                'Authorization': `Bearer ${localStorage.getItem('userToken')}`
            }
        });
        
        const user = response.data;
        
        // Update display fields
        document.getElementById('profile-name').textContent = `${user.firstName || ''} ${user.lastName || ''}`.trim() || user.name || 'User';
        document.getElementById('profile-email').textContent = user.email;
        
        document.getElementById('display-firstName').textContent = user.firstName || 'Not provided';
        document.getElementById('display-lastName').textContent = user.lastName || 'Not provided';
        document.getElementById('display-email').textContent = user.email;
        document.getElementById('display-phone').textContent = user.phone || 'Not provided';
        document.getElementById('display-dateOfBirth').textContent = user.dateOfBirth ? new Date(user.dateOfBirth).toLocaleDateString() : 'Not provided';
        document.getElementById('display-memberSince').textContent = new Date(user.createdAt || Date.now()).toLocaleDateString();
        
    } catch (error) {
        console.error('Error loading profile:', error);
        alert('Error loading profile information');
    }
}

async function loadAccountSummary() {
    try {
        const response = await axios.get('/api/v1/users/summary', {
            headers: {
                'Authorization': `Bearer ${localStorage.getItem('userToken')}`
            }
        });
        
        const summary = response.data;
        document.getElementById('total-orders').textContent = summary.totalOrders || 0;
        document.getElementById('total-spent').textContent = `$${(summary.totalSpent || 0).toFixed(2)}`;
        document.getElementById('active-orders').textContent = summary.activeOrders || 0;
        
    } catch (error) {
        console.error('Error loading account summary:', error);
        // Keep default values if API fails
    }
}

function logout() {
    if (confirm('Are you sure you want to logout?')) {
        // Clear localStorage
        localStorage.removeItem('userToken');
        localStorage.removeItem('user');
        localStorage.removeItem('cart');
        
        // Show logout message
        alert('You have been logged out successfully!');
        
        // Redirect to home page
        window.location.href = '/';
    }
}

function getStatusBadgeClass(status) {
    switch (status) {
        case 'pending':
            return 'bg-warning text-dark';
        case 'processing':
            return 'bg-info text-white';
        case 'shipped':
            return 'bg-primary text-white';
        case 'delivered':
            return 'bg-success text-white';
        case 'cancelled':
            return 'bg-danger text-white';
        default:
            return 'bg-secondary text-white';
    }
}
</script>
