<style>
    @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600;700;800&family=Inter:wght@300;400;500;600;700&display=swap');
    
    :root {
        --luxury-navy: #0f172a;
        --luxury-charcoal: #1e293b;
        --luxury-gold: #d4af37;
        --luxury-champagne: #f5e6d3;
        --luxury-pearl: #f8fafc;
    }
    
    body {
        font-family: 'Inter', sans-serif;
        background-color: #f8fafc;
        min-height: 100vh;
    }

    .luxury-heading {
        font-family: 'Playfair Display', serif;
    }

    .gold-text {
        color: var(--luxury-gold);
    }

    /* Animations */
    @keyframes fadeInUp {
        from {
            opacity: 0;
            transform: translateY(30px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @keyframes shimmer {
        0% { background-position: -1000px 0; }
        100% { background-position: 1000px 0; }
    }

    .animate-fade-in-up {
        animation: fadeInUp 0.8s ease-out forwards;
    }

    /* Main Card */
    .luxury-form-card {
        background: white;
        border-radius: 20px;
        box-shadow: 0 10px 30px rgba(15, 23, 42, 0.1);
        overflow: hidden;
        border: 1px solid rgba(15, 23, 42, 0.08);
        margin-bottom: 3rem;
        transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    }

    .luxury-form-card:hover {
        box-shadow: 0 20px 50px rgba(15, 23, 42, 0.15);
        border-color: var(--luxury-gold);
    }

    .card-header-luxury {
        background: linear-gradient(135deg, var(--luxury-navy) 0%, var(--luxury-charcoal) 100%);
        border-bottom: 3px solid var(--luxury-gold);
        padding: 2rem;
        position: relative;
        overflow: hidden;
    }

    .card-header-luxury::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: linear-gradient(45deg, transparent, rgba(212, 175, 55, 0.1), transparent);
        animation: shimmer 3s infinite;
    }

    .card-header-luxury h2 {
        font-family: 'Playfair Display', serif;
        font-size: 2rem;
        color: #ffffff;
        margin: 0;
        position: relative;
        z-index: 1;
        display: flex;
        align-items: center;
        gap: 1rem;
    }

    .header-icon {
        width: 50px;
        height: 50px;
        background: linear-gradient(135deg, #d4af37, #ffd700);
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #0f172a;
        font-size: 1.5rem;
        box-shadow: 0 5px 15px rgba(212, 175, 55, 0.3);
    }

    /* Form Styling */
    .card-body-luxury {
        padding: 3rem;
        background: white;
    }

    .form-label-luxury {
        font-weight: 600;
        color: var(--luxury-navy);
        margin-bottom: 0.75rem;
        font-size: 0.95rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .required-star {
        color: var(--luxury-gold);
    }

    .luxury-input,
    .luxury-select,
    .luxury-textarea {
        background: #ffffff;
        border: 2px solid #e2e8f0;
        border-radius: 12px;
        padding: 0.875rem 1.25rem;
        color: var(--luxury-navy);
        font-size: 1rem;
        transition: all 0.3s ease;
        width: 100%;
    }

    .luxury-input:focus,
    .luxury-select:focus,
    .luxury-textarea:focus {
        outline: none;
        border-color: var(--luxury-gold);
        background: #ffffff;
        box-shadow: 0 0 0 3px rgba(212, 175, 55, 0.1);
    }

    .luxury-input::placeholder {
        color: #94a3b8;
    }

    .luxury-textarea {
        resize: vertical;
    }

    .input-group-luxury {
        display: flex;
        align-items: stretch;
    }

    .input-group-text-luxury {
        background: rgba(212, 175, 55, 0.1);
        border: 2px solid #e2e8f0;
        border-right: none;
        border-radius: 12px 0 0 12px;
        color: var(--luxury-gold);
        font-weight: 600;
        padding: 0 1.25rem;
        display: flex;
        align-items: center;
    }

    .input-group-luxury .luxury-input {
        border-radius: 0 12px 12px 0;
    }

    .luxury-file-input {
        background: #f8fafc;
        border: 2px dashed #cbd5e1;
        border-radius: 12px;
        padding: 2rem;
        text-align: center;
        cursor: pointer;
        transition: all 0.3s ease;
        position: relative;
    }

    .luxury-file-input:hover {
        border-color: var(--luxury-gold);
        background: rgba(212, 175, 55, 0.05);
    }

    .luxury-file-input input[type="file"] {
        position: absolute;
        opacity: 0;
        width: 100%;
        height: 100%;
        top: 0;
        left: 0;
        cursor: pointer;
    }

    .file-input-content {
        color: #64748b;
        pointer-events: none;
    }

    .file-input-content i {
        font-size: 2.5rem;
        color: var(--luxury-gold);
        margin-bottom: 0.75rem;
        display: block;
    }

    .file-input-label {
        color: var(--luxury-navy);
        font-weight: 600;
        font-size: 1rem;
        margin-bottom: 0.5rem;
    }

    .file-input-hint {
        color: #94a3b8;
        font-size: 0.85rem;
    }

    .current-image-preview {
        max-width: 200px;
        border-radius: 12px;
        border: 2px solid #e2e8f0;
        margin-bottom: 1rem;
    }

    /* Checkbox */
    .luxury-checkbox {
        display: flex;
        align-items: center;
        gap: 1rem;
        padding: 1.5rem;
        background: #f8fafc;
        border: 2px solid #e2e8f0;
        border-radius: 12px;
        cursor: pointer;
        transition: all 0.3s ease;
    }

    .luxury-checkbox:hover {
        border-color: var(--luxury-gold);
        background: rgba(212, 175, 55, 0.05);
    }

    .luxury-checkbox input[type="checkbox"] {
        width: 24px;
        height: 24px;
        cursor: pointer;
        accent-color: var(--luxury-gold);
    }

    .luxury-checkbox label {
        color: var(--luxury-navy);
        font-weight: 500;
        cursor: pointer;
        margin: 0;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .featured-badge {
        background: linear-gradient(135deg, #d4af37, #ffd700);
        color: #0f172a;
        padding: 0.25rem 0.75rem;
        border-radius: 6px;
        font-size: 0.75rem;
        font-weight: 700;
        text-transform: uppercase;
    }

    /* Buttons */
    .btn-group-luxury {
        display: flex;
        justify-content: flex-end;
        gap: 1rem;
        margin-top: 2.5rem;
        padding-top: 2rem;
        border-top: 1px solid #e2e8f0;
    }

    .luxury-btn {
        padding: 1rem 2.5rem;
        border-radius: 12px;
        font-weight: 600;
        font-size: 1rem;
        border: none;
        cursor: pointer;
        transition: all 0.3s ease;
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }

    .luxury-btn-primary {
        background: linear-gradient(135deg, var(--luxury-gold), #ffd700);
        color: var(--luxury-navy);
        box-shadow: 0 4px 15px rgba(212, 175, 55, 0.3);
    }

    .luxury-btn-primary:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 25px rgba(212, 175, 55, 0.4);
    }

    .luxury-btn-secondary {
        background: white;
        color: var(--luxury-navy);
        border: 2px solid #e2e8f0;
    }

    .luxury-btn-secondary:hover {
        background: #f8fafc;
        border-color: var(--luxury-gold);
    }

    /* Form Grid */
    .form-row {
        display: grid;
        gap: 1.5rem;
        margin-bottom: 1.5rem;
    }

    .form-row-2 {
        grid-template-columns: repeat(2, 1fr);
    }

    .form-row-3 {
        grid-template-columns: repeat(3, 1fr);
    }

    .form-group {
        display: flex;
        flex-direction: column;
    }

    /* Modal */
    .modal-content {
        background: white;
        border: 1px solid rgba(15, 23, 42, 0.1);
        border-radius: 16px;
    }

    .modal-header {
        border-bottom: 2px solid rgba(212, 175, 55, 0.2);
        background: linear-gradient(135deg, var(--luxury-navy) 0%, var(--luxury-charcoal) 100%);
    }

    .modal-title {
        font-family: 'Playfair Display', serif;
        color: white;
    }

    .modal-header .btn-close {
        filter: invert(1);
    }

    .loading-spinner {
        display: inline-block;
        width: 40px;
        height: 40px;
        border: 4px solid rgba(212, 175, 55, 0.2);
        border-top-color: var(--luxury-gold);
        border-radius: 50%;
        animation: spin 1s linear infinite;
    }

    @keyframes spin {
        to { transform: rotate(360deg); }
    }

    /* Responsive */
    @media (max-width: 768px) {
        .form-row-2,
        .form-row-3 {
            grid-template-columns: 1fr;
        }

        .card-body-luxury {
            padding: 2rem 1.5rem;
        }

        .btn-group-luxury {
            flex-direction: column;
        }

        .luxury-btn {
            justify-content: center;
            width: 100%;
        }
    }
</style>

<!-- Hero Section -->
