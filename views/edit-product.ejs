<div class="container mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="max-w-5xl mx-auto">
        <!-- Loading State -->
        <div id="loadingState" class="text-center py-12">
            <div class="loading-spinner mx-auto mb-4"></div>
            <p class="text-slate-600 font-medium">Loading product details...</p>
        </div>

        <!-- Form Card -->
        <div class="luxury-form-card animate-fade-in-up" id="formCard" style="display: none;">
            <div class="card-header-luxury">
                <h2>
                    <div class="header-icon">
                        <i class="fas fa-edit"></i>
                    </div>
                    Update Product Details
                </h2>
            </div>
            
            <div class="card-body-luxury">
                <form id="edit-product-form" enctype="multipart/form-data">
                    <input type="hidden" id="productId">
                    
                    <!-- Current Image -->
                    <div class="form-row" id="currentImageSection" style="display: none;">
                        <div class="form-group">
                            <label class="form-label-luxury">
                                <i class="fas fa-image"></i>
                                Current Product Image
                            </label>
                            <div class="flex items-center gap-4">
                                <img id="currentImage" src="" alt="Current Product" class="current-image-preview">
                                <div>
                                    <p class="text-sm text-slate-600">This is the current product image.</p>
                                    <p class="text-sm text-slate-500">Upload a new image below to replace it.</p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Product Name & Brand -->
                    <div class="form-row form-row-2">
                        <div class="form-group">
                            <label for="name" class="form-label-luxury">
                                <i class="fas fa-tag"></i>
                                Product Name
                                <span class="required-star">*</span>
                            </label>
                            <input type="text" class="luxury-input" id="name" name="name" placeholder="Enter product name" required>
                        </div>
                        <div class="form-group">
                            <label for="brand" class="form-label-luxury">
                                <i class="fas fa-copyright"></i>
                                Brand
                            </label>
                            <input type="text" class="luxury-input" id="brand" name="brand" placeholder="Enter brand name">
                        </div>
                    </div>

                    <!-- Price, Category, Stock -->
                    <div class="form-row form-row-3">
                        <div class="form-group">
                            <label for="price" class="form-label-luxury">
                                <i class="fas fa-dollar-sign"></i>
                                Price
                                <span class="required-star">*</span>
                            </label>
                            <div class="input-group-luxury">
                                <span class="input-group-text-luxury">$</span>
                                <input type="number" class="luxury-input" id="price" name="price" step="0.01" min="0" placeholder="0.00" required>
                            </div>
                        </div>
                        <div class="form-group">
                            <label for="category" class="form-label-luxury">
                                <i class="fas fa-folder-open"></i>
                                Category
                                <span class="required-star">*</span>
                            </label>
                            <select class="luxury-select" id="category" name="category" required>
                                <option value="">Select Category</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label for="countInStock" class="form-label-luxury">
                                <i class="fas fa-box"></i>
                                Stock Quantity
                                <span class="required-star">*</span>
                            </label>
                            <input type="number" class="luxury-input" id="countInStock" name="countInStock" min="0" placeholder="0" required>
                        </div>
                    </div>

                    <!-- Rating & Reviews -->
                    <div class="form-row form-row-2">
                        <div class="form-group">
                            <label for="rating" class="form-label-luxury">
                                <i class="fas fa-star"></i>
                                Rating
                            </label>
                            <input type="number" class="luxury-input" id="rating" name="rating" step="0.1" min="0" max="5" value="0" placeholder="0.0">
                        </div>
                        <div class="form-group">
                            <label for="numReviews" class="form-label-luxury">
                                <i class="fas fa-comments"></i>
                                Number of Reviews
                            </label>
                            <input type="number" class="luxury-input" id="numReviews" name="numReviews" min="0" value="0" placeholder="0">
