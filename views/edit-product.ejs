                    </div>

                    <!-- Short Description -->
                    <div class="form-row">
                        <div class="form-group">
                            <label for="description" class="form-label-luxury">
                                <i class="fas fa-align-left"></i>
                                Short Description
                                <span class="required-star">*</span>
                            </label>
                            <textarea class="luxury-textarea" id="description" name="description" rows="3" placeholder="Enter a brief description..." required></textarea>
                        </div>
                    </div>

                    <!-- Detailed Description -->
                    <div class="form-row">
                        <div class="form-group">
                            <label for="richDescription" class="form-label-luxury">
                                <i class="fas fa-file-alt"></i>
                                Detailed Description
                            </label>
                            <textarea class="luxury-textarea" id="richDescription" name="richDescription" rows="5" placeholder="Enter detailed product information..."></textarea>
                        </div>
                    </div>

                    <!-- Product Image Upload -->
                    <div class="form-row">
                        <div class="form-group">
                            <label class="form-label-luxury">
                                <i class="fas fa-image"></i>
                                Update Product Image
                            </label>
                            <div class="luxury-file-input">
                                <input type="file" id="image" name="image" accept="image/*">
                                <div class="file-input-content">
                                    <i class="fas fa-cloud-upload-alt"></i>
                                    <div class="file-input-label">Click to Upload New Image</div>
                                    <div class="file-input-hint">Leave empty to keep current image | Max: 5MB | JPG, PNG, GIF</div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Featured Product Checkbox -->
                    <div class="form-row">
                        <div class="luxury-checkbox">
                            <input type="checkbox" id="isFeatured" name="isFeatured">
                            <label for="isFeatured">
                                <i class="fas fa-star"></i>
                                Featured Product
                                <span class="featured-badge">Premium</span>
                            </label>
                        </div>
                    </div>

                    <!-- Action Buttons -->
                    <div class="btn-group-luxury">
                        <button type="button" class="luxury-btn luxury-btn-secondary" onclick="goBack()">
                            <i class="fas fa-times"></i>
                            Cancel
                        </button>
                        <button type="submit" class="luxury-btn luxury-btn-primary">
                            <i class="fas fa-save"></i>
