<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Minimal Cart Test</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
    <div class="container mt-5">
        <h1>Minimal Cart Test</h1>
        <p>This page tests cart functionality with a minimal script.</p>
        
        <div class="row">
            <div class="col-md-6">
                <h3>Test Buttons</h3>
                <button class="btn btn-primary me-2" onclick="addToCart('product-123', 1)">Add Product 123</button>
                <button class="btn btn-success me-2" onclick="addToCart('product-456', 2)">Add Product 456 (qty 2)</button>
                <button class="btn btn-info me-2" onclick="window.testMinimal()">Run Test Function</button>
                <button class="btn btn-warning me-2" onclick="checkCart()">Check Cart Contents</button>
                <button class="btn btn-danger me-2" onclick="clearTestCart()">Clear Cart</button>
                <button class="btn btn-secondary me-2" onclick="testLogout()">Test Logout</button>
            </div>
            <div class="col-md-6">
                <h3>Product Card Test</h3>
                <div class="card" style="width: 18rem;">
                    <div class="card-body">
                        <h5 class="card-title">Test Product</h5>
                        <p class="card-text">A sample product for testing.</p>
                        <p class="text-primary">$19.99</p>
                        <button class="btn btn-primary" onclick="addToCart('card-product-789', 1)">Add to Cart</button>
                    </div>
                </div>
            </div>
        </div>
        
        <div class="mt-4">
            <h3>Console Output</h3>
            <div id="console-output" class="border p-3" style="height: 200px; overflow-y: auto; background-color: #f8f9fa; font-family: monospace;">
                <!-- Console output will appear here -->
            </div>
        </div>
    </div>

    <!-- Minimal cart script -->
    <script src="/js/minimal-cart.js"></script>
    
    <script>
        // Capture console output
        const originalLog = console.log;
        const outputDiv = document.getElementById('console-output');
        
        console.log = function(...args) {
            originalLog.apply(console, args);
            const div = document.createElement('div');
            div.textContent = args.join(' ');
            outputDiv.appendChild(div);
            outputDiv.scrollTop = outputDiv.scrollHeight;
        };
        
        function checkCart() {
            const cart = JSON.parse(localStorage.getItem('cart') || '[]');
            console.log('Current cart contents:', cart);
            alert('Cart has ' + cart.length + ' different products. Check console for details.');
        }
        
        function clearTestCart() {
            localStorage.removeItem('cart');
            console.log('Cart cleared');
            alert('Cart cleared!');
        }
        
        function testLogout() {
            console.log('Testing logout functionality...');
            
            // First, simulate being logged in
            localStorage.setItem('userToken', 'test-token-123');
            localStorage.setItem('user', JSON.stringify({name: 'Test User', email: 'test@example.com'}));
            console.log('Set test user data');
            
            // Test the logout function
            if (typeof logout === 'function') {
                console.log('logout function found, calling it...');
                logout();
            } else {
                console.log('logout function not found, creating minimal version...');
                // Create minimal logout
                localStorage.removeItem('userToken');
                localStorage.removeItem('user');
                alert('Logged out successfully (minimal version)');
                console.log('Minimal logout executed');
            }
        }
        
        // Initial load
        console.log('Minimal test page loaded');
        console.log('addToCart function available:', typeof window.addToCart);
    </script>
</body>
</html>
