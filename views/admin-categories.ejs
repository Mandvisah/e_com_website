    }
    
    .stat-label {
        color: #64748b;
        font-size: 0.9rem;
        font-weight: 500;
    }
    
    .luxury-card {
        background: white;
        border-radius: 20px;
        box-shadow: 0 10px 30px rgba(15, 23, 42, 0.1);
        border: 1px solid rgba(15, 23, 42, 0.08);
        overflow: hidden;
    }
    
    .card-header-luxury {
        background: linear-gradient(135deg, var(--luxury-navy), var(--luxury-charcoal));
        border-bottom: 3px solid var(--luxury-gold);
        padding: 2rem;
        position: relative;
    }
    
    .card-header-luxury::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: linear-gradient(45deg, transparent, rgba(212, 175, 55, 0.1), transparent);
