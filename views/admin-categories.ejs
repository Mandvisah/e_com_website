    }
    
    .category-name {
        font-weight: 600;
        color: var(--luxury-navy);
        font-size: 1rem;
    }
    
    .color-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.5rem 1rem;
        border-radius: 8px;
        font-size: 0.85rem;
