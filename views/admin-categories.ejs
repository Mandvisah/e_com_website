        gap: 1rem;
        position: relative;
        z-index: 1;
    }
    
    .filter-section {
        padding: 2rem;
        background: #f8fafc;
        border-bottom: 1px solid #e2e8f0;
    }
    
    .luxury-input {
        background: white;
