<div class="container mx-auto px-4 py-12">
    <!-- Luxury Filter & Search Section -->
    <div class="luxury-card mb-8 animate-fade-in-up" style="animation-delay: 0.3s;">
        <div class="luxury-card-header">
            <div class="flex items-center gap-4">
                <div class="bg-amber-500 rounded-full p-3">
                    <i class="fas fa-filter text-white"></i>
                </div>
                <div>
                    <h5 class="text-white text-xl font-bold mb-1">
                        Smart Product Filtering
                    </h5>
                    <p class="text-slate-300 text-sm mb-0">
                        Find your perfect product with our advanced search and filter options
                    </p>
                </div>
            </div>
        </div>
        <div class="p-6">
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                <div>
                    <label for="category-filter" class="luxury-label">
                        <i class="fas fa-tags text-amber-500 mr-2"></i>Category
                    </label>
                    <select id="category-filter" class="luxury-input" onchange="filterProducts()">
                        <option value="">All Categories</option>
                    </select>
                </div>
                <div>
                    <label for="search-input" class="luxury-label">
                        <i class="fas fa-search text-amber-500 mr-2"></i>Search Products
                    </label>
                    <div class="relative">
                        <input type="text" 
                               id="search-input" 
                               class="luxury-input pr-10" 
                               placeholder="Search by name, description..." 
                               onkeyup="searchProducts()">
                        <i class="fas fa-search absolute right-3 top-1/2 transform -translate-y-1/2 text-slate-400"></i>
                    </div>
                </div>
                <div>
                    <label for="sort-select" class="luxury-label">
                        <i class="fas fa-sort text-amber-500 mr-2"></i>Sort By
                    </label>
                    <select id="sort-select" class="luxury-input" onchange="sortProducts()">
                        <option value="">Sort Options</option>
                        <option value="name">Name A-Z</option>
                        <option value="-name">Name Z-A</option>
                        <option value="price">Price: Low to High</option>
                        <option value="-price">Price: High to Low</option>
                    </select>
                </div>
            </div>
            
            <!-- Filter Results Summary -->
            <div class="mt-6 p-4 bg-slate-50 rounded-lg">
                <div class="flex justify-between items-center flex-wrap gap-3">
                    <div>
                        <span class="text-slate-600">Showing</span>
                        <span id="products-count" class="luxury-badge mx-2">Loading...</span>
                        <span class="text-slate-600">products</span>
                    </div>
                    <button class="luxury-btn-outline" onclick="resetFilters()">
                        <i class="fas fa-refresh mr-2"></i>Reset Filters
                    </button>
                </div>
            </div>
        </div>
    </div>
    
    <!-- Luxury Products Display Section -->
    <div class="mb-8">
        <div class="flex justify-between items-center mb-6 animate-fade-in-up" style="animation-delay: 0.4s;">
            <div>
                <h2 class="luxury-heading text-3xl text-slate-900 mb-1">
                    <i class="fas fa-shopping-bag gold-text mr-2"></i>
                    Featured Products
                </h2>
                <p class="text-slate-600 mb-0">Handpicked items just for you</p>
            </div>
            <div class="flex items-center gap-3">
                <div class="flex items-center">
                    <span class="text-slate-600 text-sm mr-2">Total:</span>
                    <span id="products-count-display" class="luxury-badge text-lg">
                        <i class="fas fa-boxes mr-1"></i>Loading...
                    </span>
                </div>
                </div>
            </div>
            
            <!-- Loading State -->
            <div id="loading-container" class="text-center py-12" style="display: none;">
                <div class="inline-block animate-spin rounded-full h-16 w-16 border-t-4 border-b-4 border-amber-500 mb-4"></div>
                <p class="text-slate-600 text-lg">Loading amazing products...</p>
            </div>
            
            <!-- Products Grid -->
            <div id="products-container" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
                <!-- Products will be loaded here -->
            </div>
            
            <!-- Loading Spinner -->
            <div id="loading-spinner" class="text-center py-12" style="display: none;">
                <div class="inline-block animate-spin rounded-full h-16 w-16 border-t-4 border-b-4 border-amber-500 mb-4"></div>
                <p class="text-slate-600 text-lg">Loading amazing products...</p>
            </div>
            
            <!-- No Products Message -->
            <div id="no-products" class="text-center py-12" style="display: none;">
                <i class="fas fa-search text-slate-300 mb-4" style="font-size: 5rem;"></i>
                <h4 class="text-slate-600 text-2xl mb-2">No products found</h4>
                <p class="text-slate-500">Try adjusting your filters or search terms.</p>
            </div>
        </div>
    </div>
</div>

<script>
let allProducts = [];
let filteredProducts = [];

document.addEventListener('DOMContentLoaded', function() {
    console.log('Products page DOMContentLoaded');
    
    // Load categories and products first
    loadCategories();
    loadProducts();
    
    // Ensure main.js functions are available - use multiple approaches
    function ensureMainJSLoaded() {
        if (typeof updateNavigation === 'function' && typeof updateCartCount === 'function') {
            console.log('Main.js functions are available');
            updateCartCount();
            updateNavigation();
            return true;
        }
        return false;
    }
    
    // Try immediately
    if (!ensureMainJSLoaded()) {
        // If not available, try with increasing delays
        setTimeout(() => {
            if (!ensureMainJSLoaded()) {
                setTimeout(() => {
                    if (!ensureMainJSLoaded()) {
                        console.log('Main.js functions still not available after 500ms');
                        // Use local fallback for cart count
                        updateCartBadge();
                    }
                }, 200);
            }
        }, 100);
    }
});

// Backup: ensure functions are available when window fully loads
window.addEventListener('load', function() {
    console.log('Window loaded - ensuring cart and navigation are updated');
    
    if (typeof updateCartCount === 'function') {
        updateCartCount();
    }
    
    if (typeof updateNavigation === 'function') {
        updateNavigation();
    }
});

// Also update when page becomes visible (for navigation between pages)
document.addEventListener('visibilitychange', function() {
    if (!document.hidden && typeof updateNavigation === 'function') {
        setTimeout(() => {
            updateNavigation();
        }, 50);
    }
});

// Force update navigation when page gains focus
window.addEventListener('focus', function() {
    if (typeof updateNavigation === 'function') {
        setTimeout(() => {
            updateNavigation();
        }, 50);
    }
});

async function loadCategories() {
    try {
        const response = await axios.get('/api/v1/categories');
        const categories = response.data;
        const select = document.getElementById('category-filter');
        
        categories.forEach(category => {
            const option = document.createElement('option');
            option.value = category._id;
            option.textContent = category.name;
            select.appendChild(option);
        });
    } catch (error) {
        console.error('Error loading categories:', error);
    }
}

async function loadProducts() {
    showLoading(true);
    try {
        console.log('Loading products...');
        const response = await axios.get('/api/v1/products');
        console.log('Products response:', response.data);
        allProducts = response.data;
        filteredProducts = [...allProducts];
        console.log('Total products loaded:', allProducts.length);
        displayProducts(filteredProducts);
    } catch (error) {
        console.error('Error loading products:', error);
        const container = document.getElementById('products-container');
        const productsCount = document.getElementById('products-count');
        
        if (productsCount) {
            productsCount.textContent = 'Error loading';
            productsCount.className = 'bg-red-500 text-white px-4 py-2 rounded-full font-semibold';
        }
        
        container.innerHTML = `
            <div class="col-span-full text-center">
                <div class="luxury-card border-l-4 border-red-500 p-8">
                    <i class="fas fa-exclamation-triangle text-red-500 mb-4" style="font-size: 4rem;"></i>
                    <h4 class="text-2xl font-bold text-slate-800 mb-2">Error loading products</h4>
                    <p class="text-slate-600 mb-6">Unable to load products. Please try refreshing the page.</p>
                    <button class="luxury-btn-primary" onclick="loadProducts()">
                        <i class="fas fa-sync-alt mr-2"></i>Try Again
                    </button>
                </div>
            </div>
        `;
    }
    showLoading(false);
}

function displayProducts(products) {
    const container = document.getElementById('products-container');
    const productsCount = document.getElementById('products-count');
    const productsCountDisplay = document.getElementById('products-count-display');
    const noProductsDiv = document.getElementById('no-products');
    
    // Update both products count displays
    if (productsCount) {
        productsCount.textContent = `${products.length} Products`;
    }
    if (productsCountDisplay) {
        productsCountDisplay.innerHTML = `<i class="fas fa-boxes me-1"></i>${products.length}`;
    }
    
    if (products.length === 0) {
        container.innerHTML = `
            <div class="col-span-full text-center py-12">
                <div class="luxury-card bg-slate-50 p-12">
                    <i class="fas fa-search text-slate-300 mb-4" style="font-size: 5rem;"></i>
                    <h4 class="text-2xl font-bold text-slate-600 mb-2">No Products Found</h4>
                    <p class="text-slate-500 mb-6">Try adjusting your search or filter criteria.</p>
                    <button class="luxury-btn-primary" onclick="resetFilters()">
                        <i class="fas fa-refresh mr-2"></i>Reset Filters
                    </button>
                </div>
            </div>
        `;
        if (noProductsDiv) noProductsDiv.style.display = 'none';
        return;
    }
    
    if (noProductsDiv) noProductsDiv.style.display = 'none';
    
    container.innerHTML = products.map((product, index) => `
        <div class="luxury-card flex flex-col overflow-hidden group cursor-pointer transform transition-all duration-300 hover:scale-105 hover:shadow-2xl animate-fade-in-up" style="animation-delay: ${index * 0.05}s;">
            <div class="relative overflow-hidden">
                <img src="${product.image || 'https://via.placeholder.com/300x200?text=Product'}" 
                     class="w-full h-64 object-cover transition-transform duration-500 group-hover:scale-110" 
                     alt="${product.name}"
                     onerror="this.onerror=null; this.src='https://via.placeholder.com/300x200?text=No+Image';">
                <div class="absolute inset-0 bg-gradient-to-t from-slate-900/70 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
                ${product.countInStock === 0 ? '<div class="absolute top-3 right-3"><span class="bg-red-500 text-white px-3 py-1 rounded-full text-sm font-semibold">Out of Stock</span></div>' : ''}
                ${product.countInStock > 0 && product.countInStock <= 5 ? '<div class="absolute top-3 right-3"><span class="bg-amber-500 text-white px-3 py-1 rounded-full text-sm font-semibold">Low Stock</span></div>' : ''}
            </div>
            <div class="p-6 flex flex-col flex-grow">
                <h5 class="text-xl font-bold text-slate-800 mb-2 group-hover:text-amber-600 transition-colors">${product.name}</h5>
                <p class="text-slate-600 text-sm mb-4 flex-grow line-clamp-3">${(product.description || '').substring(0, 100)}${(product.description || '').length > 100 ? '...' : ''}</p>
                <div class="flex justify-between items-center mb-4">
                    <span class="text-2xl font-bold text-amber-600">$${product.price}</span>
                    <span class="text-sm text-slate-500">
                        <i class="fas fa-box mr-1"></i>${product.countInStock} left
                    </span>
                </div>
                <div class="flex gap-2">
                    <button class="luxury-btn-outline px-3 py-2 text-sm" onclick="viewProduct('${product._id}')" title="View Details">
                        <i class="fas fa-eye"></i>
                    </button>
                    <button class="luxury-btn-primary flex-grow py-2 text-sm" onclick="addToCart('${product._id}')" ${product.countInStock === 0 ? 'disabled' : ''}>
                        <i class="fas fa-cart-plus mr-2"></i>${product.countInStock === 0 ? 'Out of Stock' : 'Add to Cart'}
                    </button>
                </div>
            </div>
        </div>
    `).join('');
}

function filterProducts() {
    const categoryId = document.getElementById('category-filter').value;
    
    if (categoryId) {
        filteredProducts = allProducts.filter(product => {
            // Handle both populated and non-populated category references
            const productCategoryId = typeof product.category === 'object' 
                ? product.category._id 
                : product.category;
            return productCategoryId === categoryId;
        });
    } else {
        filteredProducts = [...allProducts];
    }
    
    applySearch();
}

function searchProducts() {
    applySearch();
}

function applySearch() {
    const searchTerm = document.getElementById('search-input').value.toLowerCase();
    
    let searchResults = filteredProducts;
    
    if (searchTerm) {
        searchResults = filteredProducts.filter(product =>
            product.name.toLowerCase().includes(searchTerm) ||
            product.description.toLowerCase().includes(searchTerm)
        );
    }
    
    displayProducts(searchResults);
}

function sortProducts() {
    const sortBy = document.getElementById('sort-select').value;
    
    if (!sortBy) return;
    
    const sortedProducts = [...filteredProducts];
    
    switch (sortBy) {
        case 'name':
            sortedProducts.sort((a, b) => a.name.localeCompare(b.name));
            break;
        case '-name':
            sortedProducts.sort((a, b) => b.name.localeCompare(a.name));
            break;
        case 'price':
            sortedProducts.sort((a, b) => a.price - b.price);
            break;
        case '-price':
            sortedProducts.sort((a, b) => b.price - a.price);
            break;
    }
    
    displayProducts(sortedProducts);
}

function viewProduct(productId) {
    window.location.href = `/product/${productId}`;
}

// Reset all filters to default state
function resetFilters() {
    document.getElementById('category-filter').value = '';
    document.getElementById('search-input').value = '';
    document.getElementById('sort-select').value = '';
    
    // Reset to show all products
    filteredProducts = [...allProducts];
    displayProducts(filteredProducts);
    
    // Show success message
    if (typeof window.showToast === 'function') {
        window.showToast('Filters reset successfully!', 'info');
    }
}

// Enhanced showLoading function
function showLoading(show) {
    const loadingContainer = document.getElementById('loading-container');
    const productsContainer = document.getElementById('products-container');
    
    if (loadingContainer) {
        loadingContainer.style.display = show ? 'block' : 'none';
    }
    if (productsContainer) {
        productsContainer.style.display = show ? 'none' : 'block';
    }
}

// Note: addToCart function is provided by main.js
// Using the global addToCart function instead of local implementation

function updateCartBadge() {
    const cart = JSON.parse(localStorage.getItem('cart')) || [];
    const totalItems = cart.reduce((total, item) => total + item.quantity, 0);
    
    // Update the cart count in the header navigation
    const cartCount = document.getElementById('cart-count');
    if (cartCount) {
        cartCount.textContent = totalItems;
    }
    
    // Also update any cart badge elements (backup)
    const cartBadge = document.querySelector('.cart-badge');
    if (cartBadge) {
        cartBadge.textContent = totalItems;
        cartBadge.style.display = totalItems > 0 ? 'inline' : 'none';
    }
}

function showLoading(show) {
    document.getElementById('loading-spinner').style.display = show ? 'block' : 'none';
}

function showToast(message, type = 'info') {
    // Create toast element
    const toastContainer = document.getElementById('toastContainer') || createToastContainer();
    
    const toastId = 'toast-' + Date.now();
    const bgColor = type === 'error' ? 'bg-red-500' : type === 'success' ? 'bg-green-500' : 'bg-blue-500';
    const icon = type === 'error' ? 'exclamation-circle' : type === 'success' ? 'check-circle' : 'info-circle';
    
    const toastHtml = `
        <div id="${toastId}" class="${bgColor} text-white px-6 py-4 rounded-lg shadow-lg mb-4 flex items-center justify-between animate-slide-in-right" role="alert">
            <div class="flex items-center">
                <i class="fas fa-${icon} mr-3"></i>
                <span>${message}</span>
            </div>
            <button type="button" class="ml-4 text-white hover:text-gray-200" onclick="document.getElementById('${toastId}').remove()">
                <i class="fas fa-times"></i>
            </button>
        </div>
    `;
    
    toastContainer.innerHTML = toastHtml + toastContainer.innerHTML;
    
    // Auto remove after 3 seconds
    setTimeout(() => {
        const toastElement = document.getElementById(toastId);
        if (toastElement) {
            toastElement.classList.add('animate-fade-out');
            setTimeout(() => toastElement.remove(), 300);
        }
    }, 3000);
}

function createToastContainer() {
    const container = document.createElement('div');
    container.id = 'toastContainer';
    container.className = 'fixed top-4 right-4 z-50';
    document.body.appendChild(container);
    return container;
// Initialize cart badge and navigation on page load - removed duplicate DOMContentLoaded
// This functionality is now handled in the main DOMContentLoaded above
}
</script>

<!-- Main JavaScript file with cart functions -->
<script src="/js/main.js"></script>

<!-- 3D Animations Enhancement Script -->
<script src="/js/3d-animations.js"></script>

<!-- Force navigation update script -->
<script>
// Force navigation update when page loads
window.addEventListener('load', function() {
    console.log('Page fully loaded - forcing navigation update');
    
    // Direct navigation update
    const isLoggedIn = !!localStorage.getItem('userToken');
    const user = JSON.parse(localStorage.getItem('user') || '{}');
    
    console.log('Login status:', isLoggedIn, 'User:', user);
    
    // Get elements
    const loginLink = document.getElementById('login-link');
    const registerLink = document.getElementById('register-link');
    const userDropdown = document.getElementById('user-dropdown');
    const userName = document.getElementById('user-name');
    
    if (isLoggedIn && user.name) {
        // Hide login/register
        if (loginLink) {
            loginLink.style.display = 'none';
            console.log('Hidden login link');
        }
        if (registerLink) {
            registerLink.style.display = 'none';
            console.log('Hidden register link');
        }
        
        // Show user dropdown
        if (userDropdown) {
            userDropdown.style.display = 'block';
            console.log('Showed user dropdown');
        }
        if (userName) {
            userName.textContent = user.name || user.email || 'User';
            console.log('Set user name:', userName.textContent);
        }
    }
    
    // Also call main.js function if available
    if (typeof window.updateNavigation === 'function') {
        window.updateNavigation();
        console.log('Called window.updateNavigation');
    }
});

// Also force update after a delay
setTimeout(function() {
    console.log('Delayed navigation update');
    const isLoggedIn = !!localStorage.getItem('userToken');
    if (isLoggedIn && typeof window.updateNavigation === 'function') {
        window.updateNavigation();
    }
}, 1000);
</script>
