<div class="container mx-auto px-4 py-12">
    <div class="max-w-4xl mx-auto">
        <div class="luxury-card animate-fade-in-up" style="animation-delay: 0.3s;">
            <div class="luxury-card-header">
                <h3 class="text-white text-2xl font-bold">
                    <i class="fas fa-user mr-2"></i>Personal Information
                </h3>
            </div>
            <div class="p-6 md:p-8">
                <form id="profile-form">
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">
                        <div>
                            <label class="luxury-label">First Name <span class="text-red-500">*</span></label>
                            <input type="text" class="luxury-input" id="firstName" required>
                            <p class="text-red-500 text-sm mt-1 hidden">Please enter your first name.</p>
                        </div>
                        <div>
                            <label class="luxury-label">Last Name <span class="text-red-500">*</span></label>
                            <input type="text" class="luxury-input" id="lastName" required>
                            <p class="text-red-500 text-sm mt-1 hidden">Please enter your last name.</p>
                        </div>
                    </div>
                    
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">
                        <div>
                            <label class="luxury-label">Email Address</label>
                            <input type="email" class="luxury-input bg-slate-100" id="email" readonly>
                            <p class="text-slate-500 text-sm mt-1">
                                <i class="fas fa-info-circle"></i> Email cannot be changed for security reasons
                            </p>
                        </div>
                        <div>
                            <label class="luxury-label">Phone Number</label>
                            <input type="tel" class="luxury-input" id="phone" placeholder="Enter your phone number">
                            <p class="text-slate-500 text-sm mt-1">Optional - used for order updates</p>
                        </div>
                    </div>
                    
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
                        <div>
                            <label class="luxury-label">Date of Birth</label>
                            <input type="date" class="luxury-input" id="dateOfBirth">
                            <p class="text-slate-500 text-sm mt-1">Optional - helps us serve you better</p>
                        </div>
                        <div>
                            <label class="luxury-label">Account Status</label>
                            <div class="mt-2">
                                <span class="bg-green-500 text-white px-4 py-2 rounded-full font-semibold">
                                    <i class="fas fa-check-circle mr-1"></i> Active Account
                                </span>
                            </div>
                        </div>
                    </div>

                    <div class="border-t border-slate-200 my-8"></div>

                    <!-- Address Information Section -->
                    <h5 class="luxury-heading text-2xl text-slate-900 mb-6">
                        <i class="fas fa-map-marker-alt gold-text mr-2"></i> Address Information
                        <span class="text-slate-500 text-base font-normal">(Used for shipping)</span>
                    </h5>
                    
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-6">
                        <div class="md:col-span-2">
                            <label class="luxury-label">Street Address</label>
                            <input type="text" class="luxury-input" id="street" placeholder="Enter your street address">
                        </div>
                        <div>
                            <label class="luxury-label">Apartment/Unit</label>
                            <input type="text" class="luxury-input" id="apartment" placeholder="Apt, Suite, etc.">
                        </div>
                    </div>
                    
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
                        <div>
                            <label class="luxury-label">City</label>
                            <input type="text" class="luxury-input" id="city" placeholder="Enter city">
                        </div>
                        <div>
                            <label class="luxury-label">ZIP Code</label>
                            <input type="text" class="luxury-input" id="zip" placeholder="Enter ZIP code">
                        </div>
                        <div>
                            <label class="luxury-label">Country</label>
                            <select class="luxury-input" id="country">
                                    <option value="">Select country</option>
                                    <option value="US">United States</option>
                                    <option value="CA">Canada</option>
                                    <option value="UK">United Kingdom</option>
                                    <option value="AU">Australia</option>
                                    <option value="DE">Germany</option>
                                    <option value="FR">France</option>
                                    <option value="IN">India</option>
                                    <option value="JP">Japan</option>
                                    <option value="Other">Other</option>
                                </select>
                            </div>
                        </div>

                    <div class="border-t border-slate-200 my-8"></div>

                    <!-- Action Buttons -->
                    <div class="flex flex-col sm:flex-row gap-4 justify-center">
                        <button type="submit" class="luxury-btn-primary py-3 px-8 text-lg">
                            <i class="fas fa-save mr-2"></i> Save Changes
                        </button>
                        <button type="button" class="luxury-btn-outline py-3 px-8 text-lg" onclick="resetForm()">
                            <i class="fas fa-undo mr-2"></i> Reset
                        </button>
                        <a href="/profile" class="luxury-btn-outline py-3 px-8 text-lg text-center">
                            <i class="fas fa-arrow-left mr-2"></i> Back to Profile
                        </a>
                    </div>
                </form>
            </div>
        </div>

        <!-- Help Section -->
        <div class="luxury-card mt-8 animate-fade-in-up" style="animation-delay: 0.4s;">
            <div class="p-6">
                <h6 class="luxury-heading text-xl text-slate-900 mb-3">
                    <i class="fas fa-question-circle text-blue-500 mr-2"></i> Need Help?
                </h6>
                <p class="text-slate-600 mb-3">
                    Having trouble updating your profile? Here are some tips:
                </p>
                <ul class="text-slate-600 space-y-2">
                    <li class="flex items-start"><i class="fas fa-check-circle text-green-500 mr-2 mt-1"></i><span>Make sure all required fields (marked with *) are filled</span></li>
                    <li class="flex items-start"><i class="fas fa-check-circle text-green-500 mr-2 mt-1"></i><span>Email address cannot be changed for security reasons</span></li>
                    <li class="flex items-start"><i class="fas fa-check-circle text-green-500 mr-2 mt-1"></i><span>Address information helps us provide better shipping services</span></li>
                    <li class="flex items-start"><i class="fas fa-check-circle text-green-500 mr-2 mt-1"></i><span>Your information is secure and never shared with third parties</span></li>
                </ul>
            </div>
        </div>
    </div>
</div>

<!-- Styles now handled by Tailwind and luxury-theme.css -->

<script>
document.addEventListener('DOMContentLoaded', function() {
    checkAuthStatus();
    loadProfile();
    
    // Form submission
    document.getElementById('profile-form').addEventListener('submit', updateProfile);
    
    // Form validation
    const form = document.getElementById('profile-form');
    form.addEventListener('submit', function(event) {
        if (!form.checkValidity()) {
            event.preventDefault();
            event.stopPropagation();
        }
        form.classList.add('was-validated');
    });
});

function checkAuthStatus() {
    const isLoggedIn = !!localStorage.getItem('userToken');
    if (!isLoggedIn) {
        alert('Please login to edit your profile');
        window.location.href = '/login?redirect=/edit-profile';
    }
}

async function loadProfile() {
    try {
        console.log('Making API call to: /api/v1/users/profile');
        console.log('Token:', localStorage.getItem('userToken'));
        
        const response = await axios.get('/api/v1/users/profile', {
            headers: {
                'Authorization': `Bearer ${localStorage.getItem('userToken')}`
            }
        });
        
        console.log('API response:', response.data);
        const user = response.data;
        
        // Populate form fields
        document.getElementById('firstName').value = user.firstName || '';
        document.getElementById('lastName').value = user.lastName || '';
        document.getElementById('email').value = user.email || '';
        document.getElementById('phone').value = user.phone || '';
        document.getElementById('dateOfBirth').value = user.dateOfBirth ? user.dateOfBirth.split('T')[0] : '';
        
        // Address fields
        document.getElementById('street').value = user.street || '';
        document.getElementById('apartment').value = user.apartment || '';
        document.getElementById('city').value = user.city || '';
        document.getElementById('zip').value = user.zip || '';
        document.getElementById('country').value = user.country || '';
        
    } catch (error) {
        console.error('Error loading profile:', error);
        console.error('Error details:', error.response?.data);
        console.error('Error status:', error.response?.status);
        console.error('Error URL:', error.config?.url);
        
        if (error.response?.status === 401) {
            localStorage.removeItem('userToken');
            localStorage.removeItem('user');
            window.location.href = '/login';
        } else {
            alert('Error loading profile information: ' + (error.response?.data?.message || error.message));
        }
    }
}

async function updateProfile(event) {
    event.preventDefault();
    
    const submitBtn = event.target.querySelector('button[type="submit"]');
    submitBtn.classList.add('loading');
    submitBtn.disabled = true;
    
    const formData = {
        firstName: document.getElementById('firstName').value.trim(),
        lastName: document.getElementById('lastName').value.trim(),
        phone: document.getElementById('phone').value.trim(),
        dateOfBirth: document.getElementById('dateOfBirth').value,
        street: document.getElementById('street').value.trim(),
        apartment: document.getElementById('apartment').value.trim(),
        city: document.getElementById('city').value.trim(),
        zip: document.getElementById('zip').value.trim(),
        country: document.getElementById('country').value
    };
    
    try {
        await axios.put('/api/v1/users/profile', formData, {
            headers: {
                'Authorization': `Bearer ${localStorage.getItem('userToken')}`,
                'Content-Type': 'application/json'
            }
        });
        
        // Show success message
        const alertDiv = document.createElement('div');
        alertDiv.className = 'bg-green-50 border-l-4 border-green-500 p-4 rounded mb-6 flex items-center justify-between animate-fade-in-up';
        alertDiv.innerHTML = `
            <div class="flex items-center">
                <i class="fas fa-check-circle text-green-500 text-2xl mr-3"></i>
                <span class="text-green-800 font-semibold">Profile updated successfully!</span>
            </div>
            <button type="button" class="text-green-500 hover:text-green-700" onclick="this.parentElement.remove()">
                <i class="fas fa-times"></i>
            </button>
        `;
        
        const form = document.getElementById('profile-form');
        form.parentNode.insertBefore(alertDiv, form);
        
        // Scroll to top to show success message
        window.scrollTo({ top: 0, behavior: 'smooth' });
        
        // Update localStorage user data
        const updatedUser = { ...JSON.parse(localStorage.getItem('user') || '{}'), ...formData };
        localStorage.setItem('user', JSON.stringify(updatedUser));
        
    } catch (error) {
        console.error('Error updating profile:', error);
        
        const errorMessage = error.response?.data?.message || 'Error updating profile. Please try again.';
        
        const alertDiv = document.createElement('div');
        alertDiv.className = 'bg-red-50 border-l-4 border-red-500 p-4 rounded mb-6 flex items-center justify-between animate-fade-in-up';
        alertDiv.innerHTML = `
            <div class="flex items-center">
                <i class="fas fa-exclamation-triangle text-red-500 text-2xl mr-3"></i>
                <span class="text-red-800 font-semibold">${errorMessage}</span>
            </div>
            <button type="button" class="text-red-500 hover:text-red-700" onclick="this.parentElement.remove()">
                <i class="fas fa-times"></i>
            </button>
        `;
        
        const form = document.getElementById('profile-form');
        form.parentNode.insertBefore(alertDiv, form);
        
        window.scrollTo({ top: 0, behavior: 'smooth' });
    } finally {
        submitBtn.classList.remove('loading');
        submitBtn.disabled = false;
    }
}

function resetForm() {
    if (confirm('Are you sure you want to reset all changes?')) {
        document.getElementById('profile-form').classList.remove('was-validated');
        loadProfile(); // Reload original data
        
        // Remove any existing alerts
        const alerts = document.querySelectorAll('.alert');
        alerts.forEach(alert => alert.remove());
    }
}
</script>
