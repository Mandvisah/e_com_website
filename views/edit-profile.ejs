                <li class="text-slate-400">/</li>
                <li><a href="/profile" class="text-amber-600 hover:text-amber-700 transition-colors">My Profile</a></li>
                <li class="text-slate-400">/</li>
                <li class="text-white font-semibold">Edit Profile</li>
