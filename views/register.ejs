<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Register - M-Vi Shopio</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600;700;800&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
</head>
<body class="m-0 p-0 overflow-x-hidden font-['Inter']">

<style>
    :root {
        --luxury-navy: #0f172a;
        --luxury-charcoal: #1e293b;
        --luxury-gold: #d4af37;
    }
    
    .luxury-heading {
        font-family: 'Playfair Display', serif;
    }
    
    @keyframes float {
        0%, 100% { transform: translate(0, 0) rotate(0deg); }
        50% { transform: translate(-100px, -100px) rotate(180deg); }
    }
    
    .animate-float::before {
        animation: float 20s infinite ease-in-out;
    }
    
    .pattern-dots::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: url('data:image/svg+xml,<svg width="100" height="100" xmlns="http://www.w3.org/2000/svg"><circle cx="50" cy="50" r="2" fill="rgba(255,255,255,0.1)"/></svg>');
        background-size: 50px 50px;
        opacity: 0.3;
    }
    
    .gold-text {
        color: var(--luxury-gold);
        text-shadow: 0 0 20px rgba(212, 175, 55, 0.3);
    }
</style>

<div class="min-h-screen flex bg-gradient-to-br from-slate-900 via-slate-800 to-slate-900 relative overflow-hidden">
    <div class="absolute -top-1/2 -right-1/2 w-full h-full opacity-10">
        <div class="absolute inset-0" style="background-image: url('data:image/svg+xml,%3Csvg width=\'60\' height=\'60\' viewBox=\'0 0 60 60\' xmlns=\'http://www.w3.org/2000/svg\'%3E%3Cg fill=\'none\' fill-rule=\'evenodd\'%3E%3Cg fill=\'%23ffffff\' fill-opacity=\'1\'%3E%3Cpath d=\'M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z\'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E');"></div>
    </div>
    
    <div class="flex flex-col lg:flex-row w-full max-w-7xl mx-auto shadow-2xl rounded-3xl overflow-hidden bg-white relative z-10 my-auto">
        <!-- Left Panel -->
        <div class="hidden lg:flex lg:flex-1 bg-gradient-to-br from-slate-900 to-slate-800 p-12 xl:p-16 flex-col justify-center items-center text-white relative overflow-hidden pattern-dots">
            <div class="relative z-10 text-center">
                <h1 class="luxury-heading text-4xl xl:text-5xl font-bold mb-5 drop-shadow-lg">
                    Join Our <span class="gold-text">Elite</span> Community
                </h1>
                <p class="text-lg xl:text-xl opacity-95 leading-relaxed mb-8">Create an account and unlock exclusive premium features</p>
                
                <div class="text-left mt-10 space-y-5">
                    <div class="flex items-center text-base xl:text-lg">
                        <i class="fas fa-shopping-bag text-2xl mr-4 bg-white/20 p-3 rounded-xl"></i>
                        <span>Shop from premium collections</span>
                    </div>
                    <div class="flex items-center text-base xl:text-lg">
                        <i class="fas fa-truck text-2xl mr-4 bg-white/20 p-3 rounded-xl"></i>
                        <span>Fast & reliable delivery</span>
                    </div>
                    <div class="flex items-center text-base xl:text-lg">
                        <i class="fas fa-shield-alt text-2xl mr-4 bg-white/20 p-3 rounded-xl"></i>
                        <span>Secure checkout process</span>
                    </div>
                    <div class="flex items-center text-base xl:text-lg">
                        <i class="fas fa-gift text-2xl mr-4 bg-white/20 p-3 rounded-xl"></i>
                        <span>Exclusive member discounts</span>
                    </div>
                </div>
            </div>
        </div>
        
        <!-- Right Panel - Form -->
        <div class="flex-1 p-8 sm:p-12 lg:p-10 xl:p-12 bg-white flex items-center justify-center overflow-y-auto">
            <div class="w-full max-w-xl">
                <div class="text-center mb-6">
                    <h2 class="luxury-heading text-3xl lg:text-4xl font-bold mb-2" style="color: var(--luxury-navy);">Create Account</h2>
                    <p class="text-gray-600 text-sm">Fill in your details to join our <span class="gold-text font-semibold">elite community</span></p>
                </div>
                
                <form id="register-form" class="space-y-4">
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        <div>
                            <label for="name" class="block text-sm font-semibold mb-1" style="color: var(--luxury-navy);">Full Name</label>
                            <input type="text" id="name" name="name" placeholder="Enter your full name" required
                                class="w-full px-4 py-2.5 border-2 rounded-lg text-sm transition-all duration-300 bg-gray-50 focus:outline-none focus:bg-white focus:ring-4 border-slate-700 focus:border-amber-600 focus:ring-amber-100">
                        </div>
                        <div>
                            <label for="email" class="block text-sm font-semibold mb-1" style="color: var(--luxury-navy);">Email Address</label>
                            <input type="email" id="email" name="email" placeholder="you@example.com" required
                                class="w-full px-4 py-2.5 border-2 rounded-lg text-sm transition-all duration-300 bg-gray-50 focus:outline-none focus:bg-white focus:ring-4 border-slate-700 focus:border-amber-600 focus:ring-amber-100">
                        </div>
                    </div>
                    
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        <div>
                            <label for="password" class="block text-sm font-semibold mb-1" style="color: var(--luxury-navy);">Password (min 6 chars)</label>
                            <input type="password" id="password" name="password" placeholder="Create password" required minlength="6"
                                class="w-full px-4 py-2.5 border-2 rounded-lg text-sm transition-all duration-300 bg-gray-50 focus:outline-none focus:bg-white focus:ring-4 border-slate-700 focus:border-amber-600 focus:ring-amber-100">
                        </div>
                        <div>
                            <label for="phone" class="block text-sm font-semibold mb-1" style="color: var(--luxury-navy);">Phone Number</label>
                            <input type="tel" id="phone" name="phone" placeholder="+1 (555) 000-0000" required
                                class="w-full px-4 py-2.5 border-2 rounded-lg text-sm transition-all duration-300 bg-gray-50 focus:outline-none focus:bg-white focus:ring-4 border-slate-700 focus:border-amber-600 focus:ring-amber-100">
                        </div>
                    </div>
                    
                    <div>
                        <label for="street" class="block text-sm font-semibold mb-1" style="color: var(--luxury-navy);">Street Address</label>
                        <input type="text" id="street" name="street" placeholder="123 Main Street"
                            class="w-full px-4 py-2.5 border-2 rounded-lg text-sm transition-all duration-300 bg-gray-50 focus:outline-none focus:bg-white focus:ring-4 border-slate-700 focus:border-amber-600 focus:ring-amber-100">
                    </div>
                    
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        <div>
                            <label for="apartment" class="block text-sm font-semibold mb-1" style="color: var(--luxury-navy);">Apartment/Suite</label>
                            <input type="text" id="apartment" name="apartment" placeholder="Apt 4B"
                                class="w-full px-4 py-2.5 border-2 rounded-lg text-sm transition-all duration-300 bg-gray-50 focus:outline-none focus:bg-white focus:ring-4 border-slate-700 focus:border-amber-600 focus:ring-amber-100">
                        </div>
                        <div>
                            <label for="zip" class="block text-sm font-semibold mb-1" style="color: var(--luxury-navy);">ZIP Code</label>
                            <input type="text" id="zip" name="zip" placeholder="10001"
                                class="w-full px-4 py-2.5 border-2 rounded-lg text-sm transition-all duration-300 bg-gray-50 focus:outline-none focus:bg-white focus:ring-4 border-slate-700 focus:border-amber-600 focus:ring-amber-100">
                        </div>
                    </div>
                    
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        <div>
                            <label for="city" class="block text-sm font-semibold mb-1" style="color: var(--luxury-navy);">City</label>
                            <input type="text" id="city" name="city" placeholder="New York"
                                class="w-full px-4 py-2.5 border-2 rounded-lg text-sm transition-all duration-300 bg-gray-50 focus:outline-none focus:bg-white focus:ring-4 border-slate-700 focus:border-amber-600 focus:ring-amber-100">
                        </div>
                        <div>
                            <label for="country" class="block text-sm font-semibold mb-1" style="color: var(--luxury-navy);">Country</label>
                            <input type="text" id="country" name="country" placeholder="United States"
                                class="w-full px-4 py-2.5 border-2 rounded-lg text-sm transition-all duration-300 bg-gray-50 focus:outline-none focus:bg-white focus:ring-4 border-slate-700 focus:border-amber-600 focus:ring-amber-100">
                        </div>
                    </div>
                    
                    <div class="flex items-center pt-2">
                        <input type="checkbox" id="terms" required class="w-4 h-4 mr-2 cursor-pointer accent-amber-600">
                        <label for="terms" class="text-sm text-gray-600 cursor-pointer">
                            I agree to the <a href="/terms" target="_blank" class="gold-text font-semibold hover:underline">Terms and Conditions</a>
                        </label>
                    </div>
                    
                    <!-- Admin registration option removed for security: users cannot self-register as admin -->
                    
                    <button type="submit" class="w-full py-3 text-white rounded-lg text-base font-semibold cursor-pointer transition-all duration-300 shadow-lg hover:-translate-y-0.5 hover:shadow-xl" style="background: linear-gradient(135deg, var(--luxury-navy) 0%, var(--luxury-charcoal) 100%);">
                        <i class="fas fa-user-plus mr-2"></i>Create Account
                    </button>
                </form>
                
                <div class="flex items-center my-5">
                    <div class="flex-1 border-t border-gray-200"></div>
                    <span class="px-3 text-sm text-gray-500">or</span>
                    <div class="flex-1 border-t border-gray-200"></div>
                </div>
                
                <div class="text-center text-sm text-gray-600">
                    <p>Already have an account? <a href="/login" class="gold-text font-semibold hover:underline">Sign in here</a></p>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
console.log('Register page script loaded');
console.log('showToast function available:', typeof showToast);
console.log('axios available:', typeof axios);

document.getElementById('register-form').addEventListener('submit', async function(e) {
    e.preventDefault();
    console.log('Register form submitted');
    
    const formData = new FormData(this);
    const registerData = {
        name: formData.get('name'),
        email: formData.get('email'),
        password: formData.get('password'),
        phone: formData.get('phone'),
        street: formData.get('street'),
        apartment: formData.get('apartment'),
        zip: formData.get('zip'),
        city: formData.get('city'),
        country: formData.get('country'),
        // Do not allow users to self-register as admin. Server enforces isAdmin = false for public registration.
        // isAdmin field intentionally omitted.
    };
    
    console.log('Register data:', registerData);
    
    try {
        console.log('Sending register request to /api/v1/users/register');
        const response = await axios.post('/api/v1/users/register', registerData);
        console.log('Register response:', response.data);
        
        if (response.data.requiresVerification) {
            // Redirect to OTP verification page
            const email = response.data.email || registerData.email;
            
            alert('📧 Verification code sent to your email! Please check your inbox.');
            
            window.location.href = `/verify-email?email=${encodeURIComponent(email)}`;
        } else {
            // Fallback
            alert('Registration successful! Please login.');
            setTimeout(() => {
                window.location.href = '/login';
            }, 2000);
        }
    } catch (error) {
        console.error('Registration error:', error);
        console.error('Error response:', error.response?.data);
        const message = error.response?.data?.message || 'Registration failed. Please try again.';
        
        if (typeof showToast === 'function') {
            showToast(message, 'error');
        } else {
            console.log('showToast not available, using alert for error');
            alert('Registration failed: ' + message);
        }
    }
});
</script>

<script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
</body>
</html>
