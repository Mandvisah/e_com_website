<script>
document.addEventListener('DOMContentLoaded', function() {
    loadCategories();
    loadFeaturedProducts();
});

async function loadCategories() {
    try {
        const response = await axios.get('/api/v1/categories');
        const categories = response.data;
        const container = document.getElementById('categories-container');
        
        container.innerHTML = categories.map((category, index) => `
            <div class="luxury-card group cursor-pointer" onclick="window.location.href='/category/${category._id}'" style="animation-delay: ${index * 100}ms;">
                <div class="relative bg-white rounded-2xl shadow-lg hover:shadow-2xl overflow-hidden h-full">
                    <div class="absolute inset-0 bg-gradient-to-br from-yellow-600/5 to-yellow-500/5 opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
                    
                    <div class="relative p-8 flex flex-col items-center text-center">
                        <div class="w-20 h-20 bg-gradient-to-br from-yellow-600 to-yellow-500 rounded-2xl flex items-center justify-center mb-6 group-hover:scale-110 transition-transform duration-300">
                            <i class="fas fa-tag text-3xl text-slate-900"></i>
                        </div>
                        
                        <h3 class="text-2xl font-bold text-slate-900 mb-2 luxury-heading">${category.name}</h3>
                        <p class="text-slate-600">${category.color || 'Explore this collection'}</p>
                        
                        <div class="mt-4 text-yellow-600 font-semibold flex items-center gap-2 opacity-0 group-hover:opacity-100 transition-opacity duration-300">
                            <span>Shop Now</span>
                            <i class="fas fa-arrow-right group-hover:translate-x-1 transition-transform"></i>
                        </div>
                    </div>
                </div>
            </div>
        `).join('');
    } catch (error) {
        console.error('Error loading categories:', error);
        document.getElementById('categories-container').innerHTML = `
            <div class="col-span-full text-center py-12">
                <p class="text-slate-600">Unable to load categories. Please try again later.</p>
            </div>
        `;
    }
}

async function loadFeaturedProducts() {
    try {
        const response = await axios.get('/api/v1/products?featured=true');
        const products = response.data;
        const container = document.getElementById('featured-products');
        
        if (products.length === 0) {
            const allProductsResponse = await axios.get('/api/v1/products');
            const allProducts = allProductsResponse.data.slice(0, 6);
            displayProducts(allProducts, container);
        } else {
            displayProducts(products, container);
        }
    } catch (error) {
        console.error('Error loading featured products:', error);
        document.getElementById('featured-products').innerHTML = `
            <div class="col-span-full text-center py-12">
                <p class="text-slate-600">Unable to load products. Please try again later.</p>
            </div>
        `;
    }
}

function displayProducts(products, container) {
    container.innerHTML = products.map((product, index) => `
        <div class="luxury-card" style="animation-delay: ${index * 100}ms;">
            <div class="bg-white rounded-2xl shadow-lg hover:shadow-2xl overflow-hidden h-full flex flex-col group">
                <!-- Product Image -->
                <div class="relative overflow-hidden aspect-square">
                    <img src="${product.image || 'https://images.unsplash.com/photo-1505740420928-5e560c06d30e?auto=format&fit=crop&w=600&q=80'}" 
                         class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500" 
                         alt="${product.name}">
                    
                    <div class="absolute top-4 right-4">
                        <button onclick="event.stopPropagation(); addToWishlist('${product._id}')" 
                                class="w-10 h-10 bg-white/90 backdrop-blur-sm rounded-full flex items-center justify-center hover:bg-white transition-all duration-300 shadow-lg">
                            <i class="far fa-heart text-slate-700"></i>
                        </button>
                    </div>
                    
                    ${product.featured ? '<div class="absolute top-4 left-4 px-3 py-1 bg-gradient-to-r from-yellow-600 to-yellow-500 text-slate-900 text-xs font-bold rounded-full">FEATURED</div>' : ''}
                </div>
                
                <!-- Product Info -->
                <div class="p-6 flex-1 flex flex-col">
                    <h3 class="text-xl font-bold text-slate-900 mb-2 luxury-heading line-clamp-1">${product.name}</h3>
                    <p class="text-slate-600 text-sm mb-4 line-clamp-2 flex-1">${product.description || 'Premium quality product'}</p>
                    
                    <div class="flex items-center justify-between mt-auto pt-4 border-t border-slate-100">
                        <div>
                            <span class="text-2xl font-bold text-slate-900">$${product.price}</span>
                        </div>
                        <button onclick="addToCart('${product._id}')" 
                                class="px-6 py-3 bg-gradient-to-r from-yellow-600 to-yellow-500 text-slate-900 font-semibold rounded-xl hover:shadow-lg hover:scale-105 transition-all duration-300 flex items-center gap-2">
                            <i class="fas fa-shopping-cart"></i>
                            <span class="hidden sm:inline">Add to Cart</span>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    `).join('');
}

// Wishlist functionality (optional - can be implemented later)
function addToWishlist(productId) {
    console.log('Add to wishlist:', productId);
    // Implement wishlist functionality
}
</script>

