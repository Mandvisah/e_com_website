<script>
document.addEventListener('DOMContentLoaded', function() {
    loadDashboardStats();
});

async function loadDashboardStats() {
    try {
        // Load products count
        const productsResponse = await axios.get('/api/v1/products');
        document.getElementById('total-products').textContent = productsResponse.data.length;
        
        // Load categories count
        const categoriesResponse = await axios.get('/api/v1/categories');
        document.getElementById('total-categories').textContent = categoriesResponse.data.length;
        
        // Load users count (if you have a count endpoint)
        try {
            const usersResponse = await axios.get('/api/v1/users/get/count', {
                headers: {
                    'Authorization': `Bearer ${localStorage.getItem('userToken')}`
                }
            });
            document.getElementById('total-users').textContent = usersResponse.data.userCount || 0;
        } catch (error) {
            document.getElementById('total-users').textContent = 'N/A';
        }
        
        // Load orders count
        try {
            const ordersResponse = await axios.get('/api/v1/orders', {
                headers: {
                    'Authorization': `Bearer ${localStorage.getItem('userToken')}`
                }
            });
            document.getElementById('total-orders').textContent = ordersResponse.data.length || 0;
        } catch (error) {
            document.getElementById('total-orders').textContent = 'N/A';
        }
        
    } catch (error) {
        console.error('Error loading dashboard stats:', error);
    }
}
</script>
