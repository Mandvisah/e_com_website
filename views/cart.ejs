<script>
let cart = JSON.parse(localStorage.getItem('cart')) || [];

document.addEventListener('DOMContentLoaded', function() {
    console.log('Cart page DOMContentLoaded');
    
    // Load cart first
    loadCart();
    
    // Update navigation and cart after main.js loads
    setTimeout(() => {
        console.log('Cart page - checking for main.js functions');
        
        if (typeof updateNavigation === 'function') {
            updateNavigation();
            console.log('Updated navigation on cart page');
        } else {
            console.log('updateNavigation not available on cart page');
        }
        
        if (typeof updateCartCount === 'function') {
            updateCartCount();
            console.log('Updated cart count on cart page');
        }
    }, 100);
});

// Also update when page becomes visible (for navigation between pages)
document.addEventListener('visibilitychange', function() {
    if (!document.hidden && typeof updateNavigation === 'function') {
        setTimeout(() => {
            updateNavigation();
        }, 50);
    }
});

// Force update navigation when page gains focus
window.addEventListener('focus', function() {
    if (typeof updateNavigation === 'function') {
        setTimeout(() => {
            updateNavigation();
        }, 50);
    }
});

// Backup: ensure functions are available when window fully loads
window.addEventListener('load', function() {
    console.log('Cart page window loaded - ensuring navigation is updated');
    
    if (typeof updateNavigation === 'function') {
        updateNavigation();
    }
});

async function loadCart() {
    if (cart.length === 0) {
        showEmptyCart();
        return;
    }
    
    try {
        const cartItems = [];
        for (const item of cart) {
            const response = await axios.get(`/api/v1/products/${item.productId}`);
            cartItems.push({
                ...response.data,
                quantity: item.quantity
            });
        }
        
        displayCart(cartItems);
    } catch (error) {
        console.error('Error loading cart:', error);
    }
}

function displayCart(cartItems) {
    const container = document.getElementById('cart-container');
    const subtotal = cartItems.reduce((sum, item) => sum + (item.price * item.quantity), 0);
    const shipping = subtotal > 50 ? 0 : 10;
    const tax = subtotal * 0.08; // 8% tax
    const total = subtotal + shipping + tax;
    
    // Update cart count badge
    document.getElementById('cart-items-count').innerHTML = `<i class="fas fa-box mr-2 text-amber-400"></i>${cartItems.length} Item${cartItems.length !== 1 ? 's' : ''}`;
    document.getElementById('cart-total-badge').innerHTML = `<i class="fas fa-dollar-sign mr-2 text-amber-400"></i>$${total.toFixed(2)} Total`;
    
    // Display cart items
    container.innerHTML = cartItems.map((item, index) => `
        <div class="cart-item border-b border-slate-200 p-6 hover:bg-slate-50 transition-all duration-300 animate-slideIn" data-product-id="${item._id}" style="animation-delay: ${index * 0.1}s">
            <div class="grid grid-cols-1 md:grid-cols-6 gap-6 items-center">
                <div class="md:col-span-1 flex justify-center md:justify-start">
                    <div class="relative group">
                        <img src="${item.image || 'https://via.placeholder.com/120x120?text=Product'}" 
                             class="w-24 h-24 object-cover rounded-xl shadow-md group-hover:shadow-xl transition-all duration-300 group-hover:scale-105" 
                             alt="${item.name}">
                        <div class="absolute inset-0 bg-black/0 group-hover:bg-black/10 rounded-xl transition-all duration-300"></div>
                    </div>
                </div>
                <div class="md:col-span-2">
                    <h5 class="text-lg font-bold text-slate-900 mb-2" style="font-family: 'Playfair Display', serif;">${item.name}</h5>
                    <p class="text-slate-600 text-sm mb-2 line-clamp-2">${item.description ? item.description.substring(0, 80) + '...' : 'No description available'}</p>
                    <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold bg-amber-100 text-amber-800">
                        <i class="fas fa-tag mr-1"></i>${item.brand || 'No brand'}
                    </span>
                </div>
                <div class="text-center">
                    <div class="text-2xl font-bold text-amber-600">$${item.price}</div>
                    <div class="text-xs text-slate-500">per item</div>
                </div>
                <div class="flex items-center justify-center">
                    <div class="flex items-center bg-slate-100 rounded-lg p-1">
                        <button class="w-8 h-8 flex items-center justify-center rounded-lg bg-white hover:bg-slate-900 hover:text-white transition-all duration-300 disabled:opacity-50 disabled:cursor-not-allowed" onclick="updateQuantity('${item._id}', ${item.quantity - 1})" ${item.quantity <= 1 ? 'disabled' : ''}>
                            <i class="fas fa-minus text-sm"></i>
                        </button>
                        <span class="mx-4 font-bold text-lg text-slate-900">${item.quantity}</span>
                        <button class="w-8 h-8 flex items-center justify-center rounded-lg bg-white hover:bg-slate-900 hover:text-white transition-all duration-300" onclick="updateQuantity('${item._id}', ${item.quantity + 1})">
                            <i class="fas fa-plus text-sm"></i>
                        </button>
                    </div>
                </div>
                <div class="flex items-center justify-between md:justify-around">
                    <div class="text-center">
                        <div class="text-xl font-bold text-green-600">$${(item.price * item.quantity).toFixed(2)}</div>
                        <div class="text-xs text-slate-500">total</div>
                    </div>
                    <button class="w-10 h-10 flex items-center justify-center rounded-lg border-2 border-red-200 text-red-500 hover:bg-red-500 hover:text-white hover:border-red-500 transition-all duration-300 ml-4" onclick="removeFromCart('${item._id}')" title="Remove item">
                        <i class="fas fa-trash"></i>
                    </button>
                </div>
            </div>
        </div>
    `).join('');
    
    // Update order summary
    updateOrderSummary(subtotal, shipping, tax, total);
    
    // Show/hide empty cart message
    document.getElementById('empty-cart').style.display = 'none';
}

<style>
@keyframes slideIn {
    from {
        opacity: 0;
        transform: translateX(-30px);
    }
    to {
        opacity: 1;
        transform: translateX(0);
    }
}
.animate-slideIn {
    animation: slideIn 0.5s ease-out forwards;
}
</style>

function updateOrderSummary(subtotal, shipping, tax, total) {
    document.getElementById('subtotal').textContent = `$${subtotal.toFixed(2)}`;
    document.getElementById('shipping').textContent = shipping === 0 ? 'Free' : `$${shipping.toFixed(2)}`;
    document.getElementById('tax').textContent = `$${tax.toFixed(2)}`;
    document.getElementById('total').textContent = `$${total.toFixed(2)}`;
    
    // Update checkout button state
    const checkoutBtn = document.getElementById('checkout-btn');
    if (total > 0) {
        checkoutBtn.disabled = false;
        checkoutBtn.innerHTML = `<i class="fas fa-credit-card mr-2"></i>Proceed to Checkout ($${total.toFixed(2)})`;
    } else {
        checkoutBtn.disabled = true;
        checkoutBtn.innerHTML = `<i class="fas fa-credit-card mr-2"></i>Proceed to Checkout`;
    }
}


function showEmptyCart() {
    document.getElementById('cart-container').innerHTML = '';
    document.getElementById('empty-cart').style.display = 'block';
    
    // Update badges for empty cart
    document.getElementById('cart-items-count').textContent = '0 Items';
    document.getElementById('cart-total-badge').textContent = '$0.00 Total';
    
    // Reset order summary
    updateOrderSummary(0, 0, 0, 0);
}

function updateQuantity(productId, newQuantity) {
    if (newQuantity <= 0) {
        removeFromCart(productId);
        return;
    }
    
    const cartItem = cart.find(item => item.productId === productId);
    if (cartItem) {
        cartItem.quantity = newQuantity;
        localStorage.setItem('cart', JSON.stringify(cart));
        loadCart();
        updateCartCount();
    }
}

function removeFromCart(productId) {
    cart = cart.filter(item => item.productId !== productId);
    localStorage.setItem('cart', JSON.stringify(cart));
    loadCart();
    updateCartCount();
    
    if (cart.length === 0) {
        showEmptyCart();
    }
}

function proceedToCheckout() {
    if (cart.length === 0) {
        alert('Your cart is empty!');
        return;
    }
    
    // Check if user is logged in (you can implement this based on your auth system)
    const isLoggedIn = localStorage.getItem('userToken'); // Adjust based on your auth
    
    if (!isLoggedIn) {
        if (confirm('You need to login to proceed to checkout. Would you like to login now?')) {
            window.location.href = '/login?redirect=checkout';
        }
    } else {
        window.location.href = '/checkout';
    }
}
</script>

<!-- Force navigation update script for cart page -->
<script>
// Force navigation update when page loads
window.addEventListener('load', function() {
    console.log('Cart page fully loaded - forcing navigation update');
    
    // Direct navigation update
    const isLoggedIn = !!localStorage.getItem('userToken');
    const user = JSON.parse(localStorage.getItem('user') || '{}');
    
    console.log('Cart page - Login status:', isLoggedIn, 'User:', user);
    
    if (isLoggedIn && user.name) {
        // Get elements
        const loginLink = document.getElementById('login-link');
        const registerLink = document.getElementById('register-link');
        const userDropdown = document.getElementById('user-dropdown');
        const userName = document.getElementById('user-name');
        
        // Hide login/register
        if (loginLink) {
            loginLink.style.display = 'none';
            console.log('Cart page - Hidden login link');
        }
        if (registerLink) {
            registerLink.style.display = 'none';
            console.log('Cart page - Hidden register link');
        }
        
        // Show user dropdown
        if (userDropdown) {
            userDropdown.style.display = 'block';
            console.log('Cart page - Showed user dropdown');
        }
        if (userName) {
            userName.textContent = user.name || user.email || 'User';
            console.log('Cart page - Set user name:', userName.textContent);
        }
    }
    
    // Also call main.js function if available
    if (typeof window.updateNavigation === 'function') {
        window.updateNavigation();
        console.log('Cart page - Called window.updateNavigation');
    }
});

// Also force update after a delay
setTimeout(function() {
    console.log('Cart page - Delayed navigation update');
    const isLoggedIn = !!localStorage.getItem('userToken');
    if (isLoggedIn && typeof window.updateNavigation === 'function') {
        window.updateNavigation();
    }
}, 1000);
</script>

