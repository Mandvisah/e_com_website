<!-- Hero Section for Cart Page -->
<div class="hero-section bg-gradient text-white py-5 mb-5">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-8">
                <nav aria-label="breadcrumb" class="mb-3">
                    <ol class="breadcrumb text-white-50 hero-breadcrumb">
                        <li class="breadcrumb-item"><a href="/" class="text-white">Home</a></li>
                        <li class="breadcrumb-item active text-white" aria-current="page">Shopping Cart</li>
                    </ol>
                </nav>
                <div class="hero-text-container">
                    <h1 class="display-4 fw-bold mb-3 floating-animation">
                        <i class="fas fa-shopping-cart me-3"></i>Shopping Cart
                    </h1>
                    <p class="lead mb-4">Review your selected items and proceed to checkout</p>
                    <div class="d-flex align-items-center gap-3">
                        <span id="cart-items-count" class="badge bg-light text-dark fs-6 px-3 py-2">0 Items</span>
                        <span id="cart-total-badge" class="badge bg-light text-dark fs-6 px-3 py-2">$0.00 Total</span>
                    </div>
                </div>
            </div>
            <div class="col-lg-4 text-center">
                <div class="hero-image-container">
                    <i class="fas fa-shopping-bag fa-6x floating-slow text-white-50" style="opacity: 0.3;"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="container my-5">
    <!-- Cart Content -->
    <div class="row">
        <div class="col-lg-8">
            <!-- Cart Items Section -->
            <div class="card shadow-sm border-0 rounded-lg mb-4">
                <div class="card-header bg-transparent border-0 p-4">
                    <h4 class="mb-0">
                        <i class="fas fa-list text-primary me-2"></i>
                        Cart Items
                    </h4>
                </div>
                <div class="card-body p-0">
                    <div id="cart-container">
                        <!-- Cart items will be loaded here -->
                    </div>
                </div>
            </div>
        </div>
        
        <div class="col-lg-4">
            <!-- Order Summary -->
            <div class="card shadow-sm border-0 rounded-lg sticky-top" style="top: 20px;">
                <div class="card-header bg-primary text-white p-4">
                    <h5 class="mb-0">
                        <i class="fas fa-calculator me-2"></i>
                        Order Summary
                    </h5>
                </div>
                <div class="card-body p-4">
                    <div id="order-summary">
                        <div class="d-flex justify-content-between mb-3">
                            <span>Subtotal:</span>
                            <span id="subtotal">$0.00</span>
                        </div>
                        <div class="d-flex justify-content-between mb-3">
                            <span>Shipping:</span>
                            <span id="shipping">Free</span>
                        </div>
                        <div class="d-flex justify-content-between mb-3">
                            <span>Tax:</span>
                            <span id="tax">$0.00</span>
                        </div>
                        <hr>
                        <div class="d-flex justify-content-between mb-4">
                            <strong>Total:</strong>
                            <strong id="total" class="text-primary fs-5">$0.00</strong>
                        </div>
                        <button class="btn btn-primary btn-lg w-100 mb-3" id="checkout-btn" onclick="proceedToCheckout()">
                            <i class="fas fa-credit-card me-2"></i>
                            Proceed to Checkout
                        </button>
                        <a href="/products" class="btn btn-outline-primary w-100">
                            <i class="fas fa-arrow-left me-2"></i>
                            Continue Shopping
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    <!-- Empty Cart Message -->
    <div id="empty-cart" class="text-center py-5" style="display: none;">
        <div class="row justify-content-center">
            <div class="col-md-6">
                <div class="card shadow-sm border-0 rounded-lg p-5">
                    <div class="mb-4">
                        <i class="fas fa-shopping-cart fa-6x text-muted mb-3"></i>
                    </div>
                    <h3 class="mb-3">Your Cart is Empty</h3>
                    <p class="text-muted mb-4">Looks like you haven't added any items to your cart yet. Start shopping to fill it up!</p>
                    <div class="d-flex gap-3 justify-content-center">
                        <a href="/products" class="btn btn-primary btn-lg">
                            <i class="fas fa-shopping-bag me-2"></i>
                            Shop Products
                        </a>
                        <a href="/categories" class="btn btn-outline-primary btn-lg">
                            <i class="fas fa-th-large me-2"></i>
                            Browse Categories
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
let cart = JSON.parse(localStorage.getItem('cart')) || [];

document.addEventListener('DOMContentLoaded', function() {
    console.log('Cart page DOMContentLoaded');
    
    // Load cart first
    loadCart();
    
    // Update navigation and cart after main.js loads
    setTimeout(() => {
        console.log('Cart page - checking for main.js functions');
        
        if (typeof updateNavigation === 'function') {
            updateNavigation();
            console.log('Updated navigation on cart page');
        } else {
            console.log('updateNavigation not available on cart page');
        }
        
        if (typeof updateCartCount === 'function') {
            updateCartCount();
            console.log('Updated cart count on cart page');
        }
    }, 100);
});

// Also update when page becomes visible (for navigation between pages)
document.addEventListener('visibilitychange', function() {
    if (!document.hidden && typeof updateNavigation === 'function') {
        setTimeout(() => {
            updateNavigation();
        }, 50);
    }
});

// Force update navigation when page gains focus
window.addEventListener('focus', function() {
    if (typeof updateNavigation === 'function') {
        setTimeout(() => {
            updateNavigation();
        }, 50);
    }
});

// Backup: ensure functions are available when window fully loads
window.addEventListener('load', function() {
    console.log('Cart page window loaded - ensuring navigation is updated');
    
    if (typeof updateNavigation === 'function') {
        updateNavigation();
    }
});

async function loadCart() {
    if (cart.length === 0) {
        showEmptyCart();
        return;
    }
    
    try {
        const cartItems = [];
        for (const item of cart) {
            const response = await axios.get(`/api/v1/products/${item.productId}`);
            cartItems.push({
                ...response.data,
                quantity: item.quantity
            });
        }
        
        displayCart(cartItems);
    } catch (error) {
        console.error('Error loading cart:', error);
    }
}

function displayCart(cartItems) {
    const container = document.getElementById('cart-container');
    const subtotal = cartItems.reduce((sum, item) => sum + (item.price * item.quantity), 0);
    const shipping = subtotal > 50 ? 0 : 10;
    const tax = subtotal * 0.08; // 8% tax
    const total = subtotal + shipping + tax;
    
    // Update cart count badge
    document.getElementById('cart-items-count').textContent = `${cartItems.length} Item${cartItems.length !== 1 ? 's' : ''}`;
    document.getElementById('cart-total-badge').textContent = `$${total.toFixed(2)} Total`;
    
    // Display cart items
    container.innerHTML = cartItems.map(item => `
        <div class="cart-item border-bottom p-4 hover-lift" data-product-id="${item._id}">
            <div class="row align-items-center">
                <div class="col-md-2">
                    <div class="product-image-container">
                        <img src="${item.image || 'https://via.placeholder.com/120x120?text=Product'}" 
                             class="img-fluid rounded shadow-sm" 
                             alt="${item.name}"
                             style="width: 100px; height: 100px; object-fit: cover;">
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="product-details">
                        <h5 class="mb-1 fw-semibold">${item.name}</h5>
                        <p class="text-muted small mb-2">${item.description ? item.description.substring(0, 80) + '...' : 'No description available'}</p>
                        <span class="badge bg-light text-dark">
                            <i class="fas fa-tag me-1"></i>${item.brand || 'No brand'}
                        </span>
                    </div>
                </div>
                <div class="col-md-2 text-center">
                    <div class="price-section">
                        <span class="h5 text-primary mb-0">$${item.price}</span>
                        <br>
                        <small class="text-muted">per item</small>
                    </div>
                </div>
                <div class="col-md-2">
                    <div class="quantity-controls d-flex align-items-center justify-content-center">
                        <button class="btn btn-outline-secondary btn-sm" onclick="updateQuantity('${item._id}', ${item.quantity - 1})" ${item.quantity <= 1 ? 'disabled' : ''}>
                            <i class="fas fa-minus"></i>
                        </button>
                        <span class="mx-3 fw-bold fs-5">${item.quantity}</span>
                        <button class="btn btn-outline-secondary btn-sm" onclick="updateQuantity('${item._id}', ${item.quantity + 1})">
                            <i class="fas fa-plus"></i>
                        </button>
                    </div>
                </div>
                <div class="col-md-1 text-center">
                    <div class="item-total">
                        <span class="fw-bold text-success">$${(item.price * item.quantity).toFixed(2)}</span>
                        <br>
                        <small class="text-muted">total</small>
                    </div>
                </div>
                <div class="col-md-1 text-center">
                    <button class="btn btn-outline-danger btn-sm" onclick="removeFromCart('${item._id}')" title="Remove item">
                        <i class="fas fa-trash"></i>
                    </button>
                </div>
            </div>
        </div>
    `).join('');
    
    // Update order summary
    updateOrderSummary(subtotal, shipping, tax, total);
    
    // Show/hide empty cart message
    document.getElementById('empty-cart').style.display = 'none';
}

function updateOrderSummary(subtotal, shipping, tax, total) {
    document.getElementById('subtotal').textContent = `$${subtotal.toFixed(2)}`;
    document.getElementById('shipping').textContent = shipping === 0 ? 'Free' : `$${shipping.toFixed(2)}`;
    document.getElementById('tax').textContent = `$${tax.toFixed(2)}`;
    document.getElementById('total').textContent = `$${total.toFixed(2)}`;
    
    // Update checkout button state
    const checkoutBtn = document.getElementById('checkout-btn');
    if (total > 0) {
        checkoutBtn.disabled = false;
        checkoutBtn.innerHTML = `<i class="fas fa-credit-card me-2"></i>Proceed to Checkout ($${total.toFixed(2)})`;
    } else {
        checkoutBtn.disabled = true;
        checkoutBtn.innerHTML = `<i class="fas fa-credit-card me-2"></i>Proceed to Checkout`;
    }
}


function showEmptyCart() {
    document.getElementById('cart-container').innerHTML = '';
    document.getElementById('empty-cart').style.display = 'block';
    
    // Update badges for empty cart
    document.getElementById('cart-items-count').textContent = '0 Items';
    document.getElementById('cart-total-badge').textContent = '$0.00 Total';
    
    // Reset order summary
    updateOrderSummary(0, 0, 0, 0);
}

function updateQuantity(productId, newQuantity) {
    if (newQuantity <= 0) {
        removeFromCart(productId);
        return;
    }
    
    const cartItem = cart.find(item => item.productId === productId);
    if (cartItem) {
        cartItem.quantity = newQuantity;
        localStorage.setItem('cart', JSON.stringify(cart));
        loadCart();
        updateCartCount();
    }
}

function removeFromCart(productId) {
    cart = cart.filter(item => item.productId !== productId);
    localStorage.setItem('cart', JSON.stringify(cart));
    loadCart();
    updateCartCount();
    
    if (cart.length === 0) {
        showEmptyCart();
    }
}

function proceedToCheckout() {
    if (cart.length === 0) {
        alert('Your cart is empty!');
        return;
    }
    
    // Check if user is logged in (you can implement this based on your auth system)
    const isLoggedIn = localStorage.getItem('userToken'); // Adjust based on your auth
    
    if (!isLoggedIn) {
        if (confirm('You need to login to proceed to checkout. Would you like to login now?')) {
            window.location.href = '/login?redirect=checkout';
        }
    } else {
        window.location.href = '/checkout';
    }
}
</script>

<!-- Force navigation update script for cart page -->
<script>
// Force navigation update when page loads
window.addEventListener('load', function() {
    console.log('Cart page fully loaded - forcing navigation update');
    
    // Direct navigation update
    const isLoggedIn = !!localStorage.getItem('userToken');
    const user = JSON.parse(localStorage.getItem('user') || '{}');
    
    console.log('Cart page - Login status:', isLoggedIn, 'User:', user);
    
    if (isLoggedIn && user.name) {
        // Get elements
        const loginLink = document.getElementById('login-link');
        const registerLink = document.getElementById('register-link');
        const userDropdown = document.getElementById('user-dropdown');
        const userName = document.getElementById('user-name');
        
        // Hide login/register
        if (loginLink) {
            loginLink.style.display = 'none';
            console.log('Cart page - Hidden login link');
        }
        if (registerLink) {
            registerLink.style.display = 'none';
            console.log('Cart page - Hidden register link');
        }
        
        // Show user dropdown
        if (userDropdown) {
            userDropdown.style.display = 'block';
            console.log('Cart page - Showed user dropdown');
        }
        if (userName) {
            userName.textContent = user.name || user.email || 'User';
            console.log('Cart page - Set user name:', userName.textContent);
        }
    }
    
    // Also call main.js function if available
    if (typeof window.updateNavigation === 'function') {
        window.updateNavigation();
        console.log('Cart page - Called window.updateNavigation');
    }
});

// Also force update after a delay
setTimeout(function() {
    console.log('Cart page - Delayed navigation update');
    const isLoggedIn = !!localStorage.getItem('userToken');
    if (isLoggedIn && typeof window.updateNavigation === 'function') {
        window.updateNavigation();
    }
}, 1000);
</script>

