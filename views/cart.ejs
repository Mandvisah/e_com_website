<script>
// Debug: Check localStorage directly
console.log('=== CART PAGE DEBUG ===');
console.log('localStorage.getItem("cart"):', localStorage.getItem('cart'));

let cart = JSON.parse(localStorage.getItem('cart')) || [];

console.log('Parsed cart:', cart);
console.log('Cart is array:', Array.isArray(cart));
console.log('Cart length:', cart.length);

document.addEventListener('DOMContentLoaded', function() {
    console.log('Cart page DOMContentLoaded');
    console.log('Cart at DOMContentLoaded:', cart);
    
    // Load cart first
    loadCart();
    
    // Update navigation and cart after main.js loads
    setTimeout(() => {
        console.log('Cart page - checking for main.js functions');
        
        if (typeof updateNavigation === 'function') {
            updateNavigation();
            console.log('Updated navigation on cart page');
        } else {
            console.log('updateNavigation not available on cart page');
        }
        
        if (typeof updateCartCount === 'function') {
            updateCartCount();
            console.log('Updated cart count on cart page');
        }
    }, 100);
});

// Also update when page becomes visible (for navigation between pages)
document.addEventListener('visibilitychange', function() {
    if (!document.hidden && typeof updateNavigation === 'function') {
        setTimeout(() => {
            updateNavigation();
        }, 50);
    }
});

// Force update navigation when page gains focus
window.addEventListener('focus', function() {
    if (typeof updateNavigation === 'function') {
        setTimeout(() => {
            updateNavigation();
        }, 50);
    }
});

// Backup: ensure functions are available when window fully loads
window.addEventListener('load', function() {
    console.log('Cart page window loaded - ensuring navigation is updated');
    
    if (typeof updateNavigation === 'function') {
        updateNavigation();
    }
});

async function loadCart() {
    console.log('loadCart called, cart contents:', cart);
    console.log('Cart length:', cart.length);
    
    if (cart.length === 0) {
        console.log('Cart is empty, showing empty cart message');
        showEmptyCart();
        return;
    }
    
    // Hide empty cart message
    const emptyCartElement = document.getElementById('empty-cart');
    if (emptyCartElement) {
        emptyCartElement.style.display = 'none';
    }
    
    try {
        console.log('Loading cart products...');
        const cartItems = [];
        for (const item of cart) {
            console.log('Fetching product:', item.productId);
            const response = await axios.get(`/api/v1/products/${item.productId}`);
            console.log('Product fetched:', response.data);
            cartItems.push({
                ...response.data,
                quantity: item.quantity
            });
        }
        
        console.log('All cart items loaded:', cartItems);
        displayCart(cartItems);
    } catch (error) {
        console.error('Error loading cart:', error);
        console.error('Error details:', error.response?.data);
        // Show error message to user
        const container = document.getElementById('cart-container');
        if (container) {
            container.innerHTML = `
                <div class="luxury-card border-l-4 border-red-500 p-8 text-center">
                    <i class="fas fa-exclamation-triangle text-red-500 mb-4" style="font-size: 4rem;"></i>
                    <h4 class="text-2xl font-bold text-slate-800 mb-2">Error Loading Cart</h4>
                    <p class="text-slate-600 mb-6">Unable to load your cart items. Please try refreshing the page.</p>
                    <button class="luxury-btn-primary" onclick="location.reload()">
                        <i class="fas fa-sync-alt mr-2"></i>Refresh Page
                    </button>
                </div>
            `;
        }
    }
}

function displayCart(cartItems) {
    console.log('displayCart called with items:', cartItems);
    const container = document.getElementById('cart-container');
    
    if (!container) {
        console.error('Cart container not found!');
        return;
    }
    
    const subtotal = cartItems.reduce((sum, item) => sum + (item.price * item.quantity), 0);
    const shipping = subtotal > 50 ? 0 : 10;
    const tax = subtotal * 0.08; // 8% tax
    const total = subtotal + shipping + tax;
    
    console.log('Cart totals - Subtotal:', subtotal, 'Shipping:', shipping, 'Tax:', tax, 'Total:', total);
    
    // Update cart count badge
    const itemsCount = document.getElementById('cart-items-count');
    const totalBadge = document.getElementById('cart-total-badge');
    
    if (itemsCount) {
        itemsCount.innerHTML = `<i class="fas fa-box mr-2 text-amber-400"></i>${cartItems.length} Item${cartItems.length !== 1 ? 's' : ''}`;
    }
    if (totalBadge) {
        totalBadge.innerHTML = `<i class="fas fa-dollar-sign mr-2 text-amber-400"></i>$${total.toFixed(2)} Total`;
    }
    
    // Display cart items
    console.log('Rendering cart HTML...');
    container.innerHTML = cartItems.map((item, index) => `
        <div class="cart-item p-5 hover:bg-slate-50 transition-all duration-300 animate-slideIn" data-product-id="${item._id}" style="animation-delay: ${index * 0.1}s; border-bottom: 1px solid #e2e8f0;">
            <div class="flex flex-col md:flex-row gap-5 items-center">
                <div class="flex-shrink-0">
                    <img src="${item.image || 'https://via.placeholder.com/120x120?text=Product'}" 
                         class="w-24 h-24 object-cover rounded-lg shadow-sm border border-slate-200" 
                         alt="${item.name}">
                </div>
                <div class="flex-grow">
                    <h5 class="text-lg font-semibold text-slate-800 mb-1">${item.name}</h5>
                    <p class="text-slate-500 text-sm mb-2">${item.description ? item.description.substring(0, 80) + '...' : 'Quality product'}</p>
                    ${item.brand ? `<span class="inline-block px-2 py-1 text-xs bg-slate-100 text-slate-600 rounded">${item.brand}</span>` : ''}
                </div>
                <div class="flex flex-col md:flex-row items-center gap-4 md:gap-6">
                    <div class="text-center">
                        <div class="text-xl font-bold text-slate-800">$${item.price}</div>
                        <div class="text-xs text-slate-400">each</div>
                    </div>
                    <div class="flex items-center border border-slate-200 rounded-lg">
                        <button class="w-8 h-8 flex items-center justify-center hover:bg-slate-100 transition-colors disabled:opacity-30 disabled:cursor-not-allowed" onclick="updateQuantity('${item._id}', ${item.quantity - 1})" ${item.quantity <= 1 ? 'disabled' : ''}>
                            <i class="fas fa-minus text-xs text-slate-600"></i>
                        </button>
                        <span class="w-12 text-center font-semibold text-slate-800">${item.quantity}</span>
                        <button class="w-8 h-8 flex items-center justify-center hover:bg-slate-100 transition-colors" onclick="updateQuantity('${item._id}', ${item.quantity + 1})">
                            <i class="fas fa-plus text-xs text-slate-600"></i>
                        </button>
                    </div>
                    <div class="text-right">
                        <div class="text-lg font-bold text-slate-800">$${(item.price * item.quantity).toFixed(2)}</div>
                        <div class="text-xs text-slate-400">total</div>
                    </div>
                    <button class="w-9 h-9 flex items-center justify-center rounded-lg text-slate-400 hover:text-red-600 hover:bg-red-50 transition-colors" onclick="removeFromCart('${item._id}')" title="Remove">
                        <i class="fas fa-times"></i>
                    </button>
                </div>
            </div>
        </div>
    `).join('');
    
    // Update order summary
    updateOrderSummary(subtotal, shipping, tax, total);
    
    // Show/hide empty cart message
    document.getElementById('empty-cart').style.display = 'none';
}

function updateOrderSummary(subtotal, shipping, tax, total) {
    // Apply discount if promo code is active
    let discountAmount = 0;
    if (promoApplied && currentDiscount > 0) {
        discountAmount = subtotal * (currentDiscount / 100);
        document.getElementById('discount-row').style.display = 'flex';
        document.getElementById('discount').textContent = `-$${discountAmount.toFixed(2)}`;
    } else {
        document.getElementById('discount-row').style.display = 'none';
    }
    
    // Use selected shipping cost
    const selectedShipping = document.querySelector('input[name="shipping"]:checked');
    if (selectedShipping) {
        shipping = parseFloat(selectedShipping.value);
    }
    
    // Recalculate total with discount
    const finalSubtotal = subtotal - discountAmount;
    const finalTotal = finalSubtotal + shipping + tax;
    
    document.getElementById('subtotal').textContent = `$${subtotal.toFixed(2)}`;
    document.getElementById('shipping').textContent = shipping === 0 ? 'Free' : `$${shipping.toFixed(2)}`;
    document.getElementById('tax').textContent = `$${tax.toFixed(2)}`;
    document.getElementById('total').textContent = `$${finalTotal.toFixed(2)}`;
    
    // Update checkout button state
    const checkoutBtn = document.getElementById('checkout-btn');
    if (finalTotal > 0) {
        checkoutBtn.disabled = false;
        checkoutBtn.innerHTML = `<i class="fas fa-credit-card mr-2"></i>Proceed to Checkout ($${finalTotal.toFixed(2)})`;
    } else {
        checkoutBtn.disabled = true;
        checkoutBtn.innerHTML = `<i class="fas fa-credit-card mr-2"></i>Proceed to Checkout`;
    }
}


function showEmptyCart() {
    console.log('Showing empty cart');
    const cartContainer = document.getElementById('cart-container');
    const emptyCart = document.getElementById('empty-cart');
    
    if (cartContainer) {
        cartContainer.innerHTML = '';
    }
    
    if (emptyCart) {
        emptyCart.style.display = 'block';
    }
    
    // Update badges for empty cart
    const itemsCount = document.getElementById('cart-items-count');
    const totalBadge = document.getElementById('cart-total-badge');
    
    if (itemsCount) {
        itemsCount.innerHTML = '<i class="fas fa-box mr-2 text-amber-400"></i>0 Items';
    }
    if (totalBadge) {
        totalBadge.innerHTML = '<i class="fas fa-dollar-sign mr-2 text-amber-400"></i>$0.00 Total';
    }
    
    // Reset order summary
    updateOrderSummary(0, 0, 0, 0);
}

function updateQuantity(productId, newQuantity) {
    if (newQuantity <= 0) {
        removeFromCart(productId);
        return;
    }
    
    const cartItem = cart.find(item => item.productId === productId);
    if (cartItem) {
        cartItem.quantity = newQuantity;
        localStorage.setItem('cart', JSON.stringify(cart));
        loadCart();
        updateCartCount();
    }
}

function removeFromCart(productId) {
    cart = cart.filter(item => item.productId !== productId);
    localStorage.setItem('cart', JSON.stringify(cart));
    loadCart();
    updateCartCount();
    
    if (cart.length === 0) {
        showEmptyCart();
    }
}

// Global variables for pricing
let currentDiscount = 0;
let currentShippingCost = 0;
let promoApplied = false;

function updateShippingCost() {
    const selectedShipping = document.querySelector('input[name="shipping"]:checked');
    currentShippingCost = parseFloat(selectedShipping.value);
    loadCart(); // Reload to recalculate totals
}

function applyPromoCode() {
    const promoInput = document.getElementById('promo-code');
    const promoCode = promoInput.value.trim().toUpperCase();
    const promoMessage = document.getElementById('promo-message');
    
    // Promo codes (you can customize these)
    const promoCodes = {
        'SAVE10': 10,
        'SAVE20': 20,
        'WELCOME15': 15,
        'FIRST25': 25
    };
    
    if (promoCodes[promoCode]) {
        currentDiscount = promoCodes[promoCode];
        promoApplied = true;
        promoMessage.innerHTML = `<i class="fas fa-check-circle text-green-600"></i> <span class="text-green-600 font-semibold">${currentDiscount}% discount applied!</span>`;
        promoInput.disabled = true;
        loadCart(); // Reload to recalculate totals
    } else {
        promoMessage.innerHTML = `<i class="fas fa-times-circle text-red-600"></i> <span class="text-red-600">Invalid promo code</span>`;
        setTimeout(() => {
            promoMessage.innerHTML = '';
        }, 3000);
    }
}

function openCheckoutForm() {
    if (cart.length === 0) {
        alert('Your cart is empty!');
        return;
    }
    
    // Check if user is logged in
    const isLoggedIn = localStorage.getItem('userToken');
    const user = JSON.parse(localStorage.getItem('user') || '{}');
    
    if (!isLoggedIn) {
        if (confirm('You need to login to proceed to checkout. Would you like to login now?')) {
            window.location.href = '/login?redirect=/cart';
        }
        return;
    }
    
    // Pre-fill user information
    if (user.name) document.getElementById('checkout-name').value = user.name;
    if (user.email) document.getElementById('checkout-email').value = user.email;
    
    // Copy totals to modal
    document.getElementById('modal-subtotal').textContent = document.getElementById('subtotal').textContent;
    document.getElementById('modal-shipping').textContent = document.getElementById('shipping').textContent;
    document.getElementById('modal-tax').textContent = document.getElementById('tax').textContent;
    document.getElementById('modal-total').textContent = document.getElementById('total').textContent;
    
    if (promoApplied) {
        document.getElementById('modal-discount-row').style.display = 'flex';
        document.getElementById('modal-discount').textContent = document.getElementById('discount').textContent;
    }
    
    // Show modal
    document.getElementById('checkout-modal').style.display = 'flex';
    document.body.style.overflow = 'hidden';
}

function closeCheckoutForm() {
    document.getElementById('checkout-modal').style.display = 'none';
    document.body.style.overflow = 'auto';
}

// Handle checkout form submission
document.addEventListener('DOMContentLoaded', function() {
    const checkoutForm = document.getElementById('checkout-form');
    if (checkoutForm) {
        checkoutForm.addEventListener('submit', async function(e) {
            e.preventDefault();
            
            console.log('=== ORDER SUBMISSION DEBUG ===');
            
            // Get user from localStorage
            const user = JSON.parse(localStorage.getItem('user') || '{}');
            const userId = user._id || user.id;
            
            console.log('User:', user);
            console.log('User ID:', userId);
            console.log('Cart:', cart);
            
            if (!userId) {
                alert('Please login to place an order.');
                window.location.href = '/login?redirect=/cart';
                return;
            }
            
            if (!cart || cart.length === 0) {
                alert('Your cart is empty!');
                return;
            }
            
            // Check payment method
            const paymentMethodElement = document.querySelector('input[name="payment-method"]:checked');
            if (!paymentMethodElement) {
                alert('Please select a payment method');
                return;
            }
            
            // Prepare order items in backend format
            const orderItems = cart.map(item => ({
                product: item.productId,
                quantity: item.quantity
            }));
            
            console.log('Order items:', orderItems);
            
            // Validate all required fields
            const address = document.getElementById('checkout-address').value.trim();
            const city = document.getElementById('checkout-city').value.trim();
            const zip = document.getElementById('checkout-zip').value.trim();
            const country = document.getElementById('checkout-country').value.trim();
            const phone = document.getElementById('checkout-phone').value.trim();
            
            if (!address || !city || !zip || !country || !phone) {
                alert('Please fill in all required fields:\n- Address\n- City\n- ZIP Code\n- Country\n- Phone');
                return;
            }
            
            // Prepare form data matching backend API requirements
            const formData = {
                user: userId,
                orderItems: orderItems,
                shippingAddress1: address,
                shippingAddress2: '',
                city: city,
                zip: zip,
                country: country,
                phone: phone,
                status: 'Pending'
            };
            
            console.log('=== FINAL FORM DATA ===');
            console.log('Form data being sent:', JSON.stringify(formData, null, 2));
            console.log('User ID:', formData.user);
            console.log('Order Items count:', formData.orderItems.length);
            console.log('Address:', formData.shippingAddress1);
            console.log('City:', formData.city);
            console.log('ZIP:', formData.zip);
            console.log('Country:', formData.country);
            console.log('Phone:', formData.phone);
            
            try {
                // Show loading state
                const submitBtn = e.target.querySelector('button[type="submit"]');
                submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin mr-2"></i>Processing...';
                submitBtn.disabled = true;
                
                // Send order to backend
                console.log('Sending POST request to /api/v1/orders...');
                const response = await axios.post('/api/v1/orders', formData, {
                    headers: {
                        'Authorization': `Bearer ${localStorage.getItem('userToken')}`
                    }
                });
                
                console.log('=== ORDER SUCCESS ===');
                console.log('Response status:', response.status);
                console.log('Response data:', response.data);
                
                if (response.data && response.data._id) {
                    // Clear cart
                    localStorage.removeItem('cart');
                    cart = [];
                    
                    // Update cart count
                    if (typeof updateCartCount === 'function') {
                        updateCartCount();
                    }
                    
                    // Close modal
                    closeCheckoutForm();
                    
                    // Show success message
                    if (typeof showToast === 'function') {
                        showToast('Order placed successfully!', 'success');
                    } else {
                        alert('Order placed successfully! You will receive a confirmation email shortly.');
                    }
                    
                    // Redirect to orders page
                    setTimeout(() => {
                        window.location.href = '/orders';
                    }, 1500);
                }
            } catch (error) {
                console.error('=== ORDER ERROR DETAILS ===');
                console.error('Full error:', error);
                console.error('Error message:', error.message);
                console.error('Error response:', error.response);
                console.error('Error response data:', error.response?.data);
                console.error('Error response status:', error.response?.status);
                console.error('Error response headers:', error.response?.headers);
                
                let errorMsg = 'Failed to place order.\n\n';
                
                if (error.response?.data?.message) {
                    errorMsg += 'Error: ' + error.response.data.message;
                } else if (error.response?.status === 401) {
                    errorMsg += 'Error: Authentication failed. Please login again.';
                } else if (error.response?.status === 400) {
                    errorMsg += 'Error: Invalid request. Please check:\n';
                    errorMsg += '- All required fields are filled\n';
                    errorMsg += '- Cart has items\n';
                    errorMsg += '- Payment method is selected';
                } else if (error.response?.status === 500) {
                    errorMsg += 'Error: Server error. Please try again or contact support.';
                } else if (error.message) {
                    errorMsg += 'Error: ' + error.message;
                } else {
                    errorMsg += 'Unknown error. Please check the console for details.';
                }
                
                // Show detailed alert
                alert(errorMsg + '\n\nCheck browser console (F12) for more details.');
                
                // Reset button
                const submitBtn = e.target.querySelector('button[type="submit"]');
                submitBtn.innerHTML = '<i class="fas fa-check-circle mr-2"></i>Place Order';
                submitBtn.disabled = false;
            }
        });
    }
});

function proceedToCheckout() {
    openCheckoutForm();
}
</script>

