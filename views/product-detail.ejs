<div class="container my-5">
    <div class="row">
        <div class="col-12">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="/">Home</a></li>
                    <li class="breadcrumb-item"><a href="/products">Products</a></li>
                    <li class="breadcrumb-item active" aria-current="page" id="product-breadcrumb">Product</li>
                </ol>
            </nav>
        </div>
    </div>
    
    <div id="product-container">
        <!-- Product details will be loaded here -->
    </div>
    
    <!-- Loading Spinner -->
    <div id="loading-spinner" class="text-center my-5">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const productId = window.location.pathname.split('/').pop();
    loadProduct(productId);
});

async function loadProduct(productId) {
    try {
        const response = await axios.get(`/api/v1/products/${productId}`);
        const product = response.data;
        displayProduct(product);
    } catch (error) {
        console.error('Error loading product:', error);
        document.getElementById('product-container').innerHTML = `
            <div class="alert alert-danger">
                <h4>Product Not Found</h4>
                <p>The product you're looking for doesn't exist or has been removed.</p>
                <a href="/products" class="btn btn-primary">Back to Products</a>
            </div>
        `;
    }
    document.getElementById('loading-spinner').style.display = 'none';
}

function displayProduct(product) {
    document.getElementById('product-breadcrumb').textContent = product.name;
    document.title = `${product.name} - E-Commerce Store`;
    
    const container = document.getElementById('product-container');
    container.innerHTML = `
        <div class="row">
            <div class="col-md-6">
                <img src="${product.image || 'https://via.placeholder.com/500x400?text=Product'}" 
                     class="img-fluid rounded product-detail-image" alt="${product.name}">
            </div>
            <div class="col-md-6">
                <h1 class="mb-3">${product.name}</h1>
                <div class="mb-3">
                    <span class="badge bg-secondary">${product.category ? product.category.name : 'Uncategorized'}</span>
                    ${product.isFeatured ? '<span class="badge bg-warning ms-2">Featured</span>' : ''}
                </div>
                <p class="lead text-primary h3">$${product.price}</p>
                <p class="text-muted">${product.description}</p>
                
                <div class="row mb-3">
                    <div class="col-sm-4">
                        <strong>Brand:</strong> ${product.brand || 'N/A'}
                    </div>
                    <div class="col-sm-4">
                        <strong>Stock:</strong> 
                        <span class="${product.countInStock > 0 ? 'text-success' : 'text-danger'}">
                            ${product.countInStock > 0 ? `${product.countInStock} available` : 'Out of stock'}
                        </span>
                    </div>
                    <div class="col-sm-4">
                        <strong>Rating:</strong> 
                        <span class="text-warning">
                            ${generateStars(product.rating || 0)}
                        </span>
                    </div>
                </div>
                
                <div class="row mb-4">
                    <div class="col-sm-6">
                        <label for="quantity" class="form-label">Quantity:</label>
                        <div class="input-group">
                            <button class="btn btn-outline-secondary" type="button" onclick="changeQuantity(-1)">-</button>
                            <input type="number" class="form-control text-center" id="quantity" value="1" min="1" max="${product.countInStock}">
                            <button class="btn btn-outline-secondary" type="button" onclick="changeQuantity(1)">+</button>
                        </div>
                    </div>
                </div>
                
                <div class="d-grid gap-2 d-md-flex">
                    <button class="btn btn-primary btn-lg me-md-2" onclick="addToCart('${product._id}')" ${product.countInStock === 0 ? 'disabled' : ''}>
                        <i class="fas fa-cart-plus"></i> Add to Cart
                    </button>
                    <button class="btn btn-success btn-lg" onclick="buyNow('${product._id}')" ${product.countInStock === 0 ? 'disabled' : ''}>
                        <i class="fas fa-bolt"></i> Buy Now
                    </button>
                </div>
                
                ${product.countInStock === 0 ? '<div class="alert alert-warning mt-3">This product is currently out of stock.</div>' : ''}
            </div>
        </div>
        
        <!-- Product Details Tabs -->
        <div class="row mt-5">
            <div class="col-12">
                <ul class="nav nav-tabs" id="productTabs" role="tablist">
                    <li class="nav-item" role="presentation">
                        <button class="nav-link active" id="description-tab" data-bs-toggle="tab" data-bs-target="#description" type="button" role="tab">
                            Description
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" id="specifications-tab" data-bs-toggle="tab" data-bs-target="#specifications" type="button" role="tab">
                            Specifications
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" id="reviews-tab" data-bs-toggle="tab" data-bs-target="#reviews" type="button" role="tab">
                            Reviews
                        </button>
                    </li>
                </ul>
                <div class="tab-content" id="productTabsContent">
                    <div class="tab-pane fade show active" id="description" role="tabpanel">
                        <div class="p-4">
                            <h4>Product Description</h4>
                            <p>${product.richDescription || product.description}</p>
                        </div>
                    </div>
                    <div class="tab-pane fade" id="specifications" role="tabpanel">
                        <div class="p-4">
                            <h4>Specifications</h4>
                            <table class="table">
                                <tr><td><strong>Brand:</strong></td><td>${product.brand || 'N/A'}</td></tr>
                                <tr><td><strong>Category:</strong></td><td>${product.category ? product.category.name : 'N/A'}</td></tr>
                                <tr><td><strong>Stock Count:</strong></td><td>${product.countInStock}</td></tr>
                                <tr><td><strong>Featured:</strong></td><td>${product.isFeatured ? 'Yes' : 'No'}</td></tr>
                                <tr><td><strong>Date Added:</strong></td><td>${new Date(product.dateCreated).toLocaleDateString()}</td></tr>
                            </table>
                        </div>
                    </div>
                    <div class="tab-pane fade" id="reviews" role="tabpanel">
                        <div class="p-4">
                            <h4>Customer Reviews</h4>
                            <div class="alert alert-info">
                                Reviews feature coming soon! Current rating: ${generateStars(product.rating || 0)} (${product.numReviews || 0} reviews)
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    `;
}

function generateStars(rating) {
    const fullStars = Math.floor(rating);
    const halfStar = rating % 1 >= 0.5;
    const emptyStars = 5 - fullStars - (halfStar ? 1 : 0);
    
    let stars = '';
    for (let i = 0; i < fullStars; i++) {
        stars += '<i class="fas fa-star"></i>';
    }
    if (halfStar) {
        stars += '<i class="fas fa-star-half-alt"></i>';
    }
    for (let i = 0; i < emptyStars; i++) {
        stars += '<i class="far fa-star"></i>';
    }
    
    return `${stars} (${rating.toFixed(1)})`;
}

function changeQuantity(change) {
    const quantityInput = document.getElementById('quantity');
    const currentValue = parseInt(quantityInput.value);
    const newValue = currentValue + change;
    const maxValue = parseInt(quantityInput.max);
    
    if (newValue >= 1 && newValue <= maxValue) {
        quantityInput.value = newValue;
    }
}

function buyNow(productId) {
    const quantity = document.getElementById('quantity').value;
    // Add to cart first, then redirect to checkout
    addToCart(productId, quantity);
    setTimeout(() => {
        window.location.href = '/checkout';
    }, 500);
}
</script>
