<div class="container mx-auto px-4 py-8">
    <nav aria-label="breadcrumb" class="mb-8 animate-fade-in-up">
        <ol class="flex flex-wrap items-center gap-2 text-sm">
            <li><a href="/" class="text-amber-600 hover:text-amber-700 transition-colors"><i class="fas fa-home mr-1"></i>Home</a></li>
            <li class="text-slate-400">/</li>
            <li><a href="/products" class="text-amber-600 hover:text-amber-700 transition-colors">Products</a></li>
            <li class="text-slate-400">/</li>
            <li class="text-slate-600 font-semibold" id="product-breadcrumb">Product</li>
        </ol>
    </nav>
    
    <div id="product-container">
        <!-- Product details will be loaded here -->
    </div>
    
    <!-- Loading Spinner -->
    <div id="loading-spinner" class="text-center py-12">
        <div class="inline-block animate-spin rounded-full h-16 w-16 border-t-4 border-b-4 border-amber-500 mb-4"></div>
        <p class="text-slate-600 text-lg">Loading product details...</p>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const productId = window.location.pathname.split('/').pop();
    loadProduct(productId);
});

async function loadProduct(productId) {
    try {
        const response = await axios.get(`/api/v1/products/${productId}`);
        const product = response.data;
        displayProduct(product);
    } catch (error) {
        console.error('Error loading product:', error);
        document.getElementById('product-container').innerHTML = `
            <div class="luxury-card border-l-4 border-red-500 p-8 text-center animate-fade-in-up">
                <i class="fas fa-exclamation-triangle text-red-500 mb-4" style="font-size: 4rem;"></i>
                <h4 class="text-2xl font-bold text-slate-800 mb-2">Product Not Found</h4>
                <p class="text-slate-600 mb-6">The product you're looking for doesn't exist or has been removed.</p>
                <a href="/products" class="luxury-btn-primary inline-block"><i class="fas fa-arrow-left mr-2"></i>Back to Products</a>
            </div>
        `;
    }
    document.getElementById('loading-spinner').style.display = 'none';
}

function displayProduct(product) {
    document.getElementById('product-breadcrumb').textContent = product.name;
    document.title = `${product.name} - E-Commerce Store`;
    
    const container = document.getElementById('product-container');
    container.innerHTML = `
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 mb-12">
            <div class="animate-fade-in-up">
                <div class="luxury-card overflow-hidden group">
                    <img src="${product.image || 'https://via.placeholder.com/500x400?text=Product'}" 
                         class="w-full h-96 object-cover transition-transform duration-500 group-hover:scale-110" 
                         alt="${product.name}">
                </div>
            </div>
            <div class="animate-fade-in-up" style="animation-delay: 0.1s;">
                <h1 class="luxury-heading text-4xl md:text-5xl text-slate-900 mb-4">${product.name}</h1>
                <div class="flex gap-2 mb-4">
                    <span class="luxury-badge">${product.category ? product.category.name : 'Uncategorized'}</span>
                    ${product.isFeatured ? '<span class="bg-amber-500 text-white px-3 py-1 rounded-full text-sm font-semibold"><i class="fas fa-star mr-1"></i>Featured</span>' : ''}
                </div>
                <p class="text-5xl font-bold text-amber-600 mb-4">$${product.price}</p>
                <p class="text-slate-600 text-lg mb-6">${product.description}</p>
                
                <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-6">
                    <div class="bg-slate-50 p-4 rounded-lg">
                        <p class="text-sm text-slate-500 mb-1">Brand</p>
                        <p class="font-semibold text-slate-800">${product.brand || 'N/A'}</p>
                    </div>
                    <div class="bg-slate-50 p-4 rounded-lg">
                        <p class="text-sm text-slate-500 mb-1">Stock</p>
                        <p class="font-semibold ${product.countInStock > 0 ? 'text-green-600' : 'text-red-600'}">
                            ${product.countInStock > 0 ? `${product.countInStock} available` : 'Out of stock'}
                        </p>
                    </div>
                    <div class="bg-slate-50 p-4 rounded-lg">
                        <p class="text-sm text-slate-500 mb-1">Rating</p>
                        <p class="font-semibold text-amber-500">
                            ${generateStars(product.rating || 0)}
                        </p>
                    </div>
                </div>
                
                <div class="mb-6">
                    <label for="quantity" class="luxury-label">Quantity:</label>
                    <div class="flex items-center gap-3 max-w-xs">
                        <button class="luxury-btn-outline px-4 py-2" type="button" onclick="changeQuantity(-1)">
                            <i class="fas fa-minus"></i>
                        </button>
                        <input type="number" class="luxury-input text-center" id="quantity" value="1" min="1" max="${product.countInStock}">
                        <button class="luxury-btn-outline px-4 py-2" type="button" onclick="changeQuantity(1)">
                            <i class="fas fa-plus"></i>
                        </button>
                    </div>
                </div>
                
                <div class="flex flex-col sm:flex-row gap-3 mb-6">
                    <button class="luxury-btn-primary flex-1 py-3 text-lg" onclick="addToCart('${product._id}')" ${product.countInStock === 0 ? 'disabled' : ''}>
                        <i class="fas fa-cart-plus mr-2"></i> Add to Cart
                    </button>
                    <button class="luxury-btn-outline flex-1 py-3 text-lg border-2 border-green-600 text-green-600 hover:bg-green-600 hover:text-white" onclick="buyNow('${product._id}')" ${product.countInStock === 0 ? 'disabled' : ''}>
                        <i class="fas fa-bolt mr-2"></i> Buy Now
                    </button>
                </div>
                
                ${product.countInStock === 0 ? '<div class="bg-amber-50 border-l-4 border-amber-500 p-4 rounded"><p class="text-amber-800 mb-0"><i class="fas fa-exclamation-circle mr-2"></i>This product is currently out of stock.</p></div>' : ''}
            </div>
        </div>
        
        <!-- Product Details Tabs -->
        <div class="luxury-card animate-fade-in-up" style="animation-delay: 0.2s;">
            <div class="border-b border-slate-200">
                <div class="flex flex-wrap gap-2 p-2" role="tablist">
                    <button class="tab-button active px-6 py-3 font-semibold text-amber-600 border-b-2 border-amber-600 transition-all" 
                            onclick="showTab('description')" id="description-tab">
                        <i class="fas fa-file-alt mr-2"></i>Description
                    </button>
                    <button class="tab-button px-6 py-3 font-semibold text-slate-600 hover:text-amber-600 transition-all" 
                            onclick="showTab('specifications')" id="specifications-tab">
                        <i class="fas fa-list mr-2"></i>Specifications
                    </button>
                    <button class="tab-button px-6 py-3 font-semibold text-slate-600 hover:text-amber-600 transition-all" 
                            onclick="showTab('reviews')" id="reviews-tab">
                        <i class="fas fa-star mr-2"></i>Reviews
                    </button>
                </div>
            </div>
            <div class="p-6">
                <div class="tab-pane active" id="description">
                    <h4 class="luxury-heading text-2xl text-slate-900 mb-4">Product Description</h4>
                    <p class="text-slate-600 leading-relaxed">${product.richDescription || product.description}</p>
                </div>
                <div class="tab-pane hidden" id="specifications">
                    <h4 class="luxury-heading text-2xl text-slate-900 mb-4">Specifications</h4>
                    <div class="overflow-x-auto">
                        <table class="w-full">
                            <tbody class="divide-y divide-slate-200">
                                <tr class="hover:bg-slate-50"><td class="py-3 px-4 font-semibold text-slate-700">Brand:</td><td class="py-3 px-4 text-slate-600">${product.brand || 'N/A'}</td></tr>
                                <tr class="hover:bg-slate-50"><td class="py-3 px-4 font-semibold text-slate-700">Category:</td><td class="py-3 px-4 text-slate-600">${product.category ? product.category.name : 'N/A'}</td></tr>
                                <tr class="hover:bg-slate-50"><td class="py-3 px-4 font-semibold text-slate-700">Stock Count:</td><td class="py-3 px-4 text-slate-600">${product.countInStock}</td></tr>
                                <tr class="hover:bg-slate-50"><td class="py-3 px-4 font-semibold text-slate-700">Featured:</td><td class="py-3 px-4 text-slate-600">${product.isFeatured ? 'Yes' : 'No'}</td></tr>
                                <tr class="hover:bg-slate-50"><td class="py-3 px-4 font-semibold text-slate-700">Date Added:</td><td class="py-3 px-4 text-slate-600">${new Date(product.dateCreated).toLocaleDateString()}</td></tr>
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="tab-pane hidden" id="reviews">
                    <h4 class="luxury-heading text-2xl text-slate-900 mb-4">Customer Reviews</h4>
                    <div class="bg-blue-50 border-l-4 border-blue-500 p-6 rounded">
                        <p class="text-blue-800 mb-2"><i class="fas fa-info-circle mr-2"></i>Reviews feature coming soon!</p>
                        <p class="text-blue-700 mb-0">Current rating: <span class="text-amber-500">${generateStars(product.rating || 0)}</span> (${product.numReviews || 0} reviews)</p>
                    </div>
                </div>
            </div>
        </div>
    `;
}

function showTab(tabName) {
    // Hide all tab panes
    document.querySelectorAll('.tab-pane').forEach(pane => pane.classList.add('hidden'));
    // Remove active from all buttons
    document.querySelectorAll('.tab-button').forEach(btn => {
        btn.classList.remove('active', 'text-amber-600', 'border-b-2', 'border-amber-600');
        btn.classList.add('text-slate-600');
    });
    // Show selected tab
    document.getElementById(tabName).classList.remove('hidden');
    // Activate button
    const activeBtn = document.getElementById(tabName + '-tab');
    activeBtn.classList.remove('text-slate-600');
    activeBtn.classList.add('active', 'text-amber-600', 'border-b-2', 'border-amber-600');
}

function generateStars(rating) {
    const fullStars = Math.floor(rating);
    const halfStar = rating % 1 >= 0.5;
    const emptyStars = 5 - fullStars - (halfStar ? 1 : 0);
    
    let stars = '';
    for (let i = 0; i < fullStars; i++) {
        stars += '<i class="fas fa-star"></i>';
    }
    if (halfStar) {
        stars += '<i class="fas fa-star-half-alt"></i>';
    }
    for (let i = 0; i < emptyStars; i++) {
        stars += '<i class="far fa-star"></i>';
    }
    
    return `${stars} (${rating.toFixed(1)})`;
}

function changeQuantity(change) {
    const quantityInput = document.getElementById('quantity');
    const currentValue = parseInt(quantityInput.value);
    const newValue = currentValue + change;
    const maxValue = parseInt(quantityInput.max);
    
    if (newValue >= 1 && newValue <= maxValue) {
        quantityInput.value = newValue;
    }
}

function buyNow(productId) {
    const quantity = document.getElementById('quantity').value;
    // Add to cart first, then redirect to checkout
    addToCart(productId, quantity);
    setTimeout(() => {
        window.location.href = '/checkout';
    }, 500);
}
</script>
