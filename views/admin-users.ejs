async function resetUserPassword(userId) {
    if (!confirm('Are you sure you want to reset this user\'s password? They will need to contact support to get a new password.')) {
        return;
    }
    
    try {
        showToast('Resetting password...', 'info');
        
        // Generate a temporary password
        const tempPassword = Math.random().toString(36).slice(-8);
        
        await axios.put(`/api/v1/users/${userId}/reset-password`, {
            newPassword: tempPassword
        }, {
            headers: {
                'Authorization': `Bearer ${localStorage.getItem('userToken')}`,
                'Content-Type': 'application/json'
            }
        });
        
        showToast('Password reset successfully!', 'success');
        alert(`Password reset successfully! Temporary password: ${tempPassword}\nPlease share this with the user securely.`);
        
    } catch (error) {
        console.error('Error resetting password:', error);
        showToast('Error resetting user password', 'error');
    }
}

function showToast(message, type = 'info') {
    const toastContainer = document.getElementById('toastContainer') || createToastContainer();
    
    const toastEl = document.createElement('div');
    toastEl.className = 'toast align-items-center border-0 mb-2';
    toastEl.setAttribute('role', 'alert');
    toastEl.setAttribute('aria-live', 'assertive');
    toastEl.setAttribute('aria-atomic', 'true');
    
    const bgColor = type === 'success' ? 'bg-success' : type === 'error' ? 'bg-danger' : 'bg-info';
    toastEl.classList.add(bgColor, 'text-white');
    
    toastEl.innerHTML = `
        <div class="d-flex">
            <div class="toast-body">
                <i class="fas fa-${type === 'success' ? 'check-circle' : type === 'error' ? 'exclamation-circle' : 'info-circle'} me-2"></i>
                ${message}
            </div>
            <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
        </div>
    `;
    
    toastContainer.appendChild(toastEl);
    const toast = new bootstrap.Toast(toastEl, { delay: 3000 });
    toast.show();
    
    toastEl.addEventListener('hidden.bs.toast', () => {
        toastEl.remove();
    });
}

function createToastContainer() {
    const container = document.createElement('div');
    container.id = 'toastContainer';
    container.className = 'toast-container position-fixed top-0 end-0 p-3';
    container.style.zIndex = '9999';
    document.body.appendChild(container);
    return container;
}
