<div class="container my-5">
    <div class="row">
        <div class="col-12">
            <nav aria-label="breadcrumb" class="mb-4">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="/">Home</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Search Results</li>
                </ol>
            </nav>

            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h1 class="mb-2">Search Results</h1>
                    <p class="text-muted" id="search-info">Searching for: "<%= query %>"</p>
                </div>
                <div>
                    <span id="results-count" class="badge bg-primary fs-6">0 results</span>
                </div>
            </div>

            <!-- Search and Filter Options -->
            <div class="row mb-4">
                <div class="col-md-6">
                    <div class="input-group">
                        <input type="text" id="search-input" class="form-control" placeholder="Search products..." value="<%= query %>">
                        <button class="btn btn-primary" onclick="performSearch()">
                            <i class="fas fa-search"></i> Search
                        </button>
                    </div>
                </div>
                <div class="col-md-3">
                    <select id="category-filter" class="form-select" onchange="filterResults()">
                        <option value="">All Categories</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <select id="sort-select" class="form-select" onchange="sortResults()">
                        <option value="">Sort by</option>
                        <option value="name">Name A-Z</option>
                        <option value="-name">Name Z-A</option>
                        <option value="price">Price Low to High</option>
                        <option value="-price">Price High to Low</option>
                    </select>
                </div>
            </div>

            <!-- Search Results -->
            <div id="search-results" class="row">
                <!-- Results will be loaded here -->
            </div>

            <!-- Loading Spinner -->
            <div id="loading-spinner" class="text-center my-5" style="display: none;">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
                <p class="mt-3">Searching products...</p>
            </div>

            <!-- No Results -->
            <div id="no-results" class="text-center my-5" style="display: none;">
                <div class="alert alert-info">
                    <h4><i class="fas fa-search"></i> No Results Found</h4>
                    <p>We couldn't find any products matching your search criteria.</p>
                    <div class="mt-3">
                        <button class="btn btn-primary me-2" onclick="clearSearch()">
                            <i class="fas fa-redo"></i> Clear Search
                        </button>
                        <a href="/products" class="btn btn-outline-primary">
                            <i class="fas fa-box"></i> Browse All Products
                        </a>
                    </div>
                </div>
            </div>

            <!-- Search Suggestions -->
            <div id="search-suggestions" class="mt-4" style="display: none;">
                <h5>Suggested Searches:</h5>
                <div class="d-flex flex-wrap gap-2" id="suggestions-list">
                    <!-- Suggestions will be loaded here -->
                </div>
            </div>
        </div>
    </div>
</div>

<script>
const initialQuery = '<%= query %>';
let allResults = [];
let filteredResults = [];

document.addEventListener('DOMContentLoaded', function() {
    loadCategories();
    if (initialQuery) {
        performSearch(initialQuery);
    }
    
    // Handle enter key in search input
    document.getElementById('search-input').addEventListener('keypress', function(e) {
        if (e.key === 'Enter') {
            performSearch();
        }
    });
});

async function loadCategories() {
    try {
        const response = await axios.get('/api/v1/categories');
        const categories = response.data;
        const select = document.getElementById('category-filter');
        
        categories.forEach(category => {
            const option = document.createElement('option');
            option.value = category._id;
            option.textContent = category.name;
            select.appendChild(option);
        });
    } catch (error) {
        console.error('Error loading categories:', error);
    }
}

async function performSearch(query = null) {
    const searchQuery = query || document.getElementById('search-input').value.trim();
    
    if (!searchQuery) {
        alert('Please enter a search term');
        return;
    }
    
    showLoading(true);
    
    try {
        const response = await axios.get(`/api/v1/products?search=${encodeURIComponent(searchQuery)}`);
        allResults = response.data;
        filteredResults = [...allResults];
        
        updateSearchInfo(searchQuery);
        updateResultsCount();
        displayResults(filteredResults);
        
        if (allResults.length === 0) {
            showNoResults();
            loadSearchSuggestions(searchQuery);
        }
        
        // Update URL
        const newUrl = `/search?q=${encodeURIComponent(searchQuery)}`;
        window.history.pushState({}, '', newUrl);
        
    } catch (error) {
        console.error('Error performing search:', error);
        document.getElementById('search-results').innerHTML = `
            <div class="col-12">
                <div class="alert alert-danger">
                    <h4>Search Error</h4>
                    <p>Unable to perform search. Please try again later.</p>
                    <button class="btn btn-primary" onclick="performSearch('${searchQuery}')">Retry</button>
                </div>
            </div>
        `;
    }
    
    showLoading(false);
}

function displayResults(results) {
    const container = document.getElementById('search-results');
    
    if (results.length === 0) {
        showNoResults();
        return;
    }
    
    hideNoResults();
    
    container.innerHTML = results.map(product => `
        <div class="col-md-4 col-sm-6 mb-4">
            <div class="card product-card h-100">
                <img src="${product.image || 'https://via.placeholder.com/300x200?text=Product'}" 
                     class="card-img-top product-image" 
                     alt="${product.name}"
                     onerror="this.src='https://via.placeholder.com/300x200?text=Image+Not+Found'"
                     style="height: 200px; object-fit: cover;">
                <div class="card-body d-flex flex-column">
                    <h5 class="card-title">${highlightSearchTerm(product.name, document.getElementById('search-input').value)}</h5>
                    <p class="card-text text-muted flex-grow-1">${highlightSearchTerm(product.description || 'No description available', document.getElementById('search-input').value)}</p>
                    <div class="mt-auto">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <span class="h5 text-primary mb-0">$${parseFloat(product.price).toFixed(2)}</span>
                            <span class="text-muted small">
                                <i class="fas fa-box"></i> 
                                Stock: ${product.countInStock || 0}
                            </span>
                        </div>
                        <div class="d-grid gap-2">
                            <button class="btn btn-primary" onclick="addToCart('${product._id}')" 
                                    ${(product.countInStock || 0) === 0 ? 'disabled' : ''}>
                                <i class="fas fa-cart-plus"></i> 
                                ${(product.countInStock || 0) === 0 ? 'Out of Stock' : 'Add to Cart'}
                            </button>
                            <a href="/product/${product._id}" class="btn btn-outline-secondary btn-sm">
                                <i class="fas fa-eye"></i> View Details
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    `).join('');
}

function highlightSearchTerm(text, searchTerm) {
    if (!searchTerm || !text) return text;
    
    const regex = new RegExp(`(${searchTerm.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')})`, 'gi');
    return text.replace(regex, '<mark>$1</mark>');
}

function filterResults() {
    const categoryId = document.getElementById('category-filter').value;
    
    if (!categoryId) {
        filteredResults = [...allResults];
    } else {
        filteredResults = allResults.filter(product => product.category === categoryId);
    }
    
    updateResultsCount();
    displayResults(filteredResults);
}

function sortResults() {
    const sortBy = document.getElementById('sort-select').value;
    
    if (!sortBy) {
        filteredResults = [...filteredResults];
    } else {
        filteredResults.sort((a, b) => {
            switch (sortBy) {
                case 'name':
                    return a.name.localeCompare(b.name);
                case '-name':
                    return b.name.localeCompare(a.name);
                case 'price':
                    return parseFloat(a.price) - parseFloat(b.price);
                case '-price':
                    return parseFloat(b.price) - parseFloat(a.price);
                default:
                    return 0;
            }
        });
    }
    
    displayResults(filteredResults);
}

function clearSearch() {
    document.getElementById('search-input').value = '';
    document.getElementById('category-filter').value = '';
    document.getElementById('sort-select').value = '';
    allResults = [];
    filteredResults = [];
    document.getElementById('search-results').innerHTML = '';
    hideNoResults();
    document.getElementById('search-suggestions').style.display = 'none';
    updateSearchInfo('');
    updateResultsCount();
}

function updateSearchInfo(query) {
    document.getElementById('search-info').textContent = query ? `Searching for: "${query}"` : 'Enter a search term';
}

function updateResultsCount() {
    const count = filteredResults.length;
    document.getElementById('results-count').textContent = `${count} result${count !== 1 ? 's' : ''}`;
}

function showLoading(show) {
    const spinner = document.getElementById('loading-spinner');
    const results = document.getElementById('search-results');
    
    if (show) {
        spinner.style.display = 'block';
        results.innerHTML = '';
        hideNoResults();
    } else {
        spinner.style.display = 'none';
    }
}

function showNoResults() {
    document.getElementById('no-results').style.display = 'block';
}

function hideNoResults() {
    document.getElementById('no-results').style.display = 'none';
}

async function loadSearchSuggestions(query) {
    try {
        // This would typically come from a search suggestions API
        const suggestions = ['electronics', 'clothing', 'books', 'home', 'sports', 'beauty'];
        const container = document.getElementById('suggestions-list');
        
        container.innerHTML = suggestions.map(suggestion => 
            `<button class="btn btn-outline-secondary btn-sm" onclick="performSearch('${suggestion}')">${suggestion}</button>`
        ).join('');
        
        document.getElementById('search-suggestions').style.display = 'block';
        
    } catch (error) {
        console.error('Error loading suggestions:', error);
    }
}

// Add to cart function (if not already defined globally)
function addToCart(productId) {
    if (typeof window.ecommerceApp !== 'undefined' && window.ecommerceApp.addToCart) {
        window.ecommerceApp.addToCart(productId);
    } else {
        // Fallback implementation
        let cart = JSON.parse(localStorage.getItem('cart')) || [];
        const existingItem = cart.find(item => item.productId === productId);
        
        if (existingItem) {
            existingItem.quantity += 1;
        } else {
            cart.push({ productId: productId, quantity: 1 });
        }
        
        localStorage.setItem('cart', JSON.stringify(cart));
        
        // Update cart count if element exists
        const cartCountElement = document.getElementById('cart-count');
        if (cartCountElement) {
            const totalItems = cart.reduce((total, item) => total + item.quantity, 0);
            cartCountElement.textContent = totalItems;
        }
        
        // Show success message
        alert('Product added to cart!');
    }
}
</script>
