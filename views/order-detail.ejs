<!-- Custom Luxury Styles -->
<style>
    @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600;700;800&family=Inter:wght@300;400;500;600;700&display=swap');
    
    :root {
        --luxury-navy: #0f172a;
        --luxury-charcoal: #1e293b;
        --luxury-gold: #d4af37;
        --luxury-champagne: #f5e6d3;
        --luxury-pearl: #f8fafc;
    }
    
    body {
        font-family: 'Inter', sans-serif;
        background-color: #f8fafc;
    }
    
    .luxury-heading {
        font-family: 'Playfair Display', serif;
    }
    
    .luxury-card {
        background: white;
        border-radius: 16px;
        border: 1px solid rgba(15, 23, 42, 0.1);
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.05);
    }
    
    .gold-text {
        color: var(--luxury-gold);
    }
</style>

<!-- Hero Section -->
<section class="relative bg-gradient-to-br from-slate-900 via-slate-800 to-slate-900 text-white overflow-hidden">
    <div class="absolute inset-0 opacity-10">
        <div class="absolute inset-0" style="background-image: url('data:image/svg+xml,%3Csvg width=\'60\' height=\'60\' viewBox=\'0 0 60 60\' xmlns=\'http://www.w3.org/2000/svg\'%3E%3Cg fill=\'none\' fill-rule=\'evenodd\'%3E%3Cg fill=\'%23ffffff\' fill-opacity=\'1\'%3E%3Cpath d=\'M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z\'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E');"></div>
    </div>
    
    <div class="container mx-auto px-4 sm:px-6 lg:px-8 py-12 relative z-10">
        <!-- Breadcrumb -->
        <nav class="flex items-center space-x-2 text-sm mb-6">
            <a href="/" class="text-slate-400 hover:text-yellow-500 transition-colors">
                <i class="fas fa-home mr-1"></i>Home
            </a>
            <span class="text-slate-500">/</span>
            <a href="/orders" class="text-slate-400 hover:text-yellow-500 transition-colors">My Orders</a>
            <span class="text-slate-500">/</span>
            <span class="text-yellow-500 font-medium">Order Details</span>
        </nav>
        
        <!-- Hero Content -->
        <div class="max-w-3xl">
            <h1 class="luxury-heading text-4xl sm:text-5xl font-bold leading-tight mb-3">
                Order <span class="gold-text">Details</span>
            </h1>
            <p class="text-lg text-slate-300 leading-relaxed">
                Track your order status and view complete order information
            </p>
        </div>
    </div>
</section>

<!-- Order Details Content -->
<div class="container mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div id="order-details">
        <!-- Order details will be loaded here -->
    </div>

    <!-- Loading Spinner -->
    <div id="loading-spinner" class="text-center py-16">
        <div class="inline-block animate-spin rounded-full h-16 w-16 border-4 border-slate-300 border-t-yellow-600 mb-4"></div>
        <p class="text-slate-600 font-medium text-lg">Loading order details...</p>
    </div>
</div>

<script>
const orderId = '<%= orderId %>';

document.addEventListener('DOMContentLoaded', function() {
    checkAuthStatus();
    loadOrderDetails();
});

function checkAuthStatus() {
    const isLoggedIn = !!localStorage.getItem('userToken');
    if (!isLoggedIn) {
        alert('Please login to view order details');
        window.location.href = '/login?redirect=/order/' + orderId;
    }
}

async function loadOrderDetails() {
    try {
        const response = await axios.get(`/api/v1/orders/${orderId}`, {
            headers: {
                'Authorization': `Bearer ${localStorage.getItem('userToken')}`
            }
        });
        
        console.log('Order Details Response:', response.data);
        const order = response.data;
        displayOrderDetails(order);
        
    } catch (error) {
        console.error('Error loading order details:', error);
        document.getElementById('order-details').innerHTML = `
            <div class="luxury-card p-8 text-center">
                <div class="mb-6">
                    <i class="fas fa-exclamation-triangle text-6xl text-red-500 mb-4"></i>
                    <h4 class="luxury-heading text-2xl font-bold text-slate-900 mb-2">Error Loading Order</h4>
                    <p class="text-slate-600 mb-4">Unable to load order details. The order may not exist or you may not have permission to view it.</p>
                </div>
                <a href="/orders" class="inline-block px-6 py-3 bg-yellow-600 text-white font-semibold rounded-lg hover:bg-yellow-500 transition-all">
                    <i class="fas fa-arrow-left mr-2"></i>Back to Orders
                </a>
            </div>
        `;
    }
    
    document.getElementById('loading-spinner').style.display = 'none';
}

function displayOrderDetails(order) {
    const container = document.getElementById('order-details');
    
    console.log('Displaying order:', order);
    
    // Get order date
    const orderDate = order.dateOrdered || order.createdAt || new Date();
    const formattedDate = new Date(orderDate).toLocaleDateString('en-US', { 
        year: 'numeric', 
        month: 'long', 
        day: 'numeric',
        hour: '2-digit',
        minute: '2-digit'
    });
    
    // Get total price
    const totalPrice = order.totalPrice || 0;
    const shipping = 0;
    const tax = 0;
    const subtotal = totalPrice - shipping - tax;
    
    // Build order items HTML
    let itemsHtml = '';
    if (order.orderItems && order.orderItems.length > 0) {
        itemsHtml = order.orderItems.map(orderItem => {
            const product = orderItem.product;
            const quantity = orderItem.quantity;
            const productName = product?.name || 'Product';
            const productPrice = product?.price || 0;
            const productImage = product?.image || product?.images?.[0] || '';
            const productDescription = product?.description || '';
            const itemTotal = productPrice * quantity;
            
            return `
                <div class="flex flex-col sm:flex-row items-start sm:items-center gap-4 p-4 bg-slate-50 rounded-lg hover:bg-slate-100 transition-colors mb-4">
                    <div class="w-24 h-24 flex-shrink-0">
                        ${productImage ? `
                            <img src="${productImage}" alt="${productName}" class="w-full h-full object-cover rounded-lg">
                        ` : `
                            <div class="w-full h-full bg-slate-200 rounded-lg flex items-center justify-center">
                                <i class="fas fa-box text-slate-400 text-3xl"></i>
                            </div>
                        `}
                    </div>
                    <div class="flex-1 min-w-0">
                        <h6 class="text-lg font-bold text-slate-900 mb-1">${productName}</h6>
                        ${productDescription ? `<p class="text-sm text-slate-600 mb-2 line-clamp-2">${productDescription}</p>` : ''}
                        <p class="text-sm text-slate-500">Quantity: <span class="font-semibold text-slate-700">${quantity}</span></p>
                    </div>
                    <div class="text-right">
                        <p class="text-xl font-bold text-yellow-600">$${itemTotal.toFixed(2)}</p>
                        <p class="text-xs text-slate-500">$${productPrice.toFixed(2)} each</p>
                    </div>
                </div>
            `;
        }).join('');
    } else {
        itemsHtml = '<p class="text-slate-500 italic p-4 bg-slate-50 rounded-lg text-center">No items information available</p>';
    }
    
    container.innerHTML = `
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
            <div class="lg:col-span-2 space-y-6">
                <!-- Order Header Card -->
                <div class="luxury-card overflow-hidden">
                    <div class="bg-gradient-to-r from-slate-900 to-slate-800 text-white px-6 py-4">
                        <div class="flex flex-wrap justify-between items-center gap-4">
                            <div>
                                <h3 class="luxury-heading text-2xl font-bold mb-1">Order #${order._id.slice(-8).toUpperCase()}</h3>
                                <p class="text-slate-300 text-sm">
                                    <i class="far fa-calendar-alt mr-2"></i>
                                    Placed on ${formattedDate}
                                </p>
                            </div>
                            <div>
                                <span class="inline-flex items-center px-4 py-2 rounded-full font-semibold text-sm ${getStatusBadgeClass(order.status)}">
                                    ${getStatusIcon(order.status)}
                                    ${order.status ? order.status.charAt(0).toUpperCase() + order.status.slice(1) : 'Pending'}
                                </span>
                            </div>
                        </div>
                    </div>
                    
                    <div class="p-6">
                        <div class="grid md:grid-cols-2 gap-6">
                            <div>
                                <h6 class="font-bold text-slate-900 mb-4 flex items-center">
                                    <i class="fas fa-tasks text-yellow-600 mr-2"></i>
                                    Order Status
                                </h6>
                                <div class="space-y-3">
                                    ${generateOrderTimeline(order.status)}
                                </div>
                            </div>
                            <div>
                                <h6 class="font-bold text-slate-900 mb-4 flex items-center">
                                    <i class="fas fa-truck text-yellow-600 mr-2"></i>
                                    Delivery Information
                                </h6>
                                <div class="bg-slate-50 rounded-lg p-4 space-y-3">
                                    <div>
                                        <p class="text-sm text-slate-600 mb-1">Estimated Delivery</p>
                                        <p class="font-semibold text-slate-900">${getEstimatedDelivery(orderDate, order.status)}</p>
                                    </div>
                                    <div class="pt-3 border-t border-slate-200">
                                        <p class="text-sm text-slate-600 mb-1">Payment Method</p>
                                        <p class="font-semibold text-slate-900">
                                            <i class="fas ${order.paymentMethod === 'cod' ? 'fa-money-bill-wave' : 'fa-credit-card'} mr-2 text-yellow-600"></i>
                                            ${order.paymentMethod === 'cod' ? 'Cash on Delivery' : order.paymentMethod === 'card' ? 'Credit Card' : 'Not Specified'}
                                        </p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Order Items Card -->
                <div class="luxury-card overflow-hidden">
                    <div class="bg-slate-50 px-6 py-4 border-b border-slate-200">
                        <h5 class="text-xl font-bold text-slate-900 flex items-center">
                            <i class="fas fa-box-open text-yellow-600 mr-3"></i>
                            Order Items (${order.orderItems?.length || 0})
                        </h5>
                    </div>
                    <div class="p-6">
                        ${itemsHtml}
                    </div>
                </div>
            </div>

            <div class="lg:col-span-1 space-y-6">
                <!-- Order Summary Card -->
                <div class="luxury-card overflow-hidden sticky top-24">
                    <div class="bg-gradient-to-br from-yellow-50 to-amber-50 border-b-2 border-yellow-200 px-6 py-4">
                        <h5 class="text-xl font-bold text-slate-900 flex items-center">
                            <i class="fas fa-receipt text-yellow-600 mr-3"></i>
                            Order Summary
                        </h5>
                    </div>
                    <div class="p-6">
                        <div class="space-y-3 mb-4">
                            <div class="flex justify-between text-slate-700">
                                <span>Subtotal:</span>
                                <span class="font-semibold">$${subtotal.toFixed(2)}</span>
                            </div>
                            <div class="flex justify-between text-slate-700">
                                <span>Shipping:</span>
                                <span class="font-semibold text-green-600">Free</span>
                            </div>
                            <div class="flex justify-between text-slate-700">
                                <span>Tax:</span>
                                <span class="font-semibold">$${tax.toFixed(2)}</span>
                            </div>
                            <div class="border-t-2 border-slate-200 pt-3 flex justify-between items-center">
                                <strong class="text-lg text-slate-900">Total:</strong>
                                <strong class="luxury-heading text-2xl font-bold text-yellow-600">$${totalPrice.toFixed(2)}</strong>
                            </div>
                        </div>
                        
                        <div class="space-y-3">
                            ${order.status?.toLowerCase() === 'pending' ? `
                                <button onclick="cancelOrder('${order._id}')" class="w-full px-4 py-3 border-2 border-red-500 text-red-500 text-center font-semibold rounded-lg hover:bg-red-500 hover:text-white transition-all">
                                    <i class="fas fa-times mr-2"></i>Cancel Order
                                </button>
                            ` : ''}
                            
                            <a href="/orders" class="block w-full px-4 py-3 bg-slate-900 text-white text-center font-semibold rounded-lg hover:bg-slate-800 transition-all shadow-lg">
                                <i class="fas fa-arrow-left mr-2"></i>Back to Orders
                            </a>
                        </div>
                    </div>
                </div>

                <!-- Shipping Address Card -->
                <div class="luxury-card overflow-hidden">
                    <div class="bg-slate-50 px-6 py-4 border-b border-slate-200">
                        <h5 class="text-lg font-bold text-slate-900 flex items-center">
                            <i class="fas fa-map-marker-alt text-yellow-600 mr-3"></i>
                            Shipping Address
                        </h5>
                    </div>
                    <div class="p-6">
                        <div class="space-y-2 text-slate-700">
                            <p class="text-sm text-slate-600">${order.shippingAddress1 || 'N/A'}</p>
                            ${order.shippingAddress2 ? `<p class="text-sm text-slate-600">${order.shippingAddress2}</p>` : ''}
                            <p class="text-sm text-slate-600">${order.city || 'N/A'}, ${order.zip || 'N/A'}</p>
                            <p class="text-sm text-slate-600">${order.country || 'N/A'}</p>
                            <div class="pt-3 border-t border-slate-200 mt-3">
                                <p class="text-sm text-slate-600"><i class="fas fa-phone mr-2 text-yellow-600"></i>${order.phone || 'N/A'}</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    `;
}

function getStatusBadgeClass(status) {
    const statusLower = status?.toLowerCase() || 'pending';
    switch (statusLower) {
        case 'pending':
            return 'bg-amber-500 text-white';
        case 'processing':
            return 'bg-blue-500 text-white';
        case 'shipped':
            return 'bg-purple-500 text-white';
        case 'delivered':
            return 'bg-green-500 text-white';
        case 'cancelled':
            return 'bg-red-500 text-white';
        default:
            return 'bg-slate-500 text-white';
    }
}

function getStatusIcon(status) {
    const statusLower = status?.toLowerCase() || 'pending';
    switch (statusLower) {
        case 'pending':
            return '<i class="fas fa-clock mr-2"></i>';
        case 'processing':
            return '<i class="fas fa-cog fa-spin mr-2"></i>';
        case 'shipped':
            return '<i class="fas fa-shipping-fast mr-2"></i>';
        case 'delivered':
            return '<i class="fas fa-check-circle mr-2"></i>';
        case 'cancelled':
            return '<i class="fas fa-times-circle mr-2"></i>';
        default:
            return '<i class="fas fa-info-circle mr-2"></i>';
    }
}

function generateOrderTimeline(currentStatus) {
    const statusLower = currentStatus?.toLowerCase() || 'pending';
    const statuses = ['pending', 'processing', 'shipped', 'delivered'];
    const statusLabels = {
        'pending': 'Order Placed',
        'processing': 'Processing',
        'shipped': 'Shipped',
        'delivered': 'Delivered'
    };
    
    const statusIcons = {
        'pending': 'fa-shopping-cart',
        'processing': 'fa-box',
        'shipped': 'fa-truck',
        'delivered': 'fa-check-circle'
    };
    
    const currentIndex = statuses.indexOf(statusLower);
    
    return statuses.map((status, index) => {
        const isCompleted = index <= currentIndex;
        const isCurrent = index === currentIndex;
        
        return `
            <div class="flex items-start gap-3 ${index < statuses.length - 1 ? 'mb-4' : ''}">
                <div class="flex flex-col items-center">
                    <div class="w-10 h-10 rounded-full flex items-center justify-center ${isCompleted ? 'bg-green-500 text-white' : 'bg-slate-200 text-slate-400'}">
                        <i class="fas ${statusIcons[status]} ${isCurrent ? 'animate-pulse' : ''}"></i>
                    </div>
                    ${index < statuses.length - 1 ? `<div class="w-0.5 h-8 ${isCompleted ? 'bg-green-500' : 'bg-slate-200'} mt-2"></div>` : ''}
                </div>
                <div class="flex-1 ${index < statuses.length - 1 ? 'pb-4' : ''}">
                    <p class="font-semibold ${isCompleted ? 'text-slate-900' : 'text-slate-500'}">${statusLabels[status]}</p>
                    ${isCurrent ? '<p class="text-xs text-green-600 font-medium">Current Status</p>' : ''}
                </div>
            </div>
        `;
    }).join('');
}

function getEstimatedDelivery(orderDate, status) {
    const orderDateTime = new Date(orderDate);
    const deliveryDate = new Date(orderDateTime);
    
    if (status === 'delivered') {
        return 'Delivered';
    }
    
    deliveryDate.setDate(orderDateTime.getDate() + 7); // Add 7 days
    
    return deliveryDate.toLocaleDateString();
}

async function cancelOrder(orderId) {
    if (!confirm('Are you sure you want to cancel this order?')) {
        return;
    }
    
    try {
        await axios.put(`/api/v1/orders/${orderId}`, 
            { status: 'Cancelled' },
            {
                headers: {
                    'Authorization': `Bearer ${localStorage.getItem('userToken')}`,
                    'Content-Type': 'application/json'
                }
            }
        );
        
        alert('Order cancelled successfully');
        loadOrderDetails(); // Reload order details
        
    } catch (error) {
        console.error('Error cancelling order:', error);
        alert('Error cancelling order. Please try again.');
    }
}
</script>

<style>
    @keyframes pulse {
        0%, 100% {
            opacity: 1;
        }
        50% {
            opacity: .5;
        }
    }
    
    .animate-pulse {
        animation: pulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
    }
    
    .line-clamp-2 {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }
    
    html {
        scroll-behavior: smooth;
    }
    
    /* Custom scrollbar */
    ::-webkit-scrollbar {
        width: 10px;
    }
    
    ::-webkit-scrollbar-track {
        background: #f1f5f9;
    }
    
    ::-webkit-scrollbar-thumb {
        background: #cbd5e1;
        border-radius: 5px;
    }
    
    ::-webkit-scrollbar-thumb:hover {
        background: #94a3b8;
    }
</style>
