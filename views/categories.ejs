<!-- Luxury Hero Section -->
<div class="relative bg-gradient-to-br from-slate-900 via-slate-800 to-slate-900 py-20">
    <div class="absolute inset-0 pattern-grid opacity-10"></div>
    <div class="container mx-auto px-4 relative z-10">
        <div class="text-center">
            <h1 class="luxury-heading text-5xl md:text-6xl text-white mb-4 animate-fade-in-up">
                <i class="fas fa-th-large mr-4 gold-text"></i>Product Categories
            </h1>
            <p class="text-xl text-slate-300 mb-8 animate-fade-in-up" style="animation-delay: 0.1s;">
                Browse our curated collection of premium categories
            </p>
            <div class="flex flex-wrap justify-center gap-3 animate-fade-in-up" style="animation-delay: 0.2s;">
                <span class="luxury-badge">
                    <i class="fas fa-gem mr-2"></i>Premium Selection
                </span>
                <span class="luxury-badge">
                    <i class="fas fa-certificate mr-2"></i>Quality Assured
                </span>
                <span class="luxury-badge">
                    <i class="fas fa-star mr-2"></i>Top Rated
                </span>
            </div>
        </div>
    </div>
</div>

<div class="container mx-auto px-4 py-12">
    <div id="categories-container" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
        <!-- Categories will be loaded here -->
    </div>
    
    <!-- Loading Spinner -->
    <div id="loading-spinner" class="text-center py-12">
        <div class="inline-block animate-spin rounded-full h-16 w-16 border-t-4 border-b-4 border-amber-500 mb-4"></div>
        <p class="text-slate-600 text-lg">Loading categories...</p>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    console.log('Categories page DOMContentLoaded');
    
    // Load categories first
    loadCategories();
    
    // Update navigation after main.js loads
    setTimeout(() => {
        if (typeof updateNavigation === 'function') {
            updateNavigation();
            console.log('Updated navigation on categories page');
        }
        
        if (typeof updateCartCount === 'function') {
            updateCartCount();
            console.log('Updated cart count on categories page');
        }
    }, 100);
});

async function loadCategories() {
    try {
        const response = await axios.get('/api/v1/categories');
        const categories = response.data;
        displayCategories(categories);
    } catch (error) {
        console.error('Error loading categories:', error);
        document.getElementById('categories-container').innerHTML = `
            <div class="col-span-full">
                <div class="luxury-card border-l-4 border-red-500 p-8 text-center">
                    <i class="fas fa-exclamation-triangle text-red-500 mb-4" style="font-size: 4rem;"></i>
                    <h4 class="text-2xl font-bold text-slate-800 mb-2">Error Loading Categories</h4>
                    <p class="text-slate-600 mb-6">Please try again later.</p>
                    <button class="luxury-btn-primary" onclick="loadCategories()">
                        <i class="fas fa-sync-alt mr-2"></i>Try Again
                    </button>
                </div>
            </div>
        `;
    }
    document.getElementById('loading-spinner').style.display = 'none';
}

function displayCategories(categories) {
    const container = document.getElementById('categories-container');
    
    if (categories.length === 0) {
        container.innerHTML = `
            <div class="col-span-full">
                <div class="luxury-card bg-blue-50 border-l-4 border-blue-500 p-8 text-center">
                    <i class="fas fa-info-circle text-blue-500 mb-4" style="font-size: 4rem;"></i>
                    <h4 class="text-2xl font-bold text-slate-800 mb-2">No Categories Found</h4>
                    <p class="text-slate-600">Check back soon for new categories.</p>
                </div>
            </div>
        `;
        return;
    }
    
    container.innerHTML = categories.map((category, index) => `
        <div class="luxury-card group cursor-pointer transform transition-all duration-300 hover:shadow-2xl overflow-hidden animate-fade-in-up" 
             style="animation-delay: ${index * 0.1}s;"
             onclick="window.location.href='/category/${category._id}'">
            <div class="relative bg-gradient-to-br from-slate-900 to-slate-800 p-8 text-center overflow-hidden">
                <div class="absolute inset-0 pattern-grid opacity-5"></div>
                <div class="relative z-10 mb-4 transform transition-transform duration-300 group-hover:scale-110">
                    <i class="fas fa-tag text-6xl" style="color: ${category.color || '#d4af37'}"></i>
                </div>
                <div class="absolute top-0 right-0 w-32 h-32 bg-amber-500 rounded-full -mr-16 -mt-16 opacity-10 group-hover:opacity-20 transition-opacity"></div>
            </div>
            <div class="p-6 text-center bg-white">
                <h5 class="luxury-heading text-2xl text-slate-900 mb-3 group-hover:text-amber-600 transition-colors">${category.name}</h5>
                <p class="text-slate-600 text-sm mb-4 h-12">${category.icon || 'Explore our premium collection'}</p>
                <button class="luxury-btn-primary w-full py-3">
                    <i class="fas fa-arrow-right mr-2"></i>View Products
                </button>
            </div>
        </div>
    `).join('');
}
</script>

<!-- Force navigation update script for categories page -->
<script>
// Force navigation update when page loads
window.addEventListener('load', function() {
    console.log('Categories page fully loaded - forcing navigation update');
    
    // Direct navigation update
    const isLoggedIn = !!localStorage.getItem('userToken');
    const user = JSON.parse(localStorage.getItem('user') || '{}');
    
    if (isLoggedIn && user.name) {
        // Get elements
        const loginLink = document.getElementById('login-link');
        const registerLink = document.getElementById('register-link');
        const userDropdown = document.getElementById('user-dropdown');
        const userName = document.getElementById('user-name');
        
        // Hide login/register
        if (loginLink) loginLink.style.display = 'none';
        if (registerLink) registerLink.style.display = 'none';
        
        // Show user dropdown
        if (userDropdown) userDropdown.style.display = 'block';
        if (userName) userName.textContent = user.name || user.email || 'User';
    }
    
    // Also call main.js function if available
    if (typeof window.updateNavigation === 'function') {
        window.updateNavigation();
    }
});
</script>
