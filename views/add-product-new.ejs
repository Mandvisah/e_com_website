<%- include('layout', { title: 'Add Product', content: `
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600;700&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/styles/luxury-theme.css">
<style>
    body {
        font-family: 'Inter', sans-serif;
        background: linear-gradient(135deg, #0f172a 0%, #1e293b 50%, #334155 100%);
        min-height: 100vh;
    }

    /* Luxury Hero Section */
    .luxury-hero {
        background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
        padding: 4rem 0 3rem;
        margin-bottom: 3rem;
        position: relative;
        overflow: hidden;
    }

    .luxury-hero::before {
        content: '';
        position: absolute;
        top: 0;
        right: 0;
        width: 500px;
        height: 500px;
        background: radial-gradient(circle, rgba(212, 175, 55, 0.1) 0%, transparent 70%);
        border-radius: 50%;
    }

    .luxury-hero::after {
        content: '';
        position: absolute;
        bottom: -100px;
        left: -100px;
        width: 400px;
        height: 400px;
        background: radial-gradient(circle, rgba(212, 175, 55, 0.05) 0%, transparent 70%);
        border-radius: 50%;
    }

    .hero-content {
        position: relative;
        z-index: 1;
    }

    .hero-title {
        font-family: 'Playfair Display', serif;
        font-size: 3rem;
        font-weight: 700;
        background: linear-gradient(135deg, #ffffff 0%, #d4af37 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        margin-bottom: 0.5rem;
        animation: fadeInUp 0.8s ease;
    }

    .hero-subtitle {
        color: #cbd5e1;
        font-size: 1.1rem;
        margin-bottom: 2rem;
        animation: fadeInUp 0.8s ease 0.2s backwards;
    }

    /* Breadcrumb */
    .luxury-breadcrumb {
        background: rgba(255, 255, 255, 0.05);
        backdrop-filter: blur(10px);
        padding: 1rem 1.5rem;
        border-radius: 12px;
        border: 1px solid rgba(212, 175, 55, 0.2);
        display: inline-flex;
        align-items: center;
        gap: 0.75rem;
        animation: fadeInUp 0.8s ease 0.4s backwards;
    }

    .luxury-breadcrumb a {
        color: #d4af37;
        text-decoration: none;
        transition: all 0.3s ease;
        font-weight: 500;
    }

    .luxury-breadcrumb a:hover {
        color: #ffd700;
        transform: translateX(2px);
    }

    .luxury-breadcrumb span {
        color: #64748b;
    }

    .luxury-breadcrumb .active {
        color: #e2e8f0;
    }

    /* Main Card */
    .luxury-form-card {
        background: linear-gradient(135deg, #1e293b 0%, #334155 100%);
        border-radius: 20px;
        box-shadow: 0 25px 50px rgba(0, 0, 0, 0.5);
        overflow: hidden;
        border: 1px solid rgba(212, 175, 55, 0.2);
        margin-bottom: 3rem;
        animation: fadeInUp 0.8s ease 0.6s backwards;
    }

    .card-header-luxury {
        background: linear-gradient(to right, #0f172a, #1e293b, #0f172a);
        border-bottom: 3px solid #d4af37;
        padding: 2rem;
        position: relative;
        overflow: hidden;
    }

    .card-header-luxury::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: linear-gradient(45deg, transparent, rgba(212, 175, 55, 0.1), transparent);
        animation: shimmer 3s infinite;
    }

    @keyframes shimmer {
        0% { transform: translateX(-100%); }
        100% { transform: translateX(100%); }
    }

    .card-header-luxury h2 {
        font-family: 'Playfair Display', serif;
        font-size: 2rem;
        color: #ffffff;
        margin: 0;
        position: relative;
        z-index: 1;
        display: flex;
        align-items: center;
        gap: 1rem;
    }

    .header-icon {
        width: 50px;
        height: 50px;
        background: linear-gradient(135deg, #d4af37, #ffd700);
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #0f172a;
        font-size: 1.5rem;
        box-shadow: 0 5px 15px rgba(212, 175, 55, 0.3);
    }

    /* Form Styling */
    .card-body-luxury {
        padding: 3rem;
        background: linear-gradient(135deg, #1e293b 0%, #334155 100%);
    }

    .form-label-luxury {
        font-weight: 600;
        color: #e2e8f0;
        margin-bottom: 0.75rem;
        font-size: 0.95rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .required-star {
        color: #d4af37;
        font-size: 1.2rem;
    }

    .luxury-input,
    .luxury-select,
    .luxury-textarea {
        background: rgba(15, 23, 42, 0.5);
        border: 2px solid rgba(100, 116, 139, 0.3);
        border-radius: 12px;
        padding: 0.875rem 1.25rem;
        color: #ffffff;
        font-size: 1rem;
        transition: all 0.3s ease;
        width: 100%;
    }

    .luxury-input:focus,
    .luxury-select:focus,
    .luxury-textarea:focus {
        outline: none;
        border-color: #d4af37;
        background: rgba(15, 23, 42, 0.7);
        box-shadow: 0 0 0 3px rgba(212, 175, 55, 0.1);
    }

    .luxury-input::placeholder {
        color: #64748b;
    }

    .luxury-textarea {
        resize: vertical;
        min-height: 100px;
    }

    .input-group-luxury {
        display: flex;
        align-items: stretch;
    }

    .input-group-text-luxury {
        background: rgba(212, 175, 55, 0.2);
        border: 2px solid rgba(100, 116, 139, 0.3);
        border-right: none;
        border-radius: 12px 0 0 12px;
        color: #d4af37;
        font-weight: 600;
        padding: 0 1.25rem;
        display: flex;
        align-items: center;
    }

    .input-group-luxury .luxury-input {
        border-radius: 0 12px 12px 0;
    }

    .file-input-wrapper {
        position: relative;
    }

    .luxury-file-input {
        background: rgba(15, 23, 42, 0.5);
        border: 2px dashed rgba(212, 175, 55, 0.4);
        border-radius: 12px;
        padding: 2rem;
        text-align: center;
        cursor: pointer;
        transition: all 0.3s ease;
    }

    .luxury-file-input:hover {
        border-color: #d4af37;
        background: rgba(212, 175, 55, 0.05);
    }

    .luxury-file-input input[type="file"] {
        position: absolute;
        opacity: 0;
        width: 100%;
        height: 100%;
        top: 0;
        left: 0;
        cursor: pointer;
    }

    .file-input-content {
        color: #cbd5e1;
    }

    .file-input-content i {
        font-size: 3rem;
        color: #d4af37;
        margin-bottom: 1rem;
        display: block;
    }

    .file-input-label {
        color: #d4af37;
        font-weight: 600;
        font-size: 1.1rem;
        margin-bottom: 0.5rem;
    }

    .file-input-hint {
        color: #64748b;
        font-size: 0.85rem;
    }

    /* Checkbox */
    .luxury-checkbox {
        display: flex;
        align-items: center;
        gap: 1rem;
        padding: 1.5rem;
        background: rgba(15, 23, 42, 0.5);
        border: 2px solid rgba(100, 116, 139, 0.3);
        border-radius: 12px;
        cursor: pointer;
        transition: all 0.3s ease;
    }

    .luxury-checkbox:hover {
        border-color: rgba(212, 175, 55, 0.5);
        background: rgba(212, 175, 55, 0.05);
    }

    .luxury-checkbox input[type="checkbox"] {
        width: 24px;
        height: 24px;
        cursor: pointer;
        accent-color: #d4af37;
    }

    .luxury-checkbox label {
        color: #e2e8f0;
        font-weight: 500;
        font-size: 1rem;
        cursor: pointer;
        margin: 0;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .featured-badge {
        background: linear-gradient(135deg, #d4af37, #ffd700);
        color: #0f172a;
        padding: 0.25rem 0.75rem;
        border-radius: 6px;
        font-size: 0.75rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    /* Buttons */
    .btn-group-luxury {
        display: flex;
        justify-content: flex-end;
        gap: 1rem;
        margin-top: 3rem;
        padding-top: 2rem;
        border-top: 1px solid rgba(100, 116, 139, 0.2);
    }

    .luxury-btn {
        padding: 1rem 2.5rem;
        border-radius: 12px;
        font-weight: 600;
        font-size: 1rem;
        border: none;
        cursor: pointer;
        transition: all 0.3s ease;
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }

    .luxury-btn-primary {
        background: linear-gradient(135deg, #d4af37, #ffd700);
        color: #0f172a;
        box-shadow: 0 10px 25px rgba(212, 175, 55, 0.3);
    }

    .luxury-btn-primary:hover {
        transform: translateY(-2px);
        box-shadow: 0 15px 35px rgba(212, 175, 55, 0.4);
    }

    .luxury-btn-primary:active {
        transform: translateY(0);
    }

    .luxury-btn-secondary {
        background: rgba(100, 116, 139, 0.2);
        color: #e2e8f0;
        border: 2px solid rgba(100, 116, 139, 0.5);
    }

    .luxury-btn-secondary:hover {
        background: rgba(100, 116, 139, 0.3);
        border-color: rgba(100, 116, 139, 0.7);
    }

    /* Form Grid */
    .form-row {
        display: grid;
        gap: 1.5rem;
        margin-bottom: 1.5rem;
    }

    .form-row-2 {
        grid-template-columns: repeat(2, 1fr);
    }

    .form-row-3 {
        grid-template-columns: repeat(3, 1fr);
    }

    .form-group {
        display: flex;
        flex-direction: column;
    }

    /* Modal */
    .luxury-modal {
        background: linear-gradient(135deg, #1e293b 0%, #334155 100%);
        border-radius: 20px;
        border: 2px solid rgba(212, 175, 55, 0.3);
        color: #ffffff;
    }

    .luxury-modal .modal-header {
        border-bottom: 2px solid rgba(212, 175, 55, 0.3);
        padding: 1.5rem;
    }

    .luxury-modal .modal-title {
        font-family: 'Playfair Display', serif;
        color: #d4af37;
        font-size: 1.5rem;
    }

    .luxury-modal .btn-close {
        filter: invert(1);
    }

    .luxury-modal .modal-body {
        padding: 2rem;
    }

    /* Animations */
    @keyframes fadeInUp {
        from {
            opacity: 0;
            transform: translateY(30px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* Responsive */
    @media (max-width: 768px) {
        .hero-title {
            font-size: 2rem;
        }

        .form-row-2,
        .form-row-3 {
            grid-template-columns: 1fr;
        }

        .card-body-luxury {
            padding: 2rem 1.5rem;
        }

        .btn-group-luxury {
            flex-direction: column;
        }

        .luxury-btn {
            justify-content: center;
            width: 100%;
        }
    }
</style>

<!-- Luxury Hero Section -->
<div class="luxury-hero">
    <div class="container">
        <div class="hero-content">
            <div class="luxury-breadcrumb">
                <a href="/"><i class="fas fa-home"></i> Home</a>
                <span><i class="fas fa-chevron-right"></i></span>
                <a href="/admin"><i class="fas fa-shield-alt"></i> Admin</a>
                <span><i class="fas fa-chevron-right"></i></span>
                <span class="active">Add Product</span>
            </div>
        </div>
    </div>
</div>

<div class="container" style="margin-top: -2rem;">
    <div class="luxury-form-card">
        <div class="card-header-luxury">
            <h2>
                <div class="header-icon">
                    <i class="fas fa-plus-circle"></i>
                </div>
                Add New Product
            </h2>
        </div>
        
        <div class="card-body-luxury">
            <form id="add-product-form" enctype="multipart/form-data">
                <!-- Product Name & Brand -->
                <div class="form-row form-row-2">
                    <div class="form-group">
                        <label for="name" class="form-label-luxury">
                            <i class="fas fa-tag"></i>
                            Product Name
                            <span class="required-star">*</span>
                        </label>
                        <input type="text" class="luxury-input" id="name" name="name" placeholder="Enter product name" required>
                    </div>
                    <div class="form-group">
                        <label for="brand" class="form-label-luxury">
                            <i class="fas fa-copyright"></i>
                            Brand
                            <span class="required-star">*</span>
                        </label>
                        <input type="text" class="luxury-input" id="brand" name="brand" placeholder="Enter brand name" required>
                    </div>
                </div>

                <!-- Price, Category, Stock -->
                <div class="form-row form-row-3">
                    <div class="form-group">
                        <label for="price" class="form-label-luxury">
                            <i class="fas fa-dollar-sign"></i>
                            Price
                            <span class="required-star">*</span>
                        </label>
                        <div class="input-group-luxury">
                            <span class="input-group-text-luxury">$</span>
                            <input type="number" class="luxury-input" id="price" name="price" step="0.01" min="0" placeholder="0.00" required>
                        </div>
                    </div>
                    <div class="form-group">
                        <label for="category" class="form-label-luxury">
                            <i class="fas fa-folder-open"></i>
                            Category
                            <span class="required-star">*</span>
                        </label>
                        <select class="luxury-select" id="category" name="category" required>
                            <option value="">Select Category</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label for="countInStock" class="form-label-luxury">
                            <i class="fas fa-box"></i>
                            Stock Quantity
                            <span class="required-star">*</span>
                        </label>
                        <input type="number" class="luxury-input" id="countInStock" name="countInStock" min="0" placeholder="0" required>
                    </div>
                </div>

                <!-- Rating & Reviews -->
                <div class="form-row form-row-2">
                    <div class="form-group">
                        <label for="rating" class="form-label-luxury">
                            <i class="fas fa-star"></i>
                            Rating
                        </label>
                        <input type="number" class="luxury-input" id="rating" name="rating" step="0.1" min="0" max="5" value="0" placeholder="0.0">
                    </div>
                    <div class="form-group">
                        <label for="numReview" class="form-label-luxury">
                            <i class="fas fa-comments"></i>
                            Number of Reviews
                        </label>
                        <input type="number" class="luxury-input" id="numReview" name="numReview" min="0" value="0" placeholder="0">
                    </div>
                </div>

                <!-- Short Description -->
                <div class="form-row">
                    <div class="form-group">
                        <label for="description" class="form-label-luxury">
                            <i class="fas fa-align-left"></i>
                            Short Description
                            <span class="required-star">*</span>
                        </label>
                        <textarea class="luxury-textarea" id="description" name="description" rows="3" placeholder="Enter a brief description..." required></textarea>
                    </div>
                </div>

                <!-- Detailed Description -->
                <div class="form-row">
                    <div class="form-group">
                        <label for="richDescription" class="form-label-luxury">
                            <i class="fas fa-file-alt"></i>
                            Detailed Description
                        </label>
                        <textarea class="luxury-textarea" id="richDescription" name="richDescription" rows="5" placeholder="Enter detailed product information..."></textarea>
                    </div>
                </div>

                <!-- Product Image Upload -->
                <div class="form-row">
                    <div class="form-group">
                        <label class="form-label-luxury">
                            <i class="fas fa-image"></i>
                            Product Image
                            <span class="required-star">*</span>
                        </label>
                        <div class="luxury-file-input">
                            <input type="file" id="image" name="image" accept="image/*" required>
                            <div class="file-input-content">
                                <i class="fas fa-cloud-upload-alt"></i>
                                <div class="file-input-label">Click to Upload Image</div>
                                <div class="file-input-hint">Maximum file size: 5MB | JPG, PNG, GIF</div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Featured Product Checkbox -->
                <div class="form-row">
                    <div class="luxury-checkbox">
                        <input type="checkbox" id="isFeatured" name="isFeatured">
                        <label for="isFeatured">
                            <i class="fas fa-star"></i>
                            Featured Product
                            <span class="featured-badge">Premium</span>
                        </label>
                    </div>
                </div>

                <!-- Action Buttons -->
                <div class="btn-group-luxury">
                    <button type="button" class="luxury-btn luxury-btn-secondary" onclick="goBack()">
                        <i class="fas fa-times"></i>
                        Cancel
                    </button>
                    <button type="submit" class="luxury-btn luxury-btn-primary">
                        <i class="fas fa-check"></i>
                        Add Product
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Image Preview Modal -->
<div class="modal fade" id="imagePreviewModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content luxury-modal">
            <div class="modal-header">
                <h5 class="modal-title"><i class="fas fa-image me-2"></i>Image Preview</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body text-center">
                <img id="previewImage" src="" alt="Preview" class="img-fluid rounded" style="max-height: 400px;">
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
<script>
let categories = [];

// Load categories on page load
document.addEventListener('DOMContentLoaded', function() {
    loadCategories();
    setupImagePreview();
});

async function loadCategories() {
    try {
        const response = await axios.get('/api/v1/categories');
        categories = response.data;
        
        const categorySelect = document.getElementById('category');
        categorySelect.innerHTML = '<option value="">Select Category</option>';
        
        if (Array.isArray(categories)) {
            categories.forEach(category => {
                const option = document.createElement('option');
                option.value = category._id || category.id;
                option.textContent = category.name;
                categorySelect.appendChild(option);
            });
        }
    } catch (error) {
        console.error('Error loading categories:', error);
        const categorySelect = document.getElementById('category');
        categorySelect.innerHTML = '<option value="">Error loading categories</option>';
        showToast('Failed to load categories. Please check your connection.', 'error');
    }
}

function setupImagePreview() {
    const imageInput = document.getElementById('image');
    imageInput.addEventListener('change', function(e) {
        const file = e.target.files[0];
        if (file) {
            // Validate file size (5MB max)
            if (file.size > 5 * 1024 * 1024) {
                showToast('Image size must be less than 5MB', 'error');
                e.target.value = '';
                return;
            }
            
            // Show preview
            const reader = new FileReader();
            reader.onload = function(e) {
                document.getElementById('previewImage').src = e.target.result;
                const modal = new bootstrap.Modal(document.getElementById('imagePreviewModal'));
                modal.show();
            };
            reader.readAsDataURL(file);
        }
    });
}

document.getElementById('add-product-form').addEventListener('submit', async function(e) {
    e.preventDefault();
    
    // Check if user is logged in
    const token = localStorage.getItem('userToken');
    if (!token) {
        showToast('Please login to add products', 'error');
        window.location.href = '/login';
        return;
    }
    
    const formData = new FormData(this);
    
    // Convert checkbox to boolean
    formData.set('isFeatured', document.getElementById('isFeatured').checked);
    
    // Debug: Log form data
    console.log('Form data being sent:');
    for (let [key, value] of formData.entries()) {
        console.log(key, value);
    }
    
    try {
        showToast('Creating product...', 'info');
        
        const response = await axios.post('/api/v1/products', formData, {
            headers: {
                'Authorization': `Bearer ${token}`
            }
        });
        
        console.log('Product created:', response.data);
        showToast('Product created successfully!', 'success');
        
        // Reset form
        this.reset();
        
        // Redirect to products page after 2 seconds
        setTimeout(() => {
            window.location.href = '/admin/products';
        }, 2000);
        
    } catch (error) {
        console.error('Error creating product:', error);
        
        if (error.response) {
            console.log('Error response:', error.response.data);
            console.log('Error status:', error.response.status);
        }
        
        const message = error.response?.data?.message || 'Failed to create product. Please try again.';
        showToast(message, 'error');
        
        // If unauthorized, redirect to login
        if (error.response?.status === 401) {
            showToast('Please login again', 'error');
            localStorage.removeItem('userToken');
            setTimeout(() => {
                window.location.href = '/login';
            }, 2000);
        }
    }
});

function goBack() {
    window.history.back();
}
</script>
` }) %>
