<style>
    @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600;700;800&family=Inter:wght@300;400;500;600;700&display=swap');
    
    :root {
        --luxury-navy: #0f172a;
        --luxury-charcoal: #1e293b;
        --luxury-gold: #d4af37;
        --luxury-champagne: #f5e6d3;
        --luxury-pearl: #f8fafc;
    }
    
    body {
        font-family: 'Inter', sans-serif;
        background-color: #f8fafc;
        min-height: 100vh;
    }

    .luxury-heading {
        font-family: 'Playfair Display', serif;
    }

    .gold-text {
        color: var(--luxury-gold);
    }

    @keyframes fadeInUp {
        from {
            opacity: 0;
            transform: translateY(30px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @keyframes shimmer {
        0% { background-position: -1000px 0; }
        100% { background-position: 1000px 0; }
    }

    .animate-fade-in-up {
        animation: fadeInUp 0.8s ease-out forwards;
    }

    .luxury-card {
        background: white;
        border-radius: 16px;
        border: 1px solid rgba(15, 23, 42, 0.08);
        transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.05);
    }

    .luxury-card:hover {
        box-shadow: 0 20px 40px rgba(15, 23, 42, 0.12);
        border-color: var(--luxury-gold);
    }

    .filter-card {
        background: linear-gradient(135deg, var(--luxury-navy) 0%, var(--luxury-charcoal) 100%);
        border-radius: 16px;
        padding: 2rem;
        border: 1px solid rgba(212, 175, 55, 0.2);
        margin-bottom: 2rem;
    }

    .luxury-input {
        background: white;
        border: 2px solid #e2e8f0;
        border-radius: 12px;
        padding: 0.875rem 1.25rem;
        color: var(--luxury-navy);
        transition: all 0.3s ease;
    }

    .luxury-input:focus {
        outline: none;
        border-color: var(--luxury-gold);
        box-shadow: 0 0 0 3px rgba(212, 175, 55, 0.1);
    }

    .luxury-select {
        background: white;
        border: 2px solid #e2e8f0;
        border-radius: 12px;
        padding: 0.875rem 1.25rem;
        color: var(--luxury-navy);
        transition: all 0.3s ease;
    }

    .luxury-select:focus {
        outline: none;
        border-color: var(--luxury-gold);
        box-shadow: 0 0 0 3px rgba(212, 175, 55, 0.1);
    }

    .luxury-btn-primary {
        background: linear-gradient(135deg, var(--luxury-gold), #ffd700);
        color: var(--luxury-navy);
        padding: 0.875rem 2rem;
        border-radius: 12px;
        font-weight: 600;
        border: none;
        transition: all 0.3s ease;
        box-shadow: 0 4px 15px rgba(212, 175, 55, 0.3);
    }

    .luxury-btn-primary:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 25px rgba(212, 175, 55, 0.4);
        color: var(--luxury-navy);
    }

    .product-image {
        width: 60px;
        height: 60px;
        object-fit: cover;
        border-radius: 12px;
        border: 2px solid #e2e8f0;
    }

    .status-badge {
        padding: 0.5rem 1rem;
        border-radius: 8px;
        font-size: 0.85rem;
        font-weight: 600;
    }

    .badge-success {
        background: rgba(34, 197, 94, 0.1);
        color: #16a34a;
        border: 1px solid rgba(34, 197, 94, 0.2);
    }

    .badge-warning {
        background: rgba(251, 191, 36, 0.1);
        color: #f59e0b;
        border: 1px solid rgba(251, 191, 36, 0.2);
    }

    .badge-danger {
        background: rgba(239, 68, 68, 0.1);
        color: #dc2626;
        border: 1px solid rgba(239, 68, 68, 0.2);
    }

    .badge-featured {
        background: linear-gradient(135deg, var(--luxury-gold), #ffd700);
        color: var(--luxury-navy);
        border: none;
    }

    .action-btn {
        width: 40px;
        height: 40px;
        border-radius: 10px;
        border: 2px solid #e2e8f0;
        background: white;
        color: var(--luxury-navy);
        transition: all 0.3s ease;
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }

    .action-btn:hover {
        border-color: var(--luxury-gold);
        background: rgba(212, 175, 55, 0.1);
        transform: translateY(-2px);
    }

    .action-btn.delete:hover {
        border-color: #dc2626;
        background: rgba(239, 68, 68, 0.1);
        color: #dc2626;
    }

    .table-luxury {
        width: 100%;
    }

    .table-luxury thead {
        background: linear-gradient(135deg, var(--luxury-navy) 0%, var(--luxury-charcoal) 100%);
        color: white;
    }

    .table-luxury thead th {
        padding: 1.25rem;
        font-weight: 600;
        border: none;
    }

    .table-luxury thead th:first-child {
        border-radius: 12px 0 0 0;
    }

    .table-luxury thead th:last-child {
        border-radius: 0 12px 0 0;
    }

    .table-luxury tbody tr {
        border-bottom: 1px solid #e2e8f0;
        transition: all 0.3s ease;
    }

    .table-luxury tbody tr:hover {
        background: rgba(212, 175, 55, 0.05);
    }

    .table-luxury tbody td {
        padding: 1.25rem;
        vertical-align: middle;
    }

    .loading-spinner {
        display: inline-block;
        width: 40px;
        height: 40px;
        border: 4px solid rgba(212, 175, 55, 0.2);
        border-top-color: var(--luxury-gold);
        border-radius: 50%;
        animation: spin 1s linear infinite;
    }

    @keyframes spin {
        to { transform: rotate(360deg); }
    }

    .modal-luxury .modal-content {
        border-radius: 20px;
        border: 1px solid rgba(15, 23, 42, 0.1);
    }

    .modal-luxury .modal-header {
        background: linear-gradient(135deg, var(--luxury-navy) 0%, var(--luxury-charcoal) 100%);
        color: white;
        border-radius: 20px 20px 0 0;
        border-bottom: 3px solid var(--luxury-gold);
    }

    .modal-luxury .modal-title {
        font-family: 'Playfair Display', serif;
        font-size: 1.5rem;
    }

    .modal-luxury .btn-close {
        filter: invert(1);
    }

    @media (max-width: 768px) {
        .filter-card {
            padding: 1.5rem;
        }
        
        .table-luxury {
            font-size: 0.875rem;
        }
        
        .product-image {
            width: 40px;
            height: 40px;
        }
    }
</style>

<!-- Hero Section -->
