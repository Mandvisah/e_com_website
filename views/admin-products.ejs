<!-- Main Content -->
<div class="container mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <!-- Search and Filter Section -->
    <div class="filter-card animate-fade-in-up">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            <div class="md:col-span-1">
                <label class="block text-white text-sm font-semibold mb-2">
                    <i class="fas fa-search me-2"></i>Search Products
                </label>
                <input type="text" class="luxury-input w-full" id="searchProducts" placeholder="Search by name, brand...">
            </div>
            <div>
                <label class="block text-white text-sm font-semibold mb-2">
                    <i class="fas fa-folder me-2"></i>Category
                </label>
                <select class="luxury-select w-full" id="categoryFilter">
                    <option value="">All Categories</option>
                </select>
            </div>
            <div>
                <label class="block text-white text-sm font-semibold mb-2">
                    <i class="fas fa-box me-2"></i>Stock Status
                </label>
                <select class="luxury-select w-full" id="stockFilter">
                    <option value="">All Stock Status</option>
                    <option value="instock">In Stock</option>
                    <option value="outofstock">Out of Stock</option>
                    <option value="lowstock">Low Stock (< 10)</option>
                </select>
            </div>
        </div>
    </div>

    <!-- Products Table Card -->
    <div class="luxury-card animate-fade-in-up" style="animation-delay: 0.2s;">
        <div class="overflow-x-auto">
            <table class="table-luxury" id="productsTable">
                <thead>
                    <tr>
                        <th>Image</th>
                        <th>Product Details</th>
                        <th>Category</th>
                        <th>Price</th>
                        <th>Stock</th>
                        <th>Rating</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody id="productsTableBody">
                    <!-- Products will be loaded here -->
                </tbody>
            </table>
        </div>
        
        <!-- Loading spinner -->
        <div id="loadingSpinner" class="text-center py-12">
            <div class="loading-spinner mx-auto mb-4"></div>
            <p class="text-slate-600 font-medium">Loading products...</p>
        </div>
        
        <!-- No products message -->
        <div id="noProductsMessage" class="text-center py-12" style="display: none;">
            <div class="mb-6">
                <i class="fas fa-box-open text-6xl text-slate-300"></i>
            </div>
            <h5 class="text-xl font-bold text-slate-700 mb-2">No products found</h5>
            <p class="text-slate-500 mb-6">Start by adding your first product to the inventory!</p>
            <a href="/admin/add-product" class="luxury-btn-primary">
                <i class="fas fa-plus me-2"></i>Add Product
            </a>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade modal-luxury" id="deleteProductModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="fas fa-exclamation-triangle me-2"></i>Delete Product</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" style="padding: 2rem;">
                <div class="text-center mb-4">
                    <i class="fas fa-trash-alt text-6xl text-red-500 mb-4"></i>
                </div>
                <p class="text-slate-700 text-center text-lg mb-3">Are you sure you want to delete this product?</p>
                <div class="bg-red-50 border-2 border-red-200 rounded-lg p-4">
                    <p class="text-red-600 font-semibold text-center mb-0">
                        <i class="fas fa-exclamation-circle me-2"></i>This action cannot be undone
                    </p>
                </div>
                <input type="hidden" id="deleteProductId">
            </div>
            <div class="modal-footer" style="border-top: 1px solid #e2e8f0; padding: 1.5rem;">
                <button type="button" class="px-6 py-3 bg-white text-slate-700 rounded-lg border-2 border-slate-300 font-semibold hover:bg-slate-50" data-bs-dismiss="modal">
                    <i class="fas fa-times me-2"></i>Cancel
                </button>
                <button type="button" class="px-6 py-3 bg-red-600 text-white rounded-lg font-semibold hover:bg-red-700 transition-all" onclick="confirmDeleteProduct()">
                    <i class="fas fa-trash me-2"></i>Delete Product
                </button>
            </div>
        </div>
    </div>
</div>

<script>
let allProducts = [];
let allCategories = [];

// Load data when page loads
document.addEventListener('DOMContentLoaded', function() {
    loadCategories();
    loadProducts();
    
    // Set up search and filter event listeners
    document.getElementById('searchProducts').addEventListener('input', filterProducts);
    document.getElementById('categoryFilter').addEventListener('change', filterProducts);
    document.getElementById('stockFilter').addEventListener('change', filterProducts);
});

// Load categories for filters and modals
async function loadCategories() {
    try {
        const response = await axios.get('/api/v1/categories');
        allCategories = response.data;
        
        // Populate category filters
        const categoryFilter = document.getElementById('categoryFilter');
        const editCategorySelect = document.getElementById('editProductCategory');
        
        categoryFilter.innerHTML = '<option value="">All Categories</option>';
        editCategorySelect.innerHTML = '<option value="">Select Category</option>';
        
        allCategories.forEach(category => {
            categoryFilter.innerHTML += `<option value="${category._id}">${category.name}</option>`;
            editCategorySelect.innerHTML += `<option value="${category._id}">${category.name}</option>`;
        });
    } catch (error) {
        console.error('Error loading categories:', error);
        showToast('Failed to load categories', 'error');
    }
}

// Load all products
async function loadProducts() {
    try {
        const response = await axios.get('/api/v1/products');
        allProducts = response.data;
        displayProducts(allProducts);
        
        document.getElementById('loadingSpinner').style.display = 'none';
    } catch (error) {
        console.error('Error loading products:', error);
        document.getElementById('loadingSpinner').style.display = 'none';
        showToast('Failed to load products', 'error');
    }
}

// Display products in table
function displayProducts(products) {
    const tbody = document.getElementById('productsTableBody');
    const noProductsMessage = document.getElementById('noProductsMessage');
    const table = document.getElementById('productsTable');
    
    if (products.length === 0) {
        table.style.display = 'none';
        noProductsMessage.style.display = 'block';
        return;
    }
    
    table.style.display = 'table';
    noProductsMessage.style.display = 'none';
    
    tbody.innerHTML = products.map(product => {
        const category = allCategories.find(cat => cat._id === product.category);
        const categoryName = category ? category.name : 'Unknown';
        const stockStatus = getStockStatus(product.countInStock);
        
        return `
            <tr>
                <td>
                    <img src="${product.image}" alt="${product.name}" 
                         class="product-image"
                         onerror="this.src='/public/images/no-image.png'">
                </td>
                <td>
                    <div>
                        <div class="font-semibold text-slate-900 mb-1">${product.name}</div>
                        ${product.brand ? `<div class="text-sm text-slate-500">${product.brand}</div>` : ''}
                    </div>
                </td>
                <td>
                    <span class="inline-flex items-center px-3 py-1 rounded-lg bg-slate-100 text-slate-700 text-sm font-medium">
                        <i class="fas fa-folder text-slate-500 me-2"></i>${categoryName}
                    </span>
                </td>
                <td>
                    <span class="font-bold text-slate-900 text-lg">$${product.price.toFixed(2)}</span>
                </td>
                <td>
                    <span class="status-badge ${stockStatus.class}">${product.countInStock}</span>
                </td>
                <td>
                    <div class="flex items-center gap-1">
                        ${generateStars(product.rating)}
                        <span class="text-sm text-slate-500 ml-2">(${product.numReviews || 0})</span>
                    </div>
                </td>
                <td>
                    ${product.isFeatured ? 
                        '<span class="status-badge badge-featured"><i class="fas fa-star me-1"></i>Featured</span>' : 
                        '<span class="status-badge" style="background:#e2e8f0;color:#64748b;border:1px solid #cbd5e1">Regular</span>'
                    }
                </td>
                <td>
                    <div class="flex gap-2">
                        <button type="button" class="action-btn" 
                                onclick="editProduct('${product._id}')" title="Edit Product">
                            <i class="fas fa-edit"></i>
                        </button>
                        <button type="button" class="action-btn delete" 
                                onclick="deleteProduct('${product._id}')" title="Delete Product">
                            <i class="fas fa-trash"></i>
                        </button>
                    </div>
                </td>
            </tr>
        `;
    }).join('');
}

// Filter products based on search and filters
function filterProducts() {
    const searchTerm = document.getElementById('searchProducts').value.toLowerCase();
    const categoryFilter = document.getElementById('categoryFilter').value;
    const stockFilter = document.getElementById('stockFilter').value;
    
    let filteredProducts = allProducts.filter(product => {
        // Search filter
        const matchesSearch = product.name.toLowerCase().includes(searchTerm) ||
                            (product.brand && product.brand.toLowerCase().includes(searchTerm)) ||
                            (product.description && product.description.toLowerCase().includes(searchTerm));
        
        // Category filter
        const matchesCategory = !categoryFilter || product.category === categoryFilter;
        
        // Stock filter
        let matchesStock = true;
        if (stockFilter === 'instock') {
            matchesStock = product.countInStock > 0;
        } else if (stockFilter === 'outofstock') {
            matchesStock = product.countInStock === 0;
        } else if (stockFilter === 'lowstock') {
            matchesStock = product.countInStock > 0 && product.countInStock < 10;
        }
        
        return matchesSearch && matchesCategory && matchesStock;
    });
    
    displayProducts(filteredProducts);
}

// Get stock status with appropriate styling
function getStockStatus(stock) {
    if (stock === 0) {
        return { class: 'badge-danger' };
    } else if (stock < 10) {
        return { class: 'badge-warning' };
    } else {
        return { class: 'badge-success' };
    }
}

// Generate star rating
function generateStars(rating) {
    const fullStars = Math.floor(rating);
    const hasHalfStar = rating % 1 !== 0;
    let stars = '';
    
    for (let i = 0; i < fullStars; i++) {
        stars += '<i class="fas fa-star" style="color:#d4af37;"></i>';
    }
    
    if (hasHalfStar) {
        stars += '<i class="fas fa-star-half-alt" style="color:#d4af37;"></i>';
    }
    
    const emptyStars = 5 - Math.ceil(rating);
    for (let i = 0; i < emptyStars; i++) {
        stars += '<i class="far fa-star" style="color:#d4af37;"></i>';
    }
    
    return stars;
}

// Edit product - Redirect to separate page
function editProduct(productId) {
    window.location.href = `/admin/edit-product?id=${productId}`;
}

// Delete product
function deleteProduct(productId) {
    document.getElementById('deleteProductId').value = productId;
    new bootstrap.Modal(document.getElementById('deleteProductModal')).show();
}

// Confirm delete product
async function confirmDeleteProduct() {
    const productId = document.getElementById('deleteProductId').value;
    const token = localStorage.getItem('userToken');
    
    if (!token) {
        showToast('Please login to delete products', 'error');
        return;
    }
    
    try {
        await axios.delete(`/api/v1/products/${productId}`, {
            headers: {
                'Authorization': `Bearer ${token}`
            }
        });
        
        showToast('Product deleted successfully!', 'success');
        bootstrap.Modal.getInstance(document.getElementById('deleteProductModal')).hide();
        loadProducts(); // Reload products
        
    } catch (error) {
        console.error('Error deleting product:', error);
        const message = error.response?.data?.message || 'Failed to delete product';
        showToast(message, 'error');
    }
}

// Toast notification function
function showToast(message, type = 'info') {
    // Create toast element
    const toastContainer = document.getElementById('toastContainer') || createToastContainer();
    
    const toastId = 'toast-' + Date.now();
    const toastHtml = `
        <div id="${toastId}" class="toast align-items-center text-white bg-${type === 'error' ? 'danger' : type === 'success' ? 'success' : 'primary'}" role="alert">
            <div class="d-flex">
                <div class="toast-body">
                    <i class="fas fa-${type === 'error' ? 'exclamation-circle' : type === 'success' ? 'check-circle' : 'info-circle'} me-2"></i>
                    ${message}
                </div>
                <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
            </div>
        </div>
    `;
    
    toastContainer.innerHTML = toastHtml + toastContainer.innerHTML;
    
    const toastElement = document.getElementById(toastId);
    const toast = new bootstrap.Toast(toastElement);
    toast.show();
    
    // Remove toast element after it's hidden
    toastElement.addEventListener('hidden.bs.toast', () => {
        toastElement.remove();
    });
}

function createToastContainer() {
    const container = document.createElement('div');
    container.id = 'toastContainer';
    container.className = 'toast-container position-fixed top-0 end-0 p-3';
    container.style.zIndex = '9999';
    document.body.appendChild(container);
    return container;
}
</script>
