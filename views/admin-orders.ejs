<style>
    @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600;700;800&family=Inter:wght@300;400;500;600;700&display=swap');
    
    :root {
        --luxury-navy: #0f172a;
        --luxury-charcoal: #1e293b;
        --luxury-gold: #d4af37;
    }
    
    body { font-family: 'Inter', sans-serif; background-color: #f8fafc; }
    .luxury-heading { font-family: 'Playfair Display', serif; }
    
    @keyframes fadeInUp {
        from { opacity: 0; transform: translateY(30px); }
        to { opacity: 1; transform: translateY(0); }
    }
    
    .animate-fade-in-up { animation: fadeInUp 0.8s ease-out forwards; }
    
    .stats-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 1.5rem;
        margin-bottom: 2rem;
    }
    
    .stat-card {
        background: white;
        border-radius: 16px;
        padding: 1.5rem;
        border: 2px solid #e2e8f0;
        transition: all 0.3s ease;
        position: relative;
        overflow: hidden;
    }
    
    .stat-card::before {
        content: '';
        position: absolute;
        top: 0;
        right: 0;
        width: 100px;
        height: 100px;
        background: linear-gradient(135deg, rgba(212, 175, 55, 0.1), transparent);
        border-radius: 0 16px 0 100%;
    }
    
    .stat-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 10px 30px rgba(15, 23, 42, 0.1);
        border-color: var(--luxury-gold);
    }
    
    .stat-icon {
        width: 50px;
        height: 50px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
        margin-bottom: 1rem;
    }
    
    .stat-value {
        font-size: 2rem;
        font-weight: 700;
        color: var(--luxury-navy);
        font-family: 'Playfair Display', serif;
    }
    
    .stat-label {
        color: #64748b;
        font-size: 0.9rem;
        font-weight: 500;
    }
    
    .luxury-card {
        background: white;
        border-radius: 20px;
        box-shadow: 0 10px 30px rgba(15, 23, 42, 0.1);
        border: 1px solid rgba(15, 23, 42, 0.08);
        overflow: hidden;
    }
    
    .card-header-luxury {
        background: linear-gradient(135deg, var(--luxury-navy), var(--luxury-charcoal));
        border-bottom: 3px solid var(--luxury-gold);
        padding: 2rem;
    }
    
    .card-header-luxury h2 {
        color: white;
        margin: 0;
        font-size: 1.5rem;
        font-weight: 700;
    }
    
    .luxury-table {
        width: 100%;
        border-collapse: separate;
        border-spacing: 0;
    }
    
    .luxury-table thead {
        background: linear-gradient(135deg, var(--luxury-navy), var(--luxury-charcoal));
    }
    
    .luxury-table thead th {
        padding: 1rem;
        text-align: left;
        color: white;
        font-weight: 600;
        font-size: 0.85rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        border-bottom: 2px solid var(--luxury-gold);
    }
    
    .luxury-table tbody tr {
        border-bottom: 1px solid #e2e8f0;
        transition: all 0.3s ease;
    }
    
    .luxury-table tbody tr:hover {
        background-color: #f8fafc;
        transform: scale(1.01);
    }
    
    .luxury-table tbody td {
        padding: 1rem;
        color: #334155;
    }
    
    .luxury-btn {
        padding: 0.6rem 1.5rem;
        border-radius: 10px;
        font-weight: 600;
        transition: all 0.3s ease;
        border: 2px solid transparent;
    }
    
    .luxury-btn-primary {
        background: linear-gradient(135deg, var(--luxury-navy), var(--luxury-charcoal));
        color: white;
        border-color: var(--luxury-gold);
    }
    
    .luxury-btn-primary:hover {
        background: linear-gradient(135deg, var(--luxury-charcoal), var(--luxury-navy));
        box-shadow: 0 5px 15px rgba(212, 175, 55, 0.3);
        transform: translateY(-2px);
    }
    
    .luxury-btn-outline {
        background: white;
        color: var(--luxury-navy);
        border-color: var(--luxury-navy);
    }
    
    .luxury-btn-outline:hover {
        background: var(--luxury-navy);
        color: white;
    }
    
    .luxury-input {
        padding: 0.8rem 1rem;
        border: 2px solid #e2e8f0;
        border-radius: 10px;
        font-size: 0.95rem;
        transition: all 0.3s ease;
        width: 100%;
    }
    
    .luxury-input:focus {
        outline: none;
        border-color: var(--luxury-gold);
        box-shadow: 0 0 0 3px rgba(212, 175, 55, 0.1);
    }
    
    .status-badge {
        padding: 0.4rem 1rem;
        border-radius: 20px;
        font-size: 0.75rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }
    
    .status-pending {
        background: linear-gradient(135deg, #fbbf24, #f59e0b);
        color: white;
    }
    
    .status-processing {
        background: linear-gradient(135deg, #60a5fa, #3b82f6);
        color: white;
    }
    
    .status-shipped {
        background: linear-gradient(135deg, #a78bfa, #8b5cf6);
        color: white;
    }
    
    .status-delivered {
        background: linear-gradient(135deg, #34d399, #10b981);
        color: white;
    }
    
    .status-cancelled {
        background: linear-gradient(135deg, #f87171, #ef4444);
        color: white;
    }
    
    .payment-badge {
        padding: 0.3rem 0.8rem;
        border-radius: 15px;
        font-size: 0.75rem;
        font-weight: 600;
    }
    
    .payment-cod {
        background: linear-gradient(135deg, #fcd34d, #fbbf24);
        color: #78350f;
    }
    
    .payment-card {
        background: linear-gradient(135deg, #93c5fd, #60a5fa);
        color: #1e3a8a;
    }
    
    .filter-card {
        background: white;
        border-radius: 16px;
        padding: 1.5rem;
        margin-bottom: 2rem;
        box-shadow: 0 4px 6px rgba(15, 23, 42, 0.05);
        border: 1px solid #e2e8f0;
    }
</style>

<div class="container-fluid px-4 py-6">
    <!-- Page Header -->
    <div class="flex justify-between items-center mb-8 animate-fade-in-up">
        <div>
            <h1 class="luxury-heading text-4xl font-bold text-slate-900 mb-2">
                <i class="fas fa-clipboard-list text-yellow-600 mr-3"></i>Manage Orders
            </h1>
            <p class="text-slate-600">Track and manage all customer orders</p>
        </div>
        <div class="flex gap-3">
            <button class="luxury-btn luxury-btn-outline" onclick="refreshOrders()">
                <i class="fas fa-sync-alt mr-2"></i>Refresh
            </button>
            <button class="luxury-btn luxury-btn-primary" onclick="exportOrders()">
                <i class="fas fa-download mr-2"></i>Export
            </button>
        </div>
    </div>

    <!-- Statistics Cards -->
    <div class="stats-grid animate-fade-in-up">
        <div class="stat-card">
            <div class="stat-icon" style="background: linear-gradient(135deg, #dbeafe, #bfdbfe);">
                <i class="fas fa-shopping-cart" style="color: #1e40af;"></i>
            </div>
            <div class="stat-value" id="total-orders">0</div>
            <div class="stat-label">Total Orders</div>
        </div>
        
        <div class="stat-card">
            <div class="stat-icon" style="background: linear-gradient(135deg, #d1fae5, #a7f3d0);">
                <i class="fas fa-dollar-sign" style="color: #047857;"></i>
            </div>
            <div class="stat-value" id="total-revenue">$0.00</div>
            <div class="stat-label">Total Revenue</div>
        </div>
        
        <div class="stat-card">
            <div class="stat-icon" style="background: linear-gradient(135deg, #fef3c7, #fde68a);">
                <i class="fas fa-clock" style="color: #b45309;"></i>
            </div>
            <div class="stat-value" id="pending-orders">0</div>
            <div class="stat-label">Pending Orders</div>
        </div>
        
        <div class="stat-card">
            <div class="stat-icon" style="background: linear-gradient(135deg, #e9d5ff, #d8b4fe);">
                <i class="fas fa-cogs" style="color: #6b21a8;"></i>
            </div>
            <div class="stat-value" id="processing-orders">0</div>
            <div class="stat-label">Processing Orders</div>
        </div>
    </div>

    <!-- Filters Section -->
    <div class="filter-card animate-fade-in-up">
        <h3 class="luxury-heading text-xl font-bold text-slate-900 mb-4">
            <i class="fas fa-filter text-yellow-600 mr-2"></i>Filters & Search
        </h3>
        <div class="grid grid-cols-1 md:grid-cols-5 gap-4">
            <div>
                <label class="block text-sm font-semibold text-slate-700 mb-2">Search Orders</label>
                <input type="text" class="luxury-input" id="search-input" placeholder="Order ID, email...">
            </div>
            <div>
                <label class="block text-sm font-semibold text-slate-700 mb-2">Status</label>
                <select class="luxury-input" id="status-filter">
                    <option value="">All Status</option>
                    <option value="pending">Pending</option>
                    <option value="processing">Processing</option>
                    <option value="shipped">Shipped</option>
                    <option value="delivered">Delivered</option>
                    <option value="cancelled">Cancelled</option>
                </select>
            </div>
            <div>
                <label class="block text-sm font-semibold text-slate-700 mb-2">Date From</label>
                <input type="date" class="luxury-input" id="date-from">
            </div>
            <div>
                <label class="block text-sm font-semibold text-slate-700 mb-2">Date To</label>
                <input type="date" class="luxury-input" id="date-to">
            </div>
            <div>
                <label class="block text-sm font-semibold text-slate-700 mb-2">&nbsp;</label>
                <button class="luxury-btn luxury-btn-primary w-full" onclick="applyFilters()">
                    <i class="fas fa-search mr-2"></i>Search
                </button>
            </div>
        </div>
    </div>

    <!-- Orders Table -->
    <div class="luxury-card animate-fade-in-up">
        <div class="card-header-luxury">
            <h2 class="luxury-heading">
                <i class="fas fa-list mr-3"></i>Orders List
            </h2>
        </div>
        <div class="p-6">
            <div class="overflow-x-auto">
                <table class="luxury-table">
                    <thead>
                        <tr>
                            <th>Order ID</th>
                            <th>Customer</th>
                            <th>Date</th>
                            <th>Items</th>
                            <th>Total</th>
                            <th>Status</th>
                            <th>Payment</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody id="orders-tbody">
                        <tr>
                            <td colspan="8" class="text-center py-8">
                                <div class="inline-block animate-spin rounded-full h-12 w-12 border-4 border-slate-300 border-t-yellow-600"></div>
                                <p class="mt-3 text-slate-600">Loading orders...</p>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <!-- Pagination -->
            <nav class="mt-6 flex justify-center">
                <ul class="flex gap-2" id="pagination">
                    <!-- Pagination will be generated by JavaScript -->
                </ul>
            </nav>
        </div>
    </div>
</div>

<!-- Order Details Modal -->
<div class="modal fade" id="orderDetailsModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content" style="border-radius: 20px; border: 2px solid var(--luxury-gold); overflow: hidden;">
            <div class="modal-header" style="background: linear-gradient(135deg, var(--luxury-navy), var(--luxury-charcoal)); border-bottom: 3px solid var(--luxury-gold); padding: 1.5rem;">
                <h5 class="luxury-heading text-white text-2xl font-bold mb-0">
                    <i class="fas fa-file-invoice mr-2"></i>Order Details
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="order-details-content" style="padding: 2rem;">
                <!-- Order details will be loaded here -->
            </div>
            <div class="modal-footer" style="padding: 1.5rem; background: #f8fafc; border-top: 1px solid #e2e8f0;">
                <button type="button" class="luxury-btn luxury-btn-outline" data-bs-dismiss="modal">
                    <i class="fas fa-times mr-2"></i>Close
                </button>
                <button type="button" class="luxury-btn luxury-btn-primary" onclick="printOrder()">
                    <i class="fas fa-print mr-2"></i>Print
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Update Status Modal -->
<div class="modal fade" id="updateStatusModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="border-radius: 20px; border: 2px solid var(--luxury-gold); overflow: hidden;">
            <div class="modal-header" style="background: linear-gradient(135deg, var(--luxury-navy), var(--luxury-charcoal)); border-bottom: 3px solid var(--luxury-gold); padding: 1.5rem;">
                <h5 class="luxury-heading text-white text-xl font-bold mb-0">
                    <i class="fas fa-edit mr-2"></i>Update Order Status
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" style="padding: 2rem;">
                <form id="update-status-form">
                    <input type="hidden" id="update-order-id">
                    <div class="mb-4">
                        <label class="block text-sm font-semibold text-slate-700 mb-2">
                            <i class="fas fa-info-circle text-yellow-600 mr-2"></i>New Status
                        </label>
                        <select class="luxury-input" id="new-status" required>
                            <option value="">Select Status</option>
                            <option value="pending">Pending</option>
                            <option value="processing">Processing</option>
                            <option value="shipped">Shipped</option>
                            <option value="delivered">Delivered</option>
                            <option value="cancelled">Cancelled</option>
                        </select>
                    </div>
                    <div class="mb-4">
                        <label class="block text-sm font-semibold text-slate-700 mb-2">
                            <i class="fas fa-sticky-note text-yellow-600 mr-2"></i>Notes (optional)
                        </label>
                        <textarea class="luxury-input" id="status-notes" rows="3" placeholder="Add any notes about this status change..."></textarea>
                    </div>
                </form>
            </div>
            <div class="modal-footer" style="padding: 1.5rem; background: #f8fafc; border-top: 1px solid #e2e8f0;">
                <button type="button" class="luxury-btn luxury-btn-outline" data-bs-dismiss="modal">
                    <i class="fas fa-times mr-2"></i>Cancel
                </button>
                <button type="button" class="luxury-btn luxury-btn-primary" onclick="saveStatusUpdate()">
                    <i class="fas fa-save mr-2"></i>Update Status
                </button>
            </div>
        </div>
    </div>
</div>

<script>
let currentPage = 1;
let totalPages = 1;
let currentOrders = [];
let currentOrderId = null;

document.addEventListener('DOMContentLoaded', function() {
    loadOrders();
    loadOrderStats();
    
    // Auto-refresh every 30 seconds
    setInterval(loadOrders, 30000);
});

async function loadOrders(page = 1) {
    try {
        const params = new URLSearchParams({
            page: page,
            limit: 10
        });
        
        // Add filters if any
        const status = document.getElementById('status-filter')?.value;
        const search = document.getElementById('search-input')?.value;
        const dateFrom = document.getElementById('date-from')?.value;
        const dateTo = document.getElementById('date-to')?.value;
        
        if (status) params.append('status', status);
        if (search) params.append('search', search);
        if (dateFrom) params.append('dateFrom', dateFrom);
        if (dateTo) params.append('dateTo', dateTo);
        
        const response = await axios.get(`/api/v1/orders?${params}`, {
            headers: {
                'Authorization': `Bearer ${localStorage.getItem('userToken')}`
            }
        });
        
        currentOrders = response.data.orders || response.data;
        currentPage = response.data.currentPage || 1;
        totalPages = response.data.totalPages || 1;
        
        renderOrdersTable();
        renderPagination();
        
    } catch (error) {
        console.error('Error loading orders:', error);
        document.getElementById('orders-tbody').innerHTML = `
            <tr>
                <td colspan="8" class="text-center py-4 text-danger">
                    <i class="fas fa-exclamation-triangle"></i>
                    Error loading orders. Please try again.
                </td>
            </tr>
        `;
    }
}

async function loadOrderStats() {
    try {
        const response = await axios.get('/api/v1/orders/stats', {
            headers: {
                'Authorization': `Bearer ${localStorage.getItem('userToken')}`
            }
        });
        
        const stats = response.data;
        document.getElementById('total-orders').textContent = stats.totalOrders || 0;
        document.getElementById('total-revenue').textContent = `$${(stats.totalRevenue || 0).toFixed(2)}`;
        document.getElementById('pending-orders').textContent = stats.pendingOrders || 0;
        document.getElementById('processing-orders').textContent = stats.processingOrders || 0;
        
    } catch (error) {
        console.error('Error loading order stats:', error);
    }
}

function renderOrdersTable() {
    const tbody = document.getElementById('orders-tbody');
    
    if (currentOrders.length === 0) {
        tbody.innerHTML = `
            <tr>
                <td colspan="8" class="text-center py-8">
                    <div style="display: flex; flex-direction: column; align-items: center;">
                        <i class="fas fa-inbox" style="font-size: 3rem; color: #cbd5e1; margin-bottom: 1rem;"></i>
                        <p style="color: #64748b; font-size: 1rem;">No orders found</p>
                    </div>
                </td>
            </tr>
        `;
        return;
    }
    
    tbody.innerHTML = currentOrders.map(order => `
        <tr>
            <td>
                <span style="font-weight: 700; color: var(--luxury-navy); font-family: 'Playfair Display', serif;">
                    #${order._id.slice(-8).toUpperCase()}
                </span>
            </td>
            <td>
                <div>
                    <div style="font-weight: 600; color: #1e293b;">${order.user?.name || 'Unknown User'}</div>
                    <div style="font-size: 0.85rem; color: #64748b;">${order.shippingAddress?.email || order.user?.email || ''}</div>
                </div>
            </td>
            <td>
                <div style="font-weight: 500; color: #334155;">${new Date(order.createdAt).toLocaleDateString()}</div>
                <div style="font-size: 0.85rem; color: #64748b;">${new Date(order.createdAt).toLocaleTimeString()}</div>
            </td>
            <td>
                <span style="background: linear-gradient(135deg, #e0e7ff, #c7d2fe); color: #3730a3; padding: 0.3rem 0.8rem; border-radius: 15px; font-size: 0.75rem; font-weight: 600;">
                    ${order.orderItems?.length || 0} items
                </span>
            </td>
            <td>
                <span style="font-weight: 700; color: #059669; font-size: 1.1rem; font-family: 'Playfair Display', serif;">
                    $${(order.totalPrice || 0).toFixed(2)}
                </span>
            </td>
            <td>
                <span class="status-badge status-${order.status || 'pending'}">${order.status || 'pending'}</span>
            </td>
            <td>
                <span class="payment-badge payment-${order.paymentMethod === 'cod' ? 'cod' : 'card'}">
                    ${order.paymentMethod === 'cod' ? 'COD' : 'Card'}
                </span>
            </td>
            <td>
                <div style="display: flex; gap: 0.5rem;">
                    <button class="luxury-btn" style="padding: 0.5rem 0.8rem; font-size: 0.85rem; background: linear-gradient(135deg, #dbeafe, #bfdbfe); color: #1e40af; border: 1px solid #3b82f6;" onclick="viewOrderDetails('${order._id}')" title="View Details">
                        <i class="fas fa-eye"></i>
                    </button>
                    <button class="luxury-btn" style="padding: 0.5rem 0.8rem; font-size: 0.85rem; background: linear-gradient(135deg, #fef3c7, #fde68a); color: #92400e; border: 1px solid #f59e0b;" onclick="updateOrderStatus('${order._id}')" title="Update Status">
                        <i class="fas fa-edit"></i>
                    </button>
                    <button class="luxury-btn" style="padding: 0.5rem 0.8rem; font-size: 0.85rem; background: linear-gradient(135deg, #fecaca, #fca5a5); color: #991b1b; border: 1px solid #ef4444;" onclick="deleteOrder('${order._id}')" title="Delete">
                        <i class="fas fa-trash"></i>
                    </button>
                </div>
            </td>
        </tr>
    `).join('');
}

function renderPagination() {
    const pagination = document.getElementById('pagination');
    
    if (totalPages <= 1) {
        pagination.innerHTML = '';
        return;
    }
    
    let paginationHtml = '';
    
    // Previous button
    paginationHtml += `
        <li>
            <button 
                class="luxury-btn ${currentPage === 1 ? 'opacity-50 cursor-not-allowed' : ''}" 
                style="padding: 0.5rem 1rem; font-size: 0.9rem; ${currentPage === 1 ? 'pointer-events: none;' : ''}"
                onclick="loadOrders(${currentPage - 1})" 
                ${currentPage === 1 ? 'disabled' : ''}>
                <i class="fas fa-chevron-left mr-2"></i>Previous
            </button>
        </li>
    `;
    
    // Page numbers
    for (let i = Math.max(1, currentPage - 2); i <= Math.min(totalPages, currentPage + 2); i++) {
        paginationHtml += `
            <li>
                <button 
                    class="luxury-btn ${i === currentPage ? 'luxury-btn-primary' : 'luxury-btn-outline'}" 
                    style="padding: 0.5rem 1rem; font-size: 0.9rem; min-width: 45px;"
                    onclick="loadOrders(${i})">
                    ${i}
                </button>
            </li>
        `;
    }
    
    // Next button
    paginationHtml += `
        <li>
            <button 
                class="luxury-btn ${currentPage === totalPages ? 'opacity-50 cursor-not-allowed' : ''}" 
                style="padding: 0.5rem 1rem; font-size: 0.9rem; ${currentPage === totalPages ? 'pointer-events: none;' : ''}"
                onclick="loadOrders(${currentPage + 1})" 
                ${currentPage === totalPages ? 'disabled' : ''}>
                Next<i class="fas fa-chevron-right ml-2"></i>
            </button>
        </li>
    `;
    
    pagination.innerHTML = paginationHtml;
}

async function viewOrderDetails(orderId) {
    try {
        const response = await axios.get(`/api/v1/orders/${orderId}`, {
            headers: {
                'Authorization': `Bearer ${localStorage.getItem('userToken')}`
            }
        });
        
        const order = response.data;
        const modal = new bootstrap.Modal(document.getElementById('orderDetailsModal'));
        
        document.getElementById('order-details-content').innerHTML = `
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                    <h6 class="luxury-heading text-lg font-bold text-slate-900 mb-4">
                        <i class="fas fa-info-circle text-yellow-600 mr-2"></i>Order Information
                    </h6>
                    <div class="space-y-2">
                        <p class="text-sm"><span style="font-weight: 600; color: #475569;">Order ID:</span> <span style="font-family: 'Playfair Display', serif; color: var(--luxury-navy); font-weight: 700;">#${order._id.slice(-8).toUpperCase()}</span></p>
                        <p class="text-sm"><span style="font-weight: 600; color: #475569;">Date:</span> ${new Date(order.createdAt).toLocaleString()}</p>
                        <p class="text-sm"><span style="font-weight: 600; color: #475569;">Status:</span> <span class="status-badge status-${order.status}">${order.status}</span></p>
                        <p class="text-sm"><span style="font-weight: 600; color: #475569;">Payment Method:</span> ${order.paymentMethod === 'cod' ? 'Cash on Delivery' : 'Credit Card'}</p>
                        <p class="text-sm"><span style="font-weight: 600; color: #475569;">Total:</span> <span style="font-family: 'Playfair Display', serif; font-size: 1.5rem; color: #059669; font-weight: 700;">$${order.totalPrice.toFixed(2)}</span></p>
                    </div>
                </div>
                <div>
                    <h6 class="luxury-heading text-lg font-bold text-slate-900 mb-4">
                        <i class="fas fa-shipping-fast text-yellow-600 mr-2"></i>Shipping Address
                    </h6>
                    <div class="space-y-2">
                        <p class="text-sm"><span style="font-weight: 600; color: #475569;">Name:</span> ${order.shippingAddress?.firstName} ${order.shippingAddress?.lastName}</p>
                        <p class="text-sm"><span style="font-weight: 600; color: #475569;">Email:</span> ${order.shippingAddress?.email}</p>
                        <p class="text-sm"><span style="font-weight: 600; color: #475569;">Phone:</span> ${order.shippingAddress?.phone}</p>
                        <p class="text-sm"><span style="font-weight: 600; color: #475569;">Address:</span> ${order.shippingAddress?.address}</p>
                        <p class="text-sm"><span style="font-weight: 600; color: #475569;">City:</span> ${order.shippingAddress?.city}, ${order.shippingAddress?.state} ${order.shippingAddress?.zipCode}</p>
                    </div>
                </div>
            </div>
            <hr style="margin: 1.5rem 0; border-color: #e2e8f0;">
            <h6 class="luxury-heading text-lg font-bold text-slate-900 mb-4">
                <i class="fas fa-shopping-bag text-yellow-600 mr-2"></i>Order Items
            </h6>
            <div style="overflow-x: auto;">
                <table class="luxury-table" style="width: 100%;">
                    <thead>
                        <tr>
                            <th>Product</th>
                            <th>Quantity</th>
                            <th>Price</th>
                            <th>Total</th>
                        </tr>
                    </thead>
                    <tbody>
                        ${order.orderItems?.map(item => `
                            <tr>
                                <td style="font-weight: 600;">${item.name || item.product?.name || 'Unknown Product'}</td>
                                <td><span style="background: linear-gradient(135deg, #e0e7ff, #c7d2fe); color: #3730a3; padding: 0.2rem 0.6rem; border-radius: 12px; font-size: 0.8rem; font-weight: 600;">${item.quantity}</span></td>
                                <td style="color: #059669; font-weight: 600;">$${(item.price || 0).toFixed(2)}</td>
                                <td style="color: #059669; font-weight: 700; font-size: 1.1rem;">$${((item.price || 0) * item.quantity).toFixed(2)}</td>
                            </tr>
                        `).join('') || '<tr><td colspan="4" style="text-align: center; color: #64748b;">No items found</td></tr>'}
                    </tbody>
                </table>
            </div>
        `;
        
        modal.show();
        
    } catch (error) {
        console.error('Error loading order details:', error);
        showToast('Error loading order details', 'error');
    }
}

function updateOrderStatus(orderId) {
    currentOrderId = orderId;
    const modal = new bootstrap.Modal(document.getElementById('updateStatusModal'));
    modal.show();
}

async function saveStatusUpdate() {
    const orderId = currentOrderId;
    const newStatus = document.getElementById('new-status').value;
    const notes = document.getElementById('status-notes').value;
    
    if (!newStatus) {
        showToast('Please select a status', 'error');
        return;
    }
    
    try {
        showToast('Updating order status...', 'info');
        
        await axios.put(`/api/v1/orders/${orderId}`, {
            status: newStatus,
            notes: notes
        }, {
            headers: {
                'Authorization': `Bearer ${localStorage.getItem('userToken')}`,
                'Content-Type': 'application/json'
            }
        });
        
        bootstrap.Modal.getInstance(document.getElementById('updateStatusModal')).hide();
        
        showToast('Order status updated successfully!', 'success');
        
        setTimeout(() => {
            loadOrders(currentPage);
            loadOrderStats();
        }, 500);
        
    } catch (error) {
        console.error('Error updating order status:', error);
        const message = error.response?.data?.message || error.response?.data?.error || 'Failed to update order status';
        showToast(message, 'error');
        
        if (error.response?.status === 401) {
            showToast('Please login again', 'error');
            localStorage.removeItem('userToken');
            setTimeout(() => window.location.href = '/login', 2000);
        }
    }
}

async function deleteOrder(orderId) {
    if (!confirm('Are you sure you want to delete this order? This action cannot be undone.')) {
        return;
    }
    
    try {
        showToast('Deleting order...', 'info');
        
        await axios.delete(`/api/v1/orders/${orderId}`, {
            headers: {
                'Authorization': `Bearer ${localStorage.getItem('userToken')}`
            }
        });
        
        showToast('Order deleted successfully!', 'success');
        
        setTimeout(() => {
            loadOrders(currentPage);
            loadOrderStats();
        }, 500);
        
    } catch (error) {
        console.error('Error deleting order:', error);
        const message = error.response?.data?.message || error.response?.data?.error || 'Failed to delete order';
        showToast(message, 'error');
        
        if (error.response?.status === 401) {
            showToast('Please login again', 'error');
            localStorage.removeItem('userToken');
            setTimeout(() => window.location.href = '/login', 2000);
        }
    }
}

